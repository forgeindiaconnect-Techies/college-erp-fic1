export const generateDefaultRounds = (count) => {
  const roundPresets = [
    { name: 'Round 1: Online Aptitude & Assessment', type: 'Aptitude' },
    { name: 'Round 2: Technical Coding & Problem Solving', type: 'Technical' },
    { name: 'Round 3: Advanced Domain & System Design', type: 'Technical' },
    { name: 'Round 4: Group Discussion / Case Study', type: 'GD' },
    { name: 'Round 5: HR & Leadership Fitment', type: 'HR' }
  ];
  const rounds = [];
  const numRounds = Math.max(1, Math.min(Number(count) || 3, 6));
  for (let i = 1; i <= numRounds; i++) {
    const preset = roundPresets[i - 1] || { name: `Round ${i}: Evaluation Round`, type: 'Technical' };
    rounds.push({
      roundNumber: i,
      name: preset.name,
      type: preset.type
    });
  }
  return rounds;
};

const PlacementManagement = ({ defaultTab = 'Dashboard' }) => {
  const location = useLocation();
  const navigate = useNavigate();

  const getTabFromLocation = () => {
    const path = (location.pathname || '').toLowerCase();
    if (path.includes('/companies')) return 'Companies';
    if (path.includes('/jobs')) return 'Job Openings';
    if (path.includes('/eligibility')) return 'Eligibility Tracker';
    if (path.includes('/applications')) return 'Applications';
    if (path.includes('/training')) return 'Training Programs';
    if (path.includes('/interviews')) return 'Interviews';
    if (path.includes('/selections') || path.includes('/offers')) return 'Selected Students';
    if (path.includes('/reports') || path.includes('/analytics')) return 'Reports';
    return defaultTab || 'Dashboard';
  };

  const [activeTab, setActiveTab] = useState(getTabFromLocation);

  useEffect(() => {
    setActiveTab(getTabFromLocation());
  }, [location.pathname, defaultTab]);

  const handleTabClick = (tabName) => {
    setActiveTab(tabName);
    const pathToTab = {
      'Dashboard': '/placement/dashboard',
      'Companies': '/placement/companies',
      'Job Openings': '/placement/jobs',
      'Eligibility Tracker': '/placement/eligibility',
      'Applications': '/placement/applications',
      'Training Programs': '/placement/training',
      'Interviews': '/placement/interviews',
      'Selected Students': '/placement/selections',
      'Reports': '/placement/reports'
    };
    if (location.pathname.startsWith('/placement') && pathToTab[tabName]) {
      navigate(pathToTab[tabName]);
    }
  };

  const [search, setSearch] = useState('');
  const [companies, setCompanies] = useState([]);
  const [jobs, setJobs] = useState([]);
  const [applications, setApplications] = useState([]);
  const [interviews, setInterviews] = useState([]);
  const [selections, setSelections] = useState([]);
  const [allStudents, setAllStudents] = useState([]);
  const [loading, setLoading] = useState(true);
  const [toastMsg, setToastMsg] = useState('');

  const showToast = (msg) => {
    setToastMsg(msg);
    setTimeout(() => setToastMsg(''), 3500);
  };

  // Active Job and Round state for Interviews / Evaluation workflow
  const [selectedInterviewJob, setSelectedInterviewJob] = useState('');
  const [selectedRoundIndex, setSelectedRoundIndex] = useState(0);
  const [trainingRoundFilter, setTrainingRoundFilter] = useState('ALL');

  // Modals state
  const [showCompanyModal, setShowCompanyModal] = useState(false);
  const [companyForm, setCompanyForm] = useState({ name: '', sector: 'IT & Software', location: 'Pan India', website: '', hrName: '', hrEmail: '', hrContact: '' });

  const getDefaultDeadline = () => new Date(Date.now() + 30 * 24 * 60 * 60 * 1000).toISOString().split('T')[0];
  const getDefaultDriveDate = () => new Date(Date.now() + 14 * 24 * 60 * 60 * 1000).toISOString().split('T')[0];

  const [showJobModal, setShowJobModal] = useState(false);
  const [jobForm, setJobForm] = useState({ 
    company: '', 
    role: '', 
    ctc: '4.5 LPA', 
    eligibility: 'CGPA >= 6.0 & Zero Arrears', 
    minCgpa: 6.0, 
    maxArrears: 0, 
    eligibleDepartments: ['ALL'], 
    driveDate: getDefaultDriveDate(), 
    deadline: getDefaultDeadline(),
    totalRounds: 3,
    rounds: generateDefaultRounds(3)
  });

  const [showInterviewModal, setShowInterviewModal] = useState(false);
  const [interviewForm, setInterviewForm] = useState({ company: '', role: '', round: 'Technical Round 1', date: getDefaultDriveDate(), time: '10:00 AM', mode: 'Online', venue: 'Campus Auditorium / Zoom', panel: 'Recruitment Panel', candidates: 10 });

  const [showSelectionModal, setShowSelectionModal] = useState(false);
  const [selectionForm, setSelectionForm] = useState({ student: '', regNo: '', company: '', role: '', ctc: '4.5 LPA', date: new Date().toISOString().split('T')[0] });
  
  const [reportPreview, setReportPreview] = useState(null);

  // Training Programs State (Real-time live synced)
  const [trainingPrograms, setTrainingPrograms] = useState(() => {
    try {
      const tenantId = sessionStorage.getItem('tenantId') || 'mock_college_id';
      const saved = localStorage.getItem(`erp_placement_training_programs_${tenantId}`) || localStorage.getItem('erp_placement_training_programs');
      if (saved) {
        const parsed = JSON.parse(saved);
        if (Array.isArray(parsed)) {
          return parsed.filter(p => !['TP-101', 'TP-102', 'TP-103', 'TP-104'].includes(p.id));
        }
      }
    } catch (e) {
      console.error(e);
    }
    return [];
  });

  const [studentTrainingStatus, setStudentTrainingStatus] = useState(() => {
    try {
      const tenantId = sessionStorage.getItem('tenantId') || 'mock_college_id';
      const saved = localStorage.getItem(`erp_placement_training_attendance_${tenantId}`) || localStorage.getItem('erp_placement_training_attendance');
      return saved ? JSON.parse(saved) : {};
    } catch {
      return {};
    }
  });

  const [showTrainingModal, setShowTrainingModal] = useState(false);
  const [trainingForm, setTrainingForm] = useState({
    title: '',
    trainer: '',
    targetDepartment: 'ALL',
    targetRound: 'ALL',
    date: new Date().toISOString().split('T')[0],
    time: '09:30 AM - 12:30 PM',
    venue: 'Main Auditorium',
    mode: 'Offline',
    status: 'Scheduled',
    description: ''
  });

  const [selectedTrainingForAttendance, setSelectedTrainingForAttendance] = useState(null);

  // Eligibility tracker state
  const [selectedEligibleJob, setSelectedEligibleJob] = useState('');

  // ── ADVANCED PLACEMENT REPORTS & ANALYTICS SUITE STATE ──
  const [reportSubTab, setReportSubTab] = useState('summary');
  const [reportDeptFilter, setReportDeptFilter] = useState('ALL');
  const [reportCompanyFilter, setReportCompanyFilter] = useState('ALL');
  const [reportStatusFilter, setReportStatusFilter] = useState('ALL');
  const [reportYearFilter, setReportYearFilter] = useState('2026-2027');
  const [reportSearch, setReportSearch] = useState('');
  const [reportSort, setReportSort] = useState('default');
  const [reportRoundJobId, setReportRoundJobId] = useState('');

  // Multi-Worksheet XML Spreadsheet Excel Generator
  const downloadMultiSheetExcel = (filename, worksheets, academicYear) => {
    const escapeXml = (str) => {
      if (str === null || str === undefined) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&apos;');
    };

    let xml = `<?xml version="1.0" encoding="UTF-8"?>
<?mso-application progid="Excel.Sheet"?>
<Workbook xmlns="urn:schemas-microsoft-com:office:spreadsheet"
 xmlns:o="urn:schemas-microsoft-com:office:office"
 xmlns:x="urn:schemas-microsoft-com:office:excel"
 xmlns:ss="urn:schemas-microsoft-com:office:spreadsheet"
 xmlns:html="http://www.w3.org/TR/REC-html40">
 <DocumentProperties xmlns="urn:schemas-microsoft-com:office:office">
  <Title>College ERP - Campus Placement Audit & Executive Analytics Report</Title>
  <Created>${new Date().toISOString()}</Created>
 </DocumentProperties>
 <Styles>
  <Style ss:ID="Default" ss:Name="Normal">
   <Alignment ss:Vertical="Center"/>
   <Borders/>
   <Font ss:FontName="Calibri" x:Family="Swiss" ss:Size="11" ss:Color="#0F172A"/>
  </Style>
  <Style ss:ID="Header">
   <Alignment ss:Horizontal="Center" ss:Vertical="Center"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="2" ss:Color="#CBD5E1"/>
    <Border ss:Position="Top" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#CBD5E1"/>
    <Border ss:Position="Left" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#CBD5E1"/>
    <Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#CBD5E1"/>
   </Borders>
   <Font ss:FontName="Calibri" x:Family="Swiss" ss:Size="11" ss:Color="#FFFFFF" ss:Bold="1"/>
   <Interior ss:Color="#1E40AF" ss:Pattern="Solid"/>
  </Style>
  <Style ss:ID="Title">
   <Font ss:FontName="Calibri" x:Family="Swiss" ss:Size="14" ss:Color="#1E40AF" ss:Bold="1"/>
  </Style>
  <Style ss:ID="SubTitle">
   <Font ss:FontName="Calibri" x:Family="Swiss" ss:Size="10" ss:Color="#64748B" ss:Italic="1"/>
  </Style>
  <Style ss:ID="DataCell">
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
    <Border ss:Position="Left" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
    <Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
   </Borders>
  </Style>
  <Style ss:ID="HighlightCell">
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
    <Border ss:Position="Left" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
    <Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
   </Borders>
   <Font ss:FontName="Calibri" x:Family="Swiss" ss:Size="11" ss:Color="#15803D" ss:Bold="1"/>
   <Interior ss:Color="#DCFCE7" ss:Pattern="Solid"/>
  </Style>
 </Styles>`;

    worksheets.forEach(sheet => {
      const cleanName = (sheet.name || 'Sheet').replace(/[:\\/?*\[\]]/g, '_').slice(0, 31);
      xml += `\n <Worksheet ss:Name="${escapeXml(cleanName)}">\n  <Table>`;
      xml += `\n   <Row ss:Height="24"><Cell ss:StyleID="Title"><Data ss:Type="String">${escapeXml(sheet.title || sheet.name)}</Data></Cell></Row>`;
      xml += `\n   <Row ss:Height="18"><Cell ss:StyleID="SubTitle"><Data ss:Type="String">Generated: ${new Date().toLocaleString()} | Academic Year: ${escapeXml(academicYear || 'Not specified')}</Data></Cell></Row>`;
      xml += `\n   <Row><Cell><Data ss:Type="String"></Data></Cell></Row>`;
      
      xml += `\n   <Row ss:Height="22">`;
      sheet.headers.forEach(h => {
        xml += `<Cell ss:StyleID="Header"><Data ss:Type="String">${escapeXml(h)}</Data></Cell>`;
      });
      xml += `</Row>`;

      sheet.rows.forEach(row => {
        xml += `\n   <Row ss:Height="20">`;
        row.forEach(val => {
          const isNum = typeof val === 'number';
          xml += `<Cell ss:StyleID="DataCell"><Data ss:Type="${isNum ? 'Number' : 'String'}">${escapeXml(String(val ?? ''))}</Data></Cell>`;
        });
        xml += `</Row>`;
      });

      xml += `\n  </Table>\n </Worksheet>`;
    });

    xml += `\n</Workbook>`;

    const blob = new Blob([xml], { type: 'application/vnd.ms-excel;charset=utf-8;' });
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.href = url;
    link.setAttribute('download', `${filename}.xls`);
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
    URL.revokeObjectURL(url);
  };

  const fetchPlacementData = useCallback(async () => {
    setLoading(true);
    const tenantId = sessionStorage.getItem('tenantId') || 'mock_college_id';
    try {
      const [compRes, jobsRes, appsRes, intRes, selRes, studentsRes, marksRes, attRes] = await Promise.all([
        getPlacementCompanies().catch(() => ({ data: [] })),
        getPlacementJobs().catch(() => ({ data: [] })),
        getPlacementApplications().catch(() => ({ data: [] })),
        getPlacementInterviews().catch(() => ({ data: [] })),
        getPlacementSelections().catch(() => ({ data: [] })),
        getStudents().catch(() => ({ data: [] })),
        getAllMarks().catch(() => ({ data: [] })),
        getAllAttendance().catch(() => ({ data: [] }))
      ]);

      const readArray = (res, key) => {
        if (Array.isArray(res?.data)) return res.data;
        if (Array.isArray(res?.data?.[key])) return res.data[key];
        return [];
      };

      // 1. Process Jobs (Merge API & All Local Storage)
      let combinedJobs = readArray(jobsRes, 'jobs');
      try {
        const jobMap = new Map();
        combinedJobs.forEach(j => jobMap.set(String(j._id || j.jobId || j.id), j));

        for (let i = 0; i < localStorage.length; i++) {
          const key = localStorage.key(i);
          if (key && key.startsWith('erp_placement_jobs')) {
            try {
              const localItems = JSON.parse(localStorage.getItem(key) || '[]');
              if (Array.isArray(localItems)) {
                localItems.forEach(lj => {
                  const ljId = String(lj._id || lj.jobId || lj.id);
                  if (ljId && !jobMap.has(ljId)) {
                    jobMap.set(ljId, lj);
                  }
                });
              }
            } catch (err) {}
          }
        }
        combinedJobs = Array.from(jobMap.values());
      } catch (e) {
        console.error('Error merging local jobs:', e);
      }
      setJobs(combinedJobs);

      // 2. Process Companies (Merge API, All Local Storage, and Jobs-derived)
      let combinedComps = readArray(compRes, 'companies');
      try {
        const compMap = new Map();
        combinedComps.forEach(c => {
          const cKey = String(c.name || c._id || c.companyId || '').trim().toLowerCase();
          if (cKey) compMap.set(cKey, c);
        });

        for (let i = 0; i < localStorage.length; i++) {
          const key = localStorage.key(i);
          if (key && key.startsWith('erp_placement_companies')) {
            try {
              const localItems = JSON.parse(localStorage.getItem(key) || '[]');
              if (Array.isArray(localItems)) {
                localItems.forEach(lc => {
                  const cKey = String(lc.name || lc._id || lc.companyId || '').trim().toLowerCase();
                  if (cKey && !compMap.has(cKey)) {
                    compMap.set(cKey, lc);
                  }
                });
              }
            } catch (err) {}
          }
        }

        // Auto derive missing partner companies from active jobs
        combinedJobs.forEach(j => {
          if (j.company) {
            const jcKey = String(j.company).trim().toLowerCase();
            if (!compMap.has(jcKey)) {
              compMap.set(jcKey, {
                _id: `comp_auto_${j.company.replace(/\s+/g, '_')}`,
                companyId: `COMP-${j.company.substring(0, 3).toUpperCase()}`,
                name: j.company,
                sector: 'Corporate Partner',
                location: 'Pan India',
                status: 'Active',
                drives: 1
              });
            }
          }
        });
        combinedComps = Array.from(compMap.values());
      } catch (e) {
        console.error('Error merging local companies:', e);
      }
      setCompanies(combinedComps);

      // 3. Process Applications (Multi-key scan all tenant applications)
      let combinedApps = readArray(appsRes, 'applications');
      try {
        const appMap = new Map();
        combinedApps.forEach(a => {
          const aId = String(a._id || a.applicationId || `${a.regNo || a.rollNo}_${a.company}_${a.role}`);
          appMap.set(aId, {
            ...a,
            student: a.student || a.studentName || a.name || 'Candidate',
            regNo: a.regNo || a.rollNo || a.registerNo || 'N/A',
            dept: a.dept || a.department || 'TAMIL',
            cgpa: a.cgpa !== undefined ? a.cgpa : 0.0,
            status: a.status || 'Applied'
          });
        });

        for (let i = 0; i < localStorage.length; i++) {
          const key = localStorage.key(i);
          if (key && key.startsWith('erp_placement_applications')) {
            try {
              const localItems = JSON.parse(localStorage.getItem(key) || '[]');
              if (Array.isArray(localItems)) {
                localItems.forEach(la => {
                  const laId = String(la._id || la.applicationId || `${la.regNo || la.rollNo || la.student}_${la.company}_${la.role}`);
                  if (laId && !appMap.has(laId)) {
                    appMap.set(laId, {
                      ...la,
                      student: la.student || la.studentName || la.name || 'Candidate',
                      regNo: la.regNo || la.rollNo || la.registerNo || 'N/A',
                      dept: la.dept || la.department || 'TAMIL',
                      cgpa: la.cgpa !== undefined ? la.cgpa : 0.0,
                      status: la.status || 'Applied'
                    });
                  }
                });
              }
            } catch (err) {}
          }
        }
        combinedApps = Array.from(appMap.values());
      } catch (e) {
        console.error('Error merging local applications:', e);
      }
      setApplications(combinedApps);

      // 4. Process Interviews (Multi-key scan)
      let combinedInts = readArray(intRes, 'interviews');
      try {
        const intMap = new Map();
        combinedInts.forEach(i => {
          const iId = String(i._id || i.interviewId || `${i.company}_${i.round}`);
          intMap.set(iId, i);
        });

        for (let i = 0; i < localStorage.length; i++) {
          const key = localStorage.key(i);
          if (key && key.startsWith('erp_placement_interviews')) {
            try {
              const localItems = JSON.parse(localStorage.getItem(key) || '[]');
              if (Array.isArray(localItems)) {
                localItems.forEach(li => {
                  const liId = String(li._id || li.interviewId || `${li.company}_${li.round}`);
                  if (liId && !intMap.has(liId)) {
                    intMap.set(liId, li);
                  }
                });
              }
            } catch (err) {}
          }
        }
        combinedInts = Array.from(intMap.values());
      } catch (e) {
        console.error('Error merging local interviews:', e);
      }
      setInterviews(combinedInts);

      // 5. Process Selections (Multi-key scan)
      let combinedSels = readArray(selRes, 'selections');
      try {
        const selMap = new Map();
        combinedSels.forEach(s => {
          const sId = String(s._id || s.selectionId || `${s.regNo}_${s.company}`);
          selMap.set(sId, s);
        });

        for (let i = 0; i < localStorage.length; i++) {
          const key = localStorage.key(i);
          if (key && key.startsWith('erp_placement_selections')) {
            try {
              const localItems = JSON.parse(localStorage.getItem(key) || '[]');
              if (Array.isArray(localItems)) {
                localItems.forEach(ls => {
                  const lsId = String(ls._id || ls.selectionId || `${ls.regNo || ls.student}_${ls.company}`);
                  if (lsId && !selMap.has(lsId)) {
                    selMap.set(lsId, ls);
                  }
                });
              }
            } catch (err) {}
          }
        }
        combinedSels = Array.from(selMap.values());
      } catch (e) {
        console.error('Error merging local selections:', e);
      }
      setSelections(combinedSels);

      // 6. Raw students (Multi-key scan)
      let rawStudents = readArray(studentsRes, 'students');
      try {
        const stMap = new Map();
        rawStudents.forEach(st => {
          const stId = String(st.id || st.rollNo || st.regNo || st._id);
          stMap.set(stId, st);
        });
        for (let i = 0; i < localStorage.length; i++) {
          const key = localStorage.key(i);
          if (key && key.startsWith('erp_students')) {
            try {
              const localSts = JSON.parse(localStorage.getItem(key) || '[]');
              if (Array.isArray(localSts)) {
                localSts.forEach(st => {
                  const stId = String(st.id || st.rollNo || st.regNo || st._id);
                  if (stId && !stMap.has(stId)) {
                    stMap.set(stId, st);
                  }
                });
              }
            } catch (err) {}
          }
        }
        combinedApps.forEach(app => {
          const stId = String(app.regNo || app.studentId || app.student || '');
          if (stId && !stMap.has(stId)) {
            stMap.set(stId, {
              _id: app.studentId || `ST_${stId}`,
              id: app.regNo || stId,
              rollNo: app.regNo || stId,
              regNo: app.regNo || stId,
              name: app.student || app.studentName || 'Candidate',
              dept: app.dept || app.department || 'TAMIL',
              cgpa: app.cgpa || 0,
              arrears: 0,
              attendance: '100%'
            });
          }
        });
        rawStudents = Array.from(stMap.values());
      } catch (e) {}

      // 7. Merge Marks & Attendance for Live Student Calculations
      const rawMarks = readArray(marksRes, 'marks');
      let localMarks = [];
      for (let i = 0; i < localStorage.length; i++) {
        const key = localStorage.key(i);
        if (key && key.startsWith('erp_marks')) {
          try {
            const rawM = JSON.parse(localStorage.getItem(key) || '[]');
            if (Array.isArray(rawM)) {
              rawM.forEach(item => {
                if (item.records && Array.isArray(item.records)) {
                  item.records.forEach(r => localMarks.push({ ...r, resultStatus: item.status || r.resultStatus }));
                } else {
                  localMarks.push(item);
                }
              });
            }
          } catch (err) {}
        }
      }
      const combinedMarks = [...rawMarks, ...localMarks];

      const rawAtt = readArray(attRes, 'attendance');
      let localAtt = [];
      for (let i = 0; i < localStorage.length; i++) {
        const key = localStorage.key(i);
        if (key && key.startsWith('erp_attendance')) {
          try {
            const rawA = JSON.parse(localStorage.getItem(key) || '[]');
            if (Array.isArray(rawA)) {
              rawA.forEach(a => localAtt.push(a));
            }
          } catch (err) {}
        }
      }
      const combinedAtt = [...rawAtt, ...localAtt];

      const enrichedStudents = rawStudents.map(st => {
        const sRoll = String(st.id || st.rollNo || st.regNo || '').toLowerCase();
        const sName = String(st.name || '').toLowerCase();

        // Marks & CGPA & Arrears
        const stMarks = combinedMarks.filter(m => {
          const mId = String(m.studentId || m._id || m.id || '').toLowerCase();
          const mRoll = String(m.registerNo || m.rollNo || '').toLowerCase();
          const mName = String(m.studentName || m.name || '').toLowerCase();
          return (mId && sRoll && mId === sRoll) || (mRoll && sRoll && mRoll === sRoll) || (mName && sName && (mName === sName || mName.includes(sName)));
        });

        let computedCgpa = Number(st.cgpa ?? 0);
        let computedArrears = Number(st.arrears ?? 0);

        if (stMarks.length > 0) {
          const validGpas = stMarks.map(m => {
            const tot = Number(m.totalMarks ?? (Number(m.internalMarks || 0) + Number(m.semesterMarks || 0)) ?? m.marksObtained ?? 0);
            return Number(m.cgpa || m.gpa || (tot > 0 ? (tot / 10).toFixed(2) : 0));
          }).filter(g => g > 0);

          if (validGpas.length > 0 && computedCgpa === 0) {
            computedCgpa = Number((validGpas.reduce((a, b) => a + b, 0) / validGpas.length).toFixed(2));
          }

          computedArrears = stMarks.filter(m => {
            const tot = Number(m.totalMarks ?? (Number(m.internalMarks || 0) + Number(m.semesterMarks || 0)) ?? m.marksObtained ?? 0);
            return m.arrearStatus === 'Arrear' || (m.totalMarks !== undefined && tot < 40);
          }).length;
        }

        // Attendance
        const stAtt = combinedAtt.filter(r => 
          String(r.studentId || '').toLowerCase() === sRoll || 
          String(r.studentName || '').toLowerCase() === sName
        );

        let computedAttendance = st.attendance !== undefined && st.attendance !== null ? st.attendance : '100%';
        if (stAtt.length > 0) {
          const presents = stAtt.filter(r => ['Present', 'Late'].includes(r.status)).length;
          computedAttendance = `${Math.round((presents / stAtt.length) * 100)}%`;
        }

        return {
          ...st,
          cgpa: computedCgpa,
          arrears: computedArrears,
          attendance: computedAttendance
        };
      });

      setAllStudents(enrichedStudents);

      // 5. Process Training Programs (Multi-key scan live)
      let localTraining = [];
      try {
        const primary = localStorage.getItem(`erp_placement_training_programs_${tenantId}`) || localStorage.getItem('erp_placement_training_programs');
        if (primary) {
          const parsed = JSON.parse(primary);
          if (Array.isArray(parsed)) {
            localTraining = parsed.filter(p => !['TP-101', 'TP-102', 'TP-103', 'TP-104'].includes(p.id));
          }
        }
      } catch (e) {}

      const trainingMap = new Map();
      if (Array.isArray(localTraining)) {
        localTraining.forEach(t => trainingMap.set(String(t.id || t._id), t));
      }

      for (let i = 0; i < localStorage.length; i++) {
        const key = localStorage.key(i);
        if (key && key.startsWith('erp_placement_training_programs')) {
          try {
            const items = JSON.parse(localStorage.getItem(key) || '[]');
            if (Array.isArray(items)) {
              items.forEach(it => {
                const tId = String(it.id || it._id);
                if (tId && !['TP-101', 'TP-102', 'TP-103', 'TP-104'].includes(tId) && !trainingMap.has(tId)) {
                  trainingMap.set(tId, it);
                }
              });
            }
          } catch (e) {}
        }
      }
      setTrainingPrograms(Array.from(trainingMap.values()));

      // 6. Process Training Attendance
      try {
        const savedAtt = localStorage.getItem(`erp_placement_training_attendance_${tenantId}`) || localStorage.getItem('erp_placement_training_attendance');
        if (savedAtt) setStudentTrainingStatus(JSON.parse(savedAtt));
      } catch (e) {}

    } catch (error) {
      console.error('Failed to load placement data', error);
    } finally {
      setLoading(false);
    }
  }, []);

  useEffect(() => {
    fetchPlacementData();

    const handlePlacementUpdate = () => {
      console.log('⚡ Placement data updated across ERP - refreshing live state');
      fetchPlacementData();
    };

    window.addEventListener('erp_placement_updated', handlePlacementUpdate);
    window.addEventListener('erp_marks_updated', handlePlacementUpdate);
    window.addEventListener('storage', handlePlacementUpdate);

    return () => {
      window.removeEventListener('erp_placement_updated', handlePlacementUpdate);
      window.removeEventListener('erp_marks_updated', handlePlacementUpdate);
      window.removeEventListener('storage', handlePlacementUpdate);
    };
  }, [fetchPlacementData]);

  // Auto-select first job for Eligibility Tracker & Interview Evaluation
  useEffect(() => {
    if (jobs.length > 0) {
      if (!selectedEligibleJob) {
        setSelectedEligibleJob(jobs[0]._id || jobs[0].jobId || jobs[0].id);
      }
      if (!selectedInterviewJob) {
        setSelectedInterviewJob(jobs[0]._id || jobs[0].jobId || jobs[0].id);
      }
    }
  }, [jobs, selectedEligibleJob, selectedInterviewJob]);

  // Current Active Job for Interview Round Evaluations
  const currentInterviewJob = useMemo(() => {
    if (!selectedInterviewJob && jobs.length > 0) return jobs[0];
    return jobs.find(j => (j._id || j.jobId || j.id) === selectedInterviewJob) || jobs[0] || null;
  }, [jobs, selectedInterviewJob]);

  // Current Job's configured rounds
  const currentJobRounds = useMemo(() => {
    if (!currentInterviewJob) return generateDefaultRounds(3);
    if (Array.isArray(currentInterviewJob.rounds) && currentInterviewJob.rounds.length > 0) {
      return currentInterviewJob.rounds;
    }
    return generateDefaultRounds(currentInterviewJob.totalRounds || 3);
  }, [currentInterviewJob]);

  // Applications for the current interview job
  const currentJobApplications = useMemo(() => {
    if (!currentInterviewJob) return [];
    const jId = currentInterviewJob._id || currentInterviewJob.jobId || currentInterviewJob.id;
    const jCompany = String(currentInterviewJob.company || '').trim().toLowerCase();
    const jRole = String(currentInterviewJob.role || '').trim().toLowerCase();

    return applications.filter(app => {
      const aJobId = app.jobId || app.job?._id;
      const aCompany = String(app.company || '').trim().toLowerCase();
      const aRole = String(app.role || '').trim().toLowerCase();

      return (aJobId && (aJobId === jId || aJobId === currentInterviewJob._id)) || 
             (aCompany === jCompany && aRole === jRole);
    });
  }, [applications, currentInterviewJob]);

  // Dynamic Calculation of Eligible & Not Eligible Students for the selected job
  const { liveEligible, liveIneligible } = useMemo(() => {
    if (!selectedEligibleJob) return { liveEligible: [], liveIneligible: [] };
    const currentJob = jobs.find(j => (j._id || j.jobId || j.id) === selectedEligibleJob);
    if (!currentJob) return { liveEligible: [], liveIneligible: [] };

    const minCgpa = Number(currentJob.minCgpa ?? 0);
    const maxArrears = Number(currentJob.maxArrears ?? 0);
    const allowedDepts = Array.isArray(currentJob.eligibleDepartments) && currentJob.eligibleDepartments.length > 0
      ? currentJob.eligibleDepartments.map(d => String(d).trim().toLowerCase())
      : ['all'];

    const eligible = [];
    const ineligible = [];

    allStudents.forEach(st => {
      const sCgpa = Number(st.cgpa ?? 0);
      const sArrears = Number(st.arrears ?? 0);
      const sDept = String(st.dept || st.department || 'General').trim().toLowerCase();

      const deptMatch = allowedDepts.includes('all') || allowedDepts.some(d => sDept.includes(d) || d.includes(sDept));
      const cgpaMatch = minCgpa === 0 || sCgpa >= minCgpa;
      const arrearsMatch = sArrears <= maxArrears;

      if (deptMatch && cgpaMatch && arrearsMatch) {
        eligible.push(st);
      } else {
        let reasons = [];
        if (!deptMatch) reasons.push(`Department ${st.dept || 'General'} not shortlisted`);
        if (!cgpaMatch) reasons.push(`CGPA ${sCgpa} < ${minCgpa}`);
        if (!arrearsMatch) reasons.push(`Arrears ${sArrears} > max ${maxArrears}`);
        ineligible.push({ ...st, reason: reasons.join(' • ') });
      }
    });

    return { liveEligible: eligible, liveIneligible: ineligible };
  }, [selectedEligibleJob, jobs, allStudents]);

  // Handle Round Count Change in Job Form
  const handleRoundCountChange = (count) => {
    const num = Math.max(1, Math.min(Number(count) || 1, 6));
    const newRounds = generateDefaultRounds(num);
    const merged = newRounds.map((r, i) => {
      if (jobForm.rounds && jobForm.rounds[i]) {
        return { ...r, name: jobForm.rounds[i].name || r.name, type: jobForm.rounds[i].type || r.type };
      }
      return r;
    });
    setJobForm(prev => ({
      ...prev,
      totalRounds: num,
      rounds: merged
    }));
  };

  // Handle Custom Round Detail Change in Job Form
  const handleRoundDetailChange = (index, field, value) => {
    setJobForm(prev => {
      const updated = [...prev.rounds];
      if (updated[index]) {
        updated[index] = { ...updated[index], [field]: value };
      }
      return { ...prev, rounds: updated };
    });
  };

  // Handle Update Student Round Status (Qualified, Selected, Rejected, Pending, Absent)
  const handleUpdateStudentRoundStatus = async (app, roundName, roundIndex, newStatus, notes = '') => {
    const appId = app._id || app.applicationId;
    try {
      await updatePlacementApplicationStatus(appId, {
        status: newStatus,
        roundName,
        roundIndex,
        notes
      });

      setApplications(prev => prev.map(a => {
        if (a._id === appId || a.applicationId === appId) {
          const roundEvaluations = { ...(a.roundEvaluations || {}) };
          roundEvaluations[roundName] = {
            status: newStatus,
            notes,
            updatedAt: new Date().toISOString()
          };
          return {
            ...a,
            status: newStatus === 'Selected' ? 'Selected' : newStatus === 'Rejected' ? 'Rejected' : newStatus === 'Qualified' ? 'Qualified' : a.status,
            currentRound: newStatus === 'Qualified' ? Math.max(roundIndex + 2, a.currentRound || 1) : a.currentRound,
            roundEvaluations
          };
        }
        return a;
      }));

      if (newStatus === 'Selected') {
        const studentName = app.student || app.name;
        const regNo = app.regNo || app.id || app.rollNo;
        const company = app.company || currentInterviewJob?.company;
        const role = app.role || currentInterviewJob?.role;
        const ctc = currentInterviewJob?.ctc || '4.5 LPA';

        const exists = selections.some(s => s.regNo === regNo && s.company === company);
        if (!exists) {
          try {
            await createPlacementSelection({
              student: studentName,
              regNo,
              company,
              role,
              ctc,
              date: new Date().toISOString().split('T')[0]
            });
            fetchPlacementData();
          } catch (e) {
            console.error(e);
          }
        }
        showToast(`🏆 ${studentName} Selected for ${company} (${ctc})! Placement Offer Issued.`);
      } else if (newStatus === 'Qualified') {
        showToast(`✓ ${app.student || app.name} Qualified ${roundName}! Promoted to next round.`);
      } else if (newStatus === 'Rejected') {
        showToast(`Marked ${app.student || app.name} as Rejected for ${roundName}.`);
      } else {
        showToast(`Updated status for ${app.student || app.name} to ${newStatus}`);
      }

      window.dispatchEvent(new CustomEvent('erp_placement_updated', { detail: { appId, status: newStatus, roundName } }));
    } catch (error) {
      console.error('Failed to update round status', error);
      showToast('Failed to update round status', 'error');
    }
  };

  // One-click Auto-enroll eligible students into drive
  const handleBulkEnrollEligibleStudents = async (jobToEnroll) => {
    const targetJob = jobToEnroll || currentInterviewJob;
    if (!targetJob) return showToast('Please select a job drive first', 'warning');

    const minCgpa = Number(targetJob.minCgpa ?? 0);
    const maxArrears = Number(targetJob.maxArrears ?? 0);
    const allowedDepts = Array.isArray(targetJob.eligibleDepartments) && targetJob.eligibleDepartments.length > 0
      ? targetJob.eligibleDepartments.map(d => String(d).trim().toLowerCase())
      : ['all'];

    const eligibleCandidates = allStudents.filter(st => {
      const sCgpa = Number(st.cgpa ?? 0);
      const sArrears = Number(st.arrears ?? 0);
      const sDept = String(st.dept || st.department || 'General').trim().toLowerCase();
      const deptMatch = allowedDepts.includes('all') || allowedDepts.some(d => sDept.includes(d) || d.includes(sDept));
      const cgpaMatch = minCgpa === 0 || sCgpa >= minCgpa;
      const arrearsMatch = sArrears <= maxArrears;
      return deptMatch && cgpaMatch && arrearsMatch;
    });

    const tenantId = sessionStorage.getItem('tenantId') || 'mock_college_id';
    try {
      showToast(`Enrolling ${eligibleCandidates.length} eligible candidates into ${targetJob.company}...`);
      const payload = {
        company: targetJob.company,
        role: targetJob.role,
        candidates: eligibleCandidates.map(st => ({
          studentId: st._id || st.id,
          name: st.name,
          regNo: st.id || st.rollNo || st.regNo,
          dept: st.dept || st.department || 'General',
          cgpa: st.cgpa || 0
        }))
      };

      try {
        await bulkApplyPlacementApplications(payload);
      } catch (apiErr) {
        console.warn('API bulk apply failed, saving locally:', apiErr);
      }

      // Also persist to local storage
      try {
        const localApps = JSON.parse(localStorage.getItem(`erp_placement_applications_${tenantId}`) || '[]');
        const newApps = payload.candidates.map(cand => ({
          _id: `APP_LOCAL_${Date.now()}_${Math.random()}`,
          applicationId: `APP${Date.now()}`,
          studentId: cand.studentId,
          student: cand.name,
          regNo: cand.regNo,
          dept: cand.dept,
          cgpa: cand.cgpa,
          company: targetJob.company,
          role: targetJob.role,
          status: 'Applied',
          currentRound: 1,
          roundEvaluations: {},
          createdAt: new Date().toISOString()
        }));
        const mergedApps = [...newApps, ...localApps];
        localStorage.setItem(`erp_placement_applications_${tenantId}`, JSON.stringify(mergedApps));
        localStorage.setItem('erp_placement_applications', JSON.stringify(mergedApps));
      } catch (e) {}

      showToast(`✓ Successfully enrolled ${eligibleCandidates.length} scholars into ${targetJob.company} Drive!`);
      window.dispatchEvent(new CustomEvent('erp_placement_updated', { detail: payload }));
      await fetchPlacementData();
    } catch (err) {
      console.error(err);
      showToast('Failed to bulk enroll students', 'error');
    }
  };

  // Handle Add Company
  const handleAddCompany = async (e) => {
    e.preventDefault();
    if (!companyForm.name.trim()) return showToast('Please enter company name', 'warning');
    const tenantId = sessionStorage.getItem('tenantId') || 'mock_college_id';
    const fallbackCompany = {
      _id: `COMP_LOCAL_${Date.now()}`,
      companyId: `COMP${Date.now()}`,
      name: companyForm.name.trim(),
      sector: companyForm.sector || 'IT & Software',
      location: companyForm.location || 'Pan India',
      website: companyForm.website || '',
      hrName: companyForm.hrName || '',
      hrEmail: companyForm.hrEmail || '',
      hrContact: companyForm.hrContact || '',
      status: 'Active',
      drives: 0,
      createdAt: new Date().toISOString()
    };

    let createdComp = fallbackCompany;
    try {
      const res = await createPlacementCompany(companyForm);
      if (res.data) createdComp = res.data;
    } catch (error) {
      console.warn('API add company fallback to local:', error);
    }

    try {
      const localComps = JSON.parse(localStorage.getItem(`erp_placement_companies_${tenantId}`) || '[]');
      const updated = [createdComp, ...localComps.filter(c => (c._id || c.companyId) !== (createdComp._id || createdComp.companyId))];
      localStorage.setItem(`erp_placement_companies_${tenantId}`, JSON.stringify(updated));
      localStorage.setItem('erp_placement_companies', JSON.stringify(updated));
    } catch (e) {}

    setShowCompanyModal(false);
    const cName = companyForm.name;
    setCompanyForm({ name: '', sector: 'IT & Software', location: 'Pan India', website: '', hrName: '', hrEmail: '', hrContact: '' });
    
    window.dispatchEvent(new CustomEvent('erp_placement_updated', { detail: createdComp }));
    showToast(`✓ Added ${cName} to Partner Recruiters!`);
    fetchPlacementData();
  };

  // Handle Delete Company
  const handleDeleteCompany = async (companyId, companyName) => {
    if (!window.confirm(`Are you sure you want to delete ${companyName}?`)) return;
    const tenantId = sessionStorage.getItem('tenantId') || 'mock_college_id';
    try {
      await deletePlacementCompany(companyId).catch(() => {});
    } catch (error) {}

    try {
      const localComps = JSON.parse(localStorage.getItem(`erp_placement_companies_${tenantId}`) || '[]');
      const updated = localComps.filter(c => (c._id || c.companyId) !== companyId && (c.name || '').toLowerCase() !== companyName.toLowerCase());
      localStorage.setItem(`erp_placement_companies_${tenantId}`, JSON.stringify(updated));
      localStorage.setItem('erp_placement_companies', JSON.stringify(updated));
    } catch (e) {}

    window.dispatchEvent(new CustomEvent('erp_placement_updated', { detail: { companyId } }));
    showToast(`Removed ${companyName}`);
    fetchPlacementData();
  };

  // Handle Add Job / Drive
  const handleAddJob = async (e) => {
    e.preventDefault();
    if (!jobForm.company.trim() || !jobForm.role.trim()) {
      showToast('Please enter both Company and Role', 'warning');
      return;
    }
    const tenantId = sessionStorage.getItem('tenantId') || 'mock_college_id';
    const companyName = jobForm.company.trim();

    const fallbackJob = {
      _id: `JOB_LOCAL_${Date.now()}`,
      jobId: `JOB${Date.now()}`,
      company: companyName,
      role: jobForm.role.trim(),
      ctc: jobForm.ctc || '4.5 LPA',
      eligibility: jobForm.eligibility || `CGPA >= ${jobForm.minCgpa || 0} & Max ${jobForm.maxArrears ?? 0} Arrears`,
      minCgpa: Number(jobForm.minCgpa) || 0,
      maxArrears: Number(jobForm.maxArrears) || 0,
      eligibleDepartments: Array.isArray(jobForm.eligibleDepartments) && jobForm.eligibleDepartments.length > 0 ? jobForm.eligibleDepartments : ['ALL'],
      driveDate: jobForm.driveDate || getDefaultDriveDate(),
      deadline: jobForm.deadline || getDefaultDeadline(),
      totalRounds: Number(jobForm.totalRounds) || 3,
      rounds: jobForm.rounds || generateDefaultRounds(3),
      applicants: 0,
      createdAt: new Date().toISOString()
    };

    let createdJob = fallbackJob;
    try {
      const res = await createPlacementJob({
        ...jobForm,
        driveDate: jobForm.driveDate || getDefaultDriveDate(),
        deadline: jobForm.deadline || getDefaultDeadline()
      });
      if (res.data) createdJob = res.data;
    } catch (error) {
      console.warn('API create job failed, caching to localStorage:', error);
    }

    // Always update local storage for reliable instant rendering
    try {
      const existing = JSON.parse(localStorage.getItem(`erp_placement_jobs_${tenantId}`) || '[]');
      const updated = [createdJob, ...existing.filter(j => (j._id || j.jobId) !== (createdJob._id || createdJob.jobId))];
      localStorage.setItem(`erp_placement_jobs_${tenantId}`, JSON.stringify(updated));
      localStorage.setItem('erp_placement_jobs', JSON.stringify(updated));
    } catch (e) {}

    // Auto-save company locally as well
    try {
      const existingComps = JSON.parse(localStorage.getItem(`erp_placement_companies_${tenantId}`) || '[]');
      if (!existingComps.some(c => (c.name || '').toLowerCase() === companyName.toLowerCase())) {
        const newComp = {
          _id: `COMP_LOCAL_${Date.now()}`,
          companyId: `COMP${Date.now()}`,
          name: companyName,
          sector: 'Corporate Partner',
          location: 'Pan India',
          status: 'Active',
          drives: 1,
          createdAt: new Date().toISOString()
        };
        const updatedComps = [newComp, ...existingComps];
        localStorage.setItem(`erp_placement_companies_${tenantId}`, JSON.stringify(updatedComps));
        localStorage.setItem('erp_placement_companies', JSON.stringify(updatedComps));
      }
    } catch (e) {}

    setShowJobModal(false);
    setJobForm({ 
      company: '', 
      role: '', 
      ctc: '4.5 LPA', 
      eligibility: 'CGPA >= 6.0 & Zero Arrears', 
      minCgpa: 6.0, 
      maxArrears: 0, 
      eligibleDepartments: ['ALL'], 
      driveDate: getDefaultDriveDate(), 
      deadline: getDefaultDeadline(),
      totalRounds: 3,
      rounds: generateDefaultRounds(3)
    });
    
    window.dispatchEvent(new CustomEvent('erp_placement_updated', { detail: createdJob }));
    showToast(`✓ Successfully scheduled recruitment drive for ${companyName}!`);
    await fetchPlacementData();
    
    // Automatically switch to Job Openings tab so the user sees the posted drive card immediately
    handleTabClick('Job Openings');
  };

  // Handle Delete Job / Drive
  const handleDeleteJob = async (jobId, companyName, roleName) => {
    if (!window.confirm(`Are you sure you want to delete the drive for ${companyName} (${roleName})?`)) return;
    const tenantId = sessionStorage.getItem('tenantId') || 'mock_college_id';
    try {
      await deletePlacementJob(jobId).catch(() => {});
    } catch (error) {}

    try {
      const localJobs = JSON.parse(localStorage.getItem(`erp_placement_jobs_${tenantId}`) || '[]');
      const updated = localJobs.filter(j => (j._id || j.jobId) !== jobId);
      localStorage.setItem(`erp_placement_jobs_${tenantId}`, JSON.stringify(updated));
      localStorage.setItem('erp_placement_jobs', JSON.stringify(updated));
    } catch (e) {}

    window.dispatchEvent(new CustomEvent('erp_placement_updated', { detail: { jobId } }));
    showToast(`Deleted drive for ${companyName}`);
    fetchPlacementData();
  };

  // Handle Application Status Update
  const handleUpdateAppStatus = async (id, nextStatus) => {
    const tenantId = sessionStorage.getItem('tenantId') || 'mock_college_id';
    try {
      await updatePlacementApplicationStatus(id, nextStatus).catch(() => {});
    } catch (error) {}

    setApplications(prev => prev.map(a => (a._id === id || a.applicationId === id) ? { ...a, status: nextStatus } : a));
    
    // Multi-key persistence across all tenant and global application keys
    for (let i = 0; i < localStorage.length; i++) {
      const key = localStorage.key(i);
      if (key && key.startsWith('erp_placement_applications')) {
        try {
          const items = JSON.parse(localStorage.getItem(key) || '[]');
          if (Array.isArray(items)) {
            const updated = items.map(a => (a._id === id || a.applicationId === id) ? { ...a, status: nextStatus } : a);
            localStorage.setItem(key, JSON.stringify(updated));
          }
        } catch (e) {}
      }
    }
    
    window.dispatchEvent(new CustomEvent('erp_placement_updated', { detail: { id, status: nextStatus } }));
    window.dispatchEvent(new Event('storage'));
    showToast(`✓ Updated application status to ${nextStatus}`);
  };

  // Handle Add Interview
  const handleAddInterview = async (e) => {
    e.preventDefault();
    const tenantId = sessionStorage.getItem('tenantId') || 'mock_college_id';
    const fallbackInt = {
      _id: `INT_LOCAL_${Date.now()}`,
      interviewId: `INT${Date.now()}`,
      ...interviewForm,
      createdAt: new Date().toISOString()
    };

    let createdInt = fallbackInt;
    try {
      const res = await createPlacementInterview(interviewForm);
      if (res.data) createdInt = res.data;
    } catch (error) {
      console.warn('API add interview fallback to local:', error);
    }

    try {
      const localInts = JSON.parse(localStorage.getItem(`erp_placement_interviews_${tenantId}`) || '[]');
      const updated = [createdInt, ...localInts];
      localStorage.setItem(`erp_placement_interviews_${tenantId}`, JSON.stringify(updated));
      localStorage.setItem('erp_placement_interviews', JSON.stringify(updated));
    } catch (e) {}

    setShowInterviewModal(false);
    const iComp = interviewForm.company;
    const iRound = interviewForm.round;
    setInterviewForm({ company: '', role: '', round: 'Technical Round 1', date: getDefaultDriveDate(), time: '10:00 AM', mode: 'Online', venue: 'Campus Auditorium / Zoom', panel: 'Recruitment Panel', candidates: 10 });
    
    window.dispatchEvent(new CustomEvent('erp_placement_updated', { detail: createdInt }));
    showToast(`✓ Scheduled ${iRound} for ${iComp}!`);
    fetchPlacementData();
  };

  // Handle Add Selection / Offer
  const handleAddSelection = async (e) => {
    e.preventDefault();
    const tenantId = sessionStorage.getItem('tenantId') || 'mock_college_id';
    const fallbackSel = {
      _id: `SEL_LOCAL_${Date.now()}`,
      selectionId: `SEL${Date.now()}`,
      ...selectionForm,
      createdAt: new Date().toISOString()
    };

    let createdSel = fallbackSel;
    try {
      const res = await createPlacementSelection(selectionForm);
      if (res.data) createdSel = res.data;
    } catch (error) {
      console.warn('API add selection fallback to local:', error);
    }

    try {
      const localSels = JSON.parse(localStorage.getItem(`erp_placement_selections_${tenantId}`) || '[]');
      const updated = [createdSel, ...localSels];
      localStorage.setItem(`erp_placement_selections_${tenantId}`, JSON.stringify(updated));
      localStorage.setItem('erp_placement_selections', JSON.stringify(updated));
    } catch (e) {}

    setShowSelectionModal(false);
    const sStudent = selectionForm.student;
    setSelectionForm({ student: '', regNo: '', company: '', role: '', ctc: '4.5 LPA', date: new Date().toISOString().split('T')[0] });
    
    window.dispatchEvent(new CustomEvent('erp_placement_updated', { detail: createdSel }));
    showToast(`🏆 Added verified placement offer for ${sStudent}!`);
    fetchPlacementData();
  };

  // KPI Calculations
  const packageStats = useMemo(() => {
    let max = 0;
    let sum = 0;
    let count = 0;
    selections.forEach(sel => {
      const val = parseFloat(String(sel.ctc).replace(/[^0-9.]/g, ''));
      if (!isNaN(val) && val > 0) {
        if (val > max) max = val;
        sum += val;
        count++;
      }
    });

    // If selections count is 0, compute from active posted jobs so dashboard shows live offered package metrics
    if (count === 0 && jobs.length > 0) {
      jobs.forEach(job => {
        const val = parseFloat(String(job.ctc).replace(/[^0-9.]/g, ''));
        if (!isNaN(val) && val > 0) {
          if (val > max) max = val;
          sum += val;
          count++;
        }
      });
    }

    return {
      highest: max > 0 ? `${max} LPA` : '0 LPA',
      average: count > 0 ? `${(sum/count).toFixed(2)} LPA` : '0 LPA'
    };
  }, [selections, jobs]);

  // Department-wise placement rate
  const deptStats = useMemo(() => {
    const depts = {};
    allStudents.forEach(st => {
      const d = st.dept || st.department || 'General';
      if (!depts[d]) depts[d] = { total: 0, placed: 0 };
      depts[d].total += 1;
    });

    selections.forEach(sel => {
      const st = allStudents.find(s => 
        String(s.id || s.rollNo || s.regNo || '').toLowerCase() === String(sel.regNo || '').toLowerCase() ||
        String(s.name || '').toLowerCase() === String(sel.student || sel.studentName || '').toLowerCase()
      );
      const d = st ? (st.dept || st.department || 'General') : (sel.dept || 'General');
      if (!depts[d]) depts[d] = { total: 1, placed: 0 };
      depts[d].placed += 1;
    });

    return Object.entries(depts).map(([dept, data]) => ({
      dept,
      percentage: data.total > 0 ? Math.round((data.placed / data.total) * 100) : 0,
      placed: data.placed,
      total: data.total
    }));
  }, [allStudents, selections]);

  // Handle Create Training Program
  const handleCreateTrainingProgram = (e) => {
    e.preventDefault();
    if (!trainingForm.title.trim()) {
      showToast('Please enter program title', 'warning');
      return;
    }
    const tenantId = sessionStorage.getItem('tenantId') || 'mock_college_id';
    const newProg = {
      id: `TP-${Date.now().toString().slice(-4)}`,
      _id: `TP_LOCAL_${Date.now()}`,
      title: trainingForm.title.trim(),
      trainer: trainingForm.trainer.trim() || 'Placement Training Cell',
      targetDepartment: trainingForm.targetDepartment || 'ALL',
      targetRound: trainingForm.targetRound || 'ALL',
      date: trainingForm.date || new Date().toISOString().split('T')[0],
      time: trainingForm.time || '09:30 AM - 12:30 PM',
      venue: trainingForm.venue || 'Main Auditorium',
      mode: trainingForm.mode || 'Offline',
      status: trainingForm.status || 'Scheduled',
      description: trainingForm.description || '',
      createdAt: new Date().toISOString()
    };

    const updated = [newProg, ...trainingPrograms];
    setTrainingPrograms(updated);

    try {
      localStorage.setItem(`erp_placement_training_programs_${tenantId}`, JSON.stringify(updated));
      localStorage.setItem('erp_placement_training_programs', JSON.stringify(updated));
    } catch (err) {
      console.error(err);
    }

    setShowTrainingModal(false);
    setTrainingForm({
      title: '',
      trainer: '',
      targetDepartment: 'ALL',
      targetRound: 'ALL',
      date: new Date().toISOString().split('T')[0],
      time: '09:30 AM - 12:30 PM',
      venue: 'Main Auditorium',
      mode: 'Offline',
      status: 'Scheduled',
      description: ''
    });

    window.dispatchEvent(new CustomEvent('erp_placement_updated', { detail: { type: 'training', program: newProg } }));
    window.dispatchEvent(new Event('storage'));
    showToast(`✓ Scheduled "${newProg.title}" successfully!`);
  };

  // Handle Delete Training Program
  const handleDeleteTrainingProgram = (progId) => {
    if (!window.confirm('Are you sure you want to remove this training program?')) return;
    const tenantId = sessionStorage.getItem('tenantId') || 'mock_college_id';
    const updated = trainingPrograms.filter(p => (p.id !== progId && p._id !== progId));
    setTrainingPrograms(updated);

    try {
      localStorage.setItem(`erp_placement_training_programs_${tenantId}`, JSON.stringify(updated));
      localStorage.setItem('erp_placement_training_programs', JSON.stringify(updated));
    } catch (err) {
      console.error(err);
    }

    window.dispatchEvent(new CustomEvent('erp_placement_updated', { detail: { type: 'training_delete', progId } }));
    window.dispatchEvent(new Event('storage'));
    showToast('Training program removed');
  };

  // Handle Update Training Attendance
  const handleUpdateTrainingAttendance = (key, status) => {
    const updated = {
      ...studentTrainingStatus,
      [key]: status
    };
    setStudentTrainingStatus(updated);

    try {
      const tenantId = sessionStorage.getItem('tenantId') || 'mock_college_id';
      localStorage.setItem(`erp_placement_training_attendance_${tenantId}`, JSON.stringify(updated));
      localStorage.setItem('erp_placement_training_attendance', JSON.stringify(updated));
    } catch (e) {}

    window.dispatchEvent(new CustomEvent('erp_placement_updated', { detail: { type: 'training_attendance', key, status } }));
  };

  // Header Titles
  const getHeaderInfo = () => {
    switch (activeTab) {
      case 'Companies':
        return {
          title: 'Partner Companies & Corporate Recruiters',
          subtitle: 'Manage registered recruiters, corporate profiles, and HR points of contact.'
        };
      case 'Job Openings':
        return {
          title: 'Campus Recruitment Drives & Job Openings',
          subtitle: 'Create, schedule, and track placement drives, packages, eligibility cutoffs, and deadlines.'
        };
      case 'Eligibility Tracker':
        return {
          title: 'Student Eligibility Matrix',
          subtitle: 'Verify eligible candidates for active campus drives based on live CGPA, active arrears, and departments.'
        };
      case 'Applications':
        return {
          title: 'Student Applications Tracking',
          subtitle: 'Review candidate applications, shortlist profiles, and update recruitment status.'
        };
      case 'Training Programs':
        return {
          title: 'Placement Training & Skill Development Programs',
          subtitle: 'Organize, schedule, and track aptitude bootcamps, technical certifications, and mock interview workshops.'
        };
      case 'Interviews':
        return {
          title: 'Interview Schedules & Rounds',
          subtitle: 'Manage recruitment rounds, technical/HR interview venues, meeting links, and candidate rosters.'
        };
      case 'Selected Students':
        return {
          title: 'Selections & Corporate Offer Letters',
          subtitle: 'Track students selected across corporate recruitment drives, compensation packages, and offer dates.'
        };
      case 'Reports':
        return {
          title: 'Placement Reports & NIRF Analytics',
          subtitle: 'Generate and export department summaries, NIRF audit reports, and institution hiring statistics.'
        };
      default:
        return {
          title: 'Placement Overview & Executive Analytics',
          subtitle: 'Key recruitment indicators, active drives status, and placement distribution trends.'
        };
    }
  };

  const headerInfo = getHeaderInfo();

  // Export CSV Helper
  const exportCSV = (filename, headers, rows) => {
    let csv = `data:text/csv;charset=utf-8,${headers.join(',')}\n`;
    rows.forEach(r => {
      csv += r.map(val => `"${String(val).replace(/"/g, '""')}"`).join(',') + '\n';
    });
    const encoded = encodeURI(csv);
    const link = document.createElement('a');
    link.setAttribute('href', encoded);
    link.setAttribute('download', `${filename}.csv`);
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
  };

  return (
    <div className="placement-page animate-fade-in" style={{ padding: '24px', maxWidth: '1440px', margin: '0 auto', display: 'flex', flexDirection: 'column', gap: '20px' }}>
      
      {/* ── Top Header ── */}
      <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', flexWrap: 'wrap', gap: '14px', borderBottom: '1px solid var(--border-color, #e2e8f0)', paddingBottom: '16px' }}>
        <div style={{ display: 'flex', alignItems: 'center', gap: '12px' }}>
          <div style={{ width: '44px', height: '44px', borderRadius: '12px', background: 'rgba(37,99,235,0.1)', color: '#2563eb', display: 'flex', alignItems: 'center', justifyContent: 'center' }}>
            <Briefcase size={24} />
          </div>
          <div>
            <h1 style={{ margin: 0, fontSize: '1.45rem', fontWeight: 800, color: 'var(--text-main, #0f172a)' }}>
              {headerInfo.title}
            </h1>
            <p style={{ margin: '3px 0 0 0', fontSize: '0.85rem', color: 'var(--text-muted, #64748b)' }}>
              {headerInfo.subtitle}
            </p>
          </div>
        </div>

        <div style={{ display: 'flex', gap: '10px', alignItems: 'center', flexWrap: 'wrap' }}>
          <button 
            type="button" 
            onClick={() => fetchPlacementData()} 
            style={{ display: 'flex', alignItems: 'center', gap: '6px', padding: '7px 14px', background: '#2563eb', color: '#ffffff', border: 'none', borderRadius: '8px', fontSize: '0.82rem', fontWeight: 700, cursor: 'pointer' }}
          >
            <RefreshCw size={14} className={loading ? "animate-spin" : ""} /> Sync Live Data
          </button>
        </div>
      </div>

      {/* ── Enterprise Placement Navigation Tabs (Shown in Admin/Embedded views, hidden when dedicated sidebar is active) ── */}
      {!location.pathname.startsWith('/placement') && (
        <div style={{
          display: 'flex',
          gap: '6px',
          overflowX: 'auto',
          padding: '6px 6px 0',
          background: 'var(--bg-secondary, #f8fafc)',
          borderRadius: '12px',
          border: '1px solid var(--border-color, #e2e8f0)',
          scrollbarWidth: 'none'
        }}>
          {[
            { id: 'Dashboard', label: 'Overview', icon: <Briefcase size={16} /> },
            { id: 'Job Openings', label: 'Recruitment Drives', icon: <Briefcase size={16} />, count: jobs.length },
            { id: 'Companies', label: 'Partner Recruiters', icon: <Building size={16} />, count: companies.length },
            { id: 'Applications', label: 'Applications', icon: <Users size={16} />, count: applications.length },
            { id: 'Eligibility Tracker', label: 'Eligibility Matrix', icon: <UserCheck size={16} />, count: allStudents.length },
            { id: 'Interviews', label: 'Interview Evaluator', icon: <Calendar size={16} />, count: interviews.length },
            { id: 'Selected Students', label: 'Placed Students', icon: <Award size={16} />, count: selections.length },
            { id: 'Training Programs', label: 'Training Hub', icon: <BookOpen size={16} /> },
            { id: 'Reports', label: 'Analytics & Reports', icon: <TrendingUp size={16} /> }
          ].map(tab => {
            const isActive = activeTab === tab.id;
            return (
              <button
                key={tab.id}
                type="button"
                onClick={() => handleTabClick(tab.id)}
                style={{
                  display: 'flex',
                  alignItems: 'center',
                  gap: '8px',
                  padding: '9px 16px',
                  borderRadius: '8px 8px 0 0',
                  border: 'none',
                  borderBottom: isActive ? '3px solid #2563eb' : '3px solid transparent',
                  background: isActive ? 'var(--bg-card, #ffffff)' : 'transparent',
                  color: isActive ? '#2563eb' : 'var(--text-muted, #64748b)',
                  fontWeight: isActive ? 800 : 600,
                  fontSize: '0.84rem',
                  cursor: 'pointer',
                  transition: 'all 0.15s ease',
                  whiteSpace: 'nowrap',
                  boxShadow: isActive ? '0 -2px 6px rgba(0,0,0,0.03)' : 'none'
                }}
              >
                {tab.icon}
                <span>{tab.label}</span>
                {tab.count !== undefined && (
                  <span style={{
                    fontSize: '0.7rem',
                    fontWeight: 700,
                    padding: '1px 7px',
                    borderRadius: '10px',
                    background: isActive ? 'rgba(37,99,235,0.12)' : '#e2e8f0',
                    color: isActive ? '#2563eb' : '#475569'
                  }}>
                    {tab.count}
                  </span>
                )}
              </button>
            );
          })}
        </div>
      )}

      {/* ── ONLY SHOW THE 6-KPI EXECUTIVE STRIP ON DASHBOARD / OVERVIEW TAB ── */}
      {activeTab === 'Dashboard' && (
        <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fit, minmax(190px, 1fr))', gap: '14px' }}>
          
          <div 
            onClick={() => handleTabClick('Companies')}
            style={{ background: 'var(--bg-card, #ffffff)', padding: '16px 18px', borderRadius: '14px', border: '1px solid var(--border-color, #e2e8f0)', boxShadow: '0 2px 6px rgba(0,0,0,0.02)', cursor: 'pointer', transition: 'transform 0.15s ease' }}
          >
            <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
              <span style={{ fontSize: '0.72rem', fontWeight: 700, color: '#2563eb', textTransform: 'uppercase' }}>Total Companies</span>
              <div style={{ width: '32px', height: '32px', borderRadius: '8px', background: 'rgba(37,99,235,0.1)', color: '#2563eb', display: 'flex', alignItems: 'center', justifyContent: 'center' }}>
                <Building size={16} />
              </div>
            </div>
            <div style={{ fontSize: '1.65rem', fontWeight: 800, color: 'var(--text-main, #0f172a)', marginTop: '4px' }}>{companies.length}</div>
            <div style={{ fontSize: '0.72rem', color: 'var(--text-muted, #64748b)', marginTop: '2px', display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
              <span>Corporate Partners</span>
              <span style={{ color: '#2563eb', fontWeight: 700 }}>View →</span>
            </div>
          </div>

          <div 
            onClick={() => handleTabClick('Job Openings')}
            style={{ background: 'var(--bg-card, #ffffff)', padding: '16px 18px', borderRadius: '14px', border: '1px solid var(--border-color, #e2e8f0)', boxShadow: '0 2px 6px rgba(0,0,0,0.02)', cursor: 'pointer', transition: 'transform 0.15s ease' }}
          >
            <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
              <span style={{ fontSize: '0.72rem', fontWeight: 700, color: '#16a34a', textTransform: 'uppercase' }}>Active Drives</span>
              <div style={{ width: '32px', height: '32px', borderRadius: '8px', background: 'rgba(22,163,74,0.1)', color: '#16a34a', display: 'flex', alignItems: 'center', justifyContent: 'center' }}>
                <Briefcase size={16} />
              </div>
            </div>
            <div style={{ fontSize: '1.65rem', fontWeight: 800, color: '#15803d', marginTop: '4px' }}>{jobs.length}</div>
            <div style={{ fontSize: '0.72rem', color: '#16a34a', marginTop: '2px', fontWeight: 600, display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
              <span>Recruitment Drives Open</span>
              <span style={{ color: '#16a34a', fontWeight: 700 }}>Drives →</span>
            </div>
          </div>

          <div 
            onClick={() => handleTabClick('Applications')}
            style={{ background: 'var(--bg-card, #ffffff)', padding: '16px 18px', borderRadius: '14px', border: '1px solid var(--border-color, #e2e8f0)', boxShadow: '0 2px 6px rgba(0,0,0,0.02)', cursor: 'pointer', transition: 'transform 0.15s ease' }}
          >
            <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
              <span style={{ fontSize: '0.72rem', fontWeight: 700, color: '#7c3aed', textTransform: 'uppercase' }}>Applications</span>
              <div style={{ width: '32px', height: '32px', borderRadius: '8px', background: 'rgba(124,58,237,0.1)', color: '#7c3aed', display: 'flex', alignItems: 'center', justifyContent: 'center' }}>
                <Users size={16} />
              </div>
            </div>
            <div style={{ fontSize: '1.65rem', fontWeight: 800, color: '#6d28d9', marginTop: '4px' }}>{applications.length}</div>
            <div style={{ fontSize: '0.72rem', color: '#7c3aed', marginTop: '2px', fontWeight: 600, display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
              <span>Candidate Submissions</span>
              <span style={{ color: '#7c3aed', fontWeight: 700 }}>Review →</span>
            </div>
          </div>

          <div 
            onClick={() => handleTabClick('Selected Students')}
            style={{ background: 'var(--bg-card, #ffffff)', padding: '16px 18px', borderRadius: '14px', border: '1px solid var(--border-color, #e2e8f0)', boxShadow: '0 2px 6px rgba(0,0,0,0.02)', cursor: 'pointer', transition: 'transform 0.15s ease' }}
          >
            <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
              <span style={{ fontSize: '0.72rem', fontWeight: 700, color: '#059669', textTransform: 'uppercase' }}>Students Placed</span>
              <div style={{ width: '32px', height: '32px', borderRadius: '8px', background: 'rgba(5,150,105,0.1)', color: '#059669', display: 'flex', alignItems: 'center', justifyContent: 'center' }}>
                <Award size={16} />
              </div>
            </div>
            <div style={{ fontSize: '1.65rem', fontWeight: 800, color: '#047857', marginTop: '4px' }}>{selections.length}</div>
            <div style={{ fontSize: '0.72rem', color: '#047857', marginTop: '2px', fontWeight: 600, display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
              <span>Offers Issued</span>
              <span style={{ color: '#047857', fontWeight: 700 }}>Placed →</span>
            </div>
          </div>

          <div 
            onClick={() => handleTabClick('Reports')}
            style={{ background: 'var(--bg-card, #ffffff)', padding: '16px 18px', borderRadius: '14px', border: '1px solid var(--border-color, #e2e8f0)', boxShadow: '0 2px 6px rgba(0,0,0,0.02)', cursor: 'pointer', transition: 'transform 0.15s ease' }}
          >
            <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
              <span style={{ fontSize: '0.72rem', fontWeight: 700, color: '#d97706', textTransform: 'uppercase' }}>Highest Package</span>
              <div style={{ width: '32px', height: '32px', borderRadius: '8px', background: 'rgba(217,119,6,0.1)', color: '#d97706', display: 'flex', alignItems: 'center', justifyContent: 'center' }}>
                <TrendingUp size={16} />
              </div>
            </div>
            <div style={{ fontSize: '1.65rem', fontWeight: 800, color: '#b45309', marginTop: '4px' }}>{packageStats.highest}</div>
            <div style={{ fontSize: '0.72rem', color: '#d97706', marginTop: '2px', fontWeight: 600, display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
              <span>Top Offer</span>
              <span style={{ color: '#d97706', fontWeight: 700 }}>Reports →</span>
            </div>
          </div>

          <div 
            onClick={() => handleTabClick('Reports')}
            style={{ background: 'var(--bg-card, #ffffff)', padding: '16px 18px', borderRadius: '14px', border: '1px solid var(--border-color, #e2e8f0)', boxShadow: '0 2px 6px rgba(0,0,0,0.02)', cursor: 'pointer', transition: 'transform 0.15s ease' }}
          >
            <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
              <span style={{ fontSize: '0.72rem', fontWeight: 700, color: '#0284c7', textTransform: 'uppercase' }}>Average CTC</span>
              <div style={{ width: '32px', height: '32px', borderRadius: '8px', background: 'rgba(2,132,199,0.1)', color: '#0284c7', display: 'flex', alignItems: 'center', justifyContent: 'center' }}>
                <DollarSign size={16} />
              </div>
            </div>
            <div style={{ fontSize: '1.65rem', fontWeight: 800, color: '#0369a1', marginTop: '4px' }}>{packageStats.average}</div>
            <div style={{ fontSize: '0.72rem', color: '#0369a1', marginTop: '2px', fontWeight: 600, display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
              <span>Overall Mean</span>
              <span style={{ color: '#0284c7', fontWeight: 700 }}>Stats →</span>
            </div>
          </div>

        </div>
      )}

      {/* ── Tabbed View Router Content ── */}

      {/* 1. DASHBOARD / OVERVIEW */}
      {activeTab === 'Dashboard' && (
        <div style={{ display: 'flex', flexDirection: 'column', gap: '20px' }}>
          
          {/* Charts Row */}
          <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fit, minmax(320px, 1fr))', gap: '16px' }}>
            
            <div style={{ background: 'var(--bg-card, #ffffff)', padding: '20px', borderRadius: '14px', border: '1px solid var(--border-color, #e2e8f0)', boxShadow: '0 2px 6px rgba(0,0,0,0.02)' }}>
              <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: '14px' }}>
                <h3 style={{ margin: 0, fontSize: '1rem', fontWeight: 800, color: 'var(--text-main, #0f172a)' }}>
                  Cumulative Hiring Trends (YTD)
                </h3>
                <span style={{ fontSize: '0.75rem', fontWeight: 700, color: '#2563eb', background: '#eff6ff', padding: '2px 8px', borderRadius: '6px' }}>
                  {selections.length} Total Offers
                </span>
              </div>
              <div style={{ height: '240px' }}>
                <ResponsiveContainer width="100%" height="100%">
                  <AreaChart data={CHART_DATA_FALLBACK}>
                    <defs>
                      <linearGradient id="colorPlaced" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="5%" stopColor="#2563eb" stopOpacity={0.4}/>
                        <stop offset="95%" stopColor="#2563eb" stopOpacity={0}/>
                      </linearGradient>
                    </defs>
                    <CartesianGrid strokeDasharray="3 3" vertical={false} stroke="var(--border-color, #f1f5f9)" />
                    <XAxis dataKey="month" stroke="var(--text-muted, #64748b)" fontSize={12} tickLine={false} />
                    <YAxis stroke="var(--text-muted, #64748b)" fontSize={12} tickLine={false} />
                    <Tooltip contentStyle={{ background: 'var(--bg-card, #fff)', border: '1px solid var(--border-color, #cbd5e1)', borderRadius: 8, fontSize: '0.8rem' }} />
                    <Area type="monotone" dataKey="placed" stroke="#2563eb" strokeWidth={2} fillOpacity={1} fill="url(#colorPlaced)" />
                  </AreaChart>
                </ResponsiveContainer>
              </div>
            </div>

            <div style={{ background: 'var(--bg-card, #ffffff)', padding: '20px', borderRadius: '14px', border: '1px solid var(--border-color, #e2e8f0)', boxShadow: '0 2px 6px rgba(0,0,0,0.02)' }}>
              <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: '14px' }}>
                <h3 style={{ margin: 0, fontSize: '1rem', fontWeight: 800, color: 'var(--text-main, #0f172a)' }}>
                  Department-Wise Placement Ratio (%)
                </h3>
                <span style={{ fontSize: '0.75rem', fontWeight: 700, color: '#16a34a', background: '#dcfce7', padding: '2px 8px', borderRadius: '6px' }}>
                  Live Data
                </span>
              </div>
              <div style={{ height: '240px' }}>
                <ResponsiveContainer width="100%" height="100%">
                  <BarChart data={deptStats.length > 0 ? deptStats : [{ dept: 'TAMIL', percentage: 0 }]}>
                    <CartesianGrid strokeDasharray="3 3" vertical={false} stroke="var(--border-color, #f1f5f9)" />
                    <XAxis dataKey="dept" stroke="var(--text-muted, #64748b)" fontSize={12} tickLine={false} />
                    <YAxis stroke="var(--text-muted, #64748b)" fontSize={12} tickLine={false} domain={[0, 100]} />
                    <Tooltip contentStyle={{ background: 'var(--bg-card, #fff)', border: '1px solid var(--border-color, #cbd5e1)', borderRadius: 8, fontSize: '0.8rem' }} />
                    <Bar dataKey="percentage" fill="#10b981" radius={[4, 4, 0, 0]} />
                  </BarChart>
                </ResponsiveContainer>
              </div>
            </div>

          </div>

          {/* Quick Operations & Upcoming Interviews */}
          <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fit, minmax(320px, 1fr))', gap: '16px' }}>
            
            <div style={{ background: 'var(--bg-card, #ffffff)', padding: '20px', borderRadius: '14px', border: '1px solid var(--border-color, #e2e8f0)', boxShadow: '0 2px 6px rgba(0,0,0,0.02)' }}>
              <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: '12px' }}>
                <h3 style={{ margin: 0, fontSize: '1rem', fontWeight: 800, color: 'var(--text-main, #0f172a)' }}>
                  Placement Cell Quick Actions
                </h3>
              </div>
              <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fit, minmax(140px, 1fr))', gap: '10px' }}>
                <button 
                  type="button"
                  onClick={() => setShowCompanyModal(true)}
                  style={{ padding: '12px', background: 'rgba(37,99,235,0.06)', border: '1px solid rgba(37,99,235,0.2)', borderRadius: '10px', color: '#2563eb', fontWeight: 700, fontSize: '0.82rem', cursor: 'pointer', display: 'flex', flexDirection: 'column', alignItems: 'center', gap: '6px' }}
                >
                  <Plus size={18} /> Add Recruiter
                </button>
                <button 
                  type="button"
                  onClick={() => setShowJobModal(true)}
                  style={{ padding: '12px', background: 'rgba(22,163,74,0.06)', border: '1px solid rgba(22,163,74,0.2)', borderRadius: '10px', color: '#16a34a', fontWeight: 700, fontSize: '0.82rem', cursor: 'pointer', display: 'flex', flexDirection: 'column', alignItems: 'center', gap: '6px' }}
                >
                  <Briefcase size={18} /> Post Drive
                </button>
                <button 
                  type="button"
                  onClick={() => setShowInterviewModal(true)}
                  style={{ padding: '12px', background: 'rgba(124,58,237,0.06)', border: '1px solid rgba(124,58,237,0.2)', borderRadius: '10px', color: '#7c3aed', fontWeight: 700, fontSize: '0.82rem', cursor: 'pointer', display: 'flex', flexDirection: 'column', alignItems: 'center', gap: '6px' }}
                >
                  <Calendar size={18} /> Schedule Interview
                </button>
                <button 
                  type="button"
                  onClick={() => setShowSelectionModal(true)}
                  style={{ padding: '12px', background: 'rgba(217,119,6,0.06)', border: '1px solid rgba(217,119,6,0.2)', borderRadius: '10px', color: '#d97706', fontWeight: 700, fontSize: '0.82rem', cursor: 'pointer', display: 'flex', flexDirection: 'column', alignItems: 'center', gap: '6px' }}
                >
                  <Award size={18} /> Record Offer
                </button>
              </div>
            </div>

            <div style={{ background: 'var(--bg-card, #ffffff)', padding: '20px', borderRadius: '14px', border: '1px solid var(--border-color, #e2e8f0)', boxShadow: '0 2px 6px rgba(0,0,0,0.02)' }}>
              <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: '12px' }}>
                <h3 style={{ margin: 0, fontSize: '1rem', fontWeight: 800, color: 'var(--text-main, #0f172a)' }}>
                  Upcoming Interview Sessions ({interviews.length})
                </h3>
                <button 
                  type="button" 
                  onClick={() => handleTabClick('Interviews')}
                  style={{ background: 'none', border: 'none', color: '#2563eb', fontWeight: 700, fontSize: '0.78rem', cursor: 'pointer' }}
                >
                  View All →
                </button>
              </div>
              <div style={{ display: 'flex', flexDirection: 'column', gap: '8px' }}>
                {interviews.slice(0, 3).map((int, i) => (
                  <div key={int._id || int.interviewId || i} style={{ padding: '10px 12px', background: 'var(--bg-secondary, #f8fafc)', borderRadius: '8px', border: '1px solid var(--border-color, #e2e8f0)', display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
                    <div>
                      <div style={{ fontWeight: 800, fontSize: '0.88rem', color: 'var(--text-main)' }}>{int.company} • {int.role}</div>
                      <div style={{ fontSize: '0.75rem', color: 'var(--text-muted)' }}>{int.round} • {int.date ? new Date(int.date).toLocaleDateString() : 'TBA'} ({int.time || '10:00 AM'})</div>
                    </div>
                    <span style={{ fontSize: '0.72rem', fontWeight: 700, padding: '3px 8px', borderRadius: '4px', background: '#eff6ff', color: '#2563eb' }}>
                      {int.mode || 'Online'}
                    </span>
                  </div>
                ))}
                {interviews.length === 0 && (
                  <div style={{ padding: '1.5rem', textAlign: 'center', color: 'var(--text-muted)', fontSize: '0.82rem' }}>
                    No interview sessions currently scheduled.
                  </div>
                )}
              </div>
            </div>

          </div>

          {/* Active Campus Recruitment Drives Showcase on Dashboard */}
          <div style={{ background: 'var(--bg-card, #ffffff)', padding: '22px', borderRadius: '16px', border: '1px solid var(--border-color, #e2e8f0)', boxShadow: '0 2px 8px rgba(0,0,0,0.02)', display: 'flex', flexDirection: 'column', gap: '16px' }}>
            <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', flexWrap: 'wrap', gap: '10px' }}>
              <div>
                <h3 style={{ margin: 0, fontSize: '1.1rem', fontWeight: 800, color: 'var(--text-main, #0f172a)', display: 'flex', alignItems: 'center', gap: '8px' }}>
                  <Briefcase size={20} color="#2563eb" /> Active Campus Recruitment Drives ({jobs.length})
                </h3>
                <p style={{ margin: '2px 0 0 0', fontSize: '0.78rem', color: 'var(--text-muted, #64748b)' }}>
                  Live corporate hiring drives with CTC compensation, cutoff requirements, and deadlines.
                </p>
              </div>

              <div style={{ display: 'flex', gap: '8px', alignItems: 'center' }}>
                <button
                  type="button"
                  onClick={() => setShowJobModal(true)}
                  style={{ display: 'flex', alignItems: 'center', gap: '6px', padding: '7px 14px', background: '#2563eb', color: '#ffffff', border: 'none', borderRadius: '8px', fontSize: '0.8rem', fontWeight: 700, cursor: 'pointer' }}
                >
                  <Plus size={15} /> Post New Drive
                </button>
                <button
                  type="button"
                  onClick={() => handleTabClick('Job Openings')}
                  style={{ padding: '7px 12px', background: '#f1f5f9', color: '#475569', border: '1px solid #cbd5e1', borderRadius: '8px', fontSize: '0.8rem', fontWeight: 700, cursor: 'pointer' }}
                >
                  View All ({jobs.length}) →
                </button>
              </div>
            </div>

            {jobs.length > 0 ? (
              <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fit, minmax(320px, 1fr))', gap: '14px' }}>
                {jobs.slice(0, 4).map((job, idx) => {
                  const jobApps = applications.filter(a => 
                    (a.jobId && (a.jobId === job._id || a.jobId === job.jobId || a.jobId === job.id)) ||
                    (String(a.company || '').toLowerCase() === String(job.company || '').toLowerCase() && String(a.role || '').toLowerCase() === String(job.role || '').toLowerCase())
                  );
                  return (
                    <div key={job._id || job.jobId || idx} style={{
                      background: 'var(--bg-secondary, #f8fafc)',
                      border: '1px solid var(--border-color, #e2e8f0)',
                      borderRadius: '12px',
                      padding: '16px',
                      display: 'flex',
                      flexDirection: 'column',
                      justifyContent: 'space-between',
                      gap: '12px'
                    }}>
                      <div>
                        <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: '6px' }}>
                          <span style={{ fontSize: '0.75rem', fontWeight: 800, padding: '2px 8px', borderRadius: '6px', background: '#dcfce7', color: '#15803d', border: '1px solid #bbf7d0' }}>
                            💰 {job.ctc || '4.5 LPA'}
                          </span>
                          <span style={{ fontSize: '0.72rem', fontWeight: 700, padding: '2px 7px', borderRadius: '5px', background: '#eff6ff', color: '#2563eb' }}>
                            {jobApps.length} Applicants
                          </span>
                        </div>

                        <h4 style={{ margin: '0 0 2px 0', fontSize: '1.05rem', fontWeight: 800, color: 'var(--text-main, #0f172a)' }}>
                          {job.role}
                        </h4>

                        <div style={{ display: 'flex', alignItems: 'center', gap: '6px', fontSize: '0.85rem', fontWeight: 700, color: '#2563eb', marginBottom: '8px' }}>
                          <Building size={14} />
                          <span>{job.company}</span>
                        </div>

                        <div style={{ fontSize: '0.75rem', color: '#64748b', display: 'flex', flexDirection: 'column', gap: '3px' }}>
                          <div>Min CGPA: <strong style={{ color: '#0f172a' }}>{job.minCgpa ?? 'N/A'}</strong> • Arrears: <strong style={{ color: '#0f172a' }}>{job.maxArrears ?? 0} max</strong></div>
                          <div>Deadline: <strong style={{ color: '#dc2626' }}>{job.deadline ? new Date(job.deadline).toLocaleDateString() : 'Open'}</strong></div>
                        </div>
                      </div>

                      <div style={{ borderTop: '1px solid #e2e8f0', paddingTop: '10px', display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
                        <button
                          type="button"
                          onClick={() => {
                            setSelectedEligibleJob(job._id || job.jobId || job.id);
                            handleTabClick('Eligibility Tracker');
                          }}
                          style={{ padding: '4px 10px', background: '#ffffff', border: '1px solid #cbd5e1', borderRadius: '6px', color: '#2563eb', fontWeight: 700, fontSize: '0.74rem', cursor: 'pointer' }}
                        >
                          Check Eligible Students →
                        </button>
                        <button
                          type="button"
                          onClick={() => handleDeleteJob(job._id || job.jobId || job.id, job.company, job.role)}
                          style={{ padding: '4px 8px', background: '#fee2e2', border: '1px solid #fecaca', borderRadius: '6px', color: '#dc2626', cursor: 'pointer' }}
                          title="Delete Drive"
                        >
                          <Trash2 size={12} />
                        </button>
                      </div>
                    </div>
                  );
                })}
              </div>
            ) : (
              <div style={{ padding: '2.5rem', textAlign: 'center', background: 'var(--bg-secondary, #f8fafc)', borderRadius: '12px', border: '1px dashed #cbd5e1', color: 'var(--text-muted)' }}>
                No active recruitment drives posted yet. Click <strong>"+ Post New Drive"</strong> to publish drives.
              </div>
            )}
          </div>

        </div>
      )}

      {/* 2. PARTNER COMPANIES */}
      {activeTab === 'Companies' && (
        <div style={{ display: 'flex', flexDirection: 'column', gap: '16px' }}>
          
          <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', flexWrap: 'wrap', gap: '12px' }}>
            <div style={{ display: 'flex', gap: '10px', alignItems: 'center' }}>
              <div style={{ display: 'flex', alignItems: 'center', width: '280px', background: 'var(--bg-card, #ffffff)', border: '1px solid var(--border-color, #cbd5e1)', borderRadius: '8px', padding: '0 10px' }}>
                <Search size={15} style={{ color: 'var(--text-muted)', flexShrink: 0 }} />
                <input 
                  value={search} 
                  onChange={e => setSearch(e.target.value)} 
                  placeholder="Search company or HR..." 
                  style={{ border: 'none', background: 'transparent', outline: 'none', padding: '8px 8px', fontSize: '0.82rem', width: '100%', color: 'var(--text-main, #0f172a)' }} 
                />
              </div>
            </div>

            <button 
              type="button" 
              onClick={() => setShowCompanyModal(true)} 
              style={{ display: 'flex', alignItems: 'center', gap: '6px', padding: '8px 16px', background: '#2563eb', color: '#ffffff', border: 'none', borderRadius: '8px', fontSize: '0.85rem', fontWeight: 700, cursor: 'pointer' }}
            >
              <Plus size={16} /> Add Partner Recruiter
            </button>
          </div>

          <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fit, minmax(360px, 1fr))', gap: '18px' }}>
            {companies
              .filter(c => (c.name || '').toLowerCase().includes(search.toLowerCase()) || (c.sector || '').toLowerCase().includes(search.toLowerCase()))
              .map((comp, idx) => {
                const compJobs = jobs.filter(j => (j.company || '').trim().toLowerCase() === (comp.name || '').trim().toLowerCase());
                const initials = (comp.name || 'CP').slice(0, 2).toUpperCase();
                return (
                  <div key={comp._id || comp.companyId || idx} style={{
                    background: 'var(--bg-card, #ffffff)',
                    borderRadius: '16px',
                    border: '1px solid var(--border-color, #e2e8f0)',
                    padding: '22px',
                    boxShadow: '0 4px 12px -2px rgba(15, 23, 42, 0.04)',
                    display: 'flex',
                    flexDirection: 'column',
                    justifyContent: 'space-between',
                    gap: '16px',
                    transition: 'transform 0.2s ease, box-shadow 0.2s ease'
                  }}>
                    <div>
                      {/* Card Header with Logo Avatar */}
                      <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'flex-start', gap: '12px', marginBottom: '12px' }}>
                        <div style={{ display: 'flex', alignItems: 'center', gap: '12px' }}>
                          <div style={{
                            width: '44px',
                            height: '44px',
                            borderRadius: '12px',
                            background: 'linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%)',
                            color: '#ffffff',
                            display: 'flex',
                            alignItems: 'center',
                            justifyContent: 'center',
                            fontWeight: 800,
                            fontSize: '1.1rem',
                            letterSpacing: '0.5px',
                            boxShadow: '0 4px 10px rgba(37,99,235,0.2)'
                          }}>
                            {initials}
                          </div>
                          <div>
                            <h3 style={{ margin: 0, fontSize: '1.2rem', fontWeight: 800, color: 'var(--text-main, #0f172a)', letterSpacing: '-0.01em' }}>
                              {comp.name}
                            </h3>
                            <span style={{ fontSize: '0.78rem', fontWeight: 700, color: '#2563eb' }}>
                              {comp.sector || 'Technology & IT Services'}
                            </span>
                          </div>
                        </div>

                        <span style={{
                          fontSize: '0.72rem',
                          fontWeight: 800,
                          padding: '4px 10px',
                          borderRadius: '20px',
                          background: '#dcfce7',
                          color: '#15803d',
                          border: '1px solid #bbf7d0',
                          display: 'flex',
                          alignItems: 'center',
                          gap: '4px'
                        }}>
                          <CheckCircle2 size={12} /> Partnered
                        </span>
                      </div>

                      {/* Contact & Location Metadata */}
                      <div style={{ display: 'flex', flexDirection: 'column', gap: '6px', fontSize: '0.82rem', color: 'var(--text-muted, #64748b)', padding: '10px 12px', background: 'var(--bg-secondary, #f8fafc)', borderRadius: '10px', border: '1px solid #f1f5f9' }}>
                        <div style={{ display: 'flex', alignItems: 'center', gap: '7px' }}>
                          <MapPin size={14} color="#64748b" /> <span>{comp.location || 'Pan India'}</span>
                        </div>
                        {comp.hrName && (
                          <div style={{ display: 'flex', alignItems: 'center', gap: '7px' }}>
                            <Users size={14} color="#64748b" /> <span>HR: <strong>{comp.hrName}</strong> {comp.hrContact ? `(${comp.hrContact})` : ''}</span>
                          </div>
                        )}
                        {comp.hrEmail && (
                          <div style={{ display: 'flex', alignItems: 'center', gap: '7px' }}>
                            <Mail size={14} color="#64748b" /> <span style={{ color: '#2563eb' }}>{comp.hrEmail}</span>
                          </div>
                        )}
                      </div>

                      {/* Active Recruitment Drives */}
                      <div style={{ marginTop: '14px', background: '#ffffff', border: '1px solid var(--border-color, #e2e8f0)', borderRadius: '12px', padding: '12px' }}>
                        <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: '8px' }}>
                          <span style={{ fontSize: '0.74rem', fontWeight: 800, color: '#1e293b', textTransform: 'uppercase', letterSpacing: '0.5px' }}>
                            Campus Recruitment Drives ({compJobs.length})
                          </span>
                          <span style={{ fontSize: '0.72rem', fontWeight: 700, padding: '2px 8px', borderRadius: '6px', background: compJobs.length > 0 ? '#dbeafe' : '#f1f5f9', color: compJobs.length > 0 ? '#1d4ed8' : '#64748b' }}>
                            {compJobs.length > 0 ? `${compJobs.length} Active` : 'None Open'}
                          </span>
                        </div>

                        {compJobs.length > 0 ? (
                          <div style={{ display: 'flex', flexDirection: 'column', gap: '8px' }}>
                            {compJobs.map((j, jIdx) => (
                              <div key={j._id || j.jobId || jIdx} style={{ background: '#f8fafc', padding: '10px 12px', borderRadius: '9px', border: '1px solid #e2e8f0', display: 'flex', justifyContent: 'space-between', alignItems: 'center', gap: '8px' }}>
                                <div style={{ overflow: 'hidden' }}>
                                  <div style={{ fontWeight: 800, fontSize: '0.85rem', color: '#0f172a', display: 'flex', alignItems: 'center', gap: '6px' }}>
                                    <Briefcase size={13} color="#2563eb" /> {j.role}
                                    <span style={{ fontSize: '0.72rem', fontWeight: 800, color: '#15803d', background: '#dcfce7', padding: '2px 7px', borderRadius: '6px', border: '1px solid #bbf7d0' }}>
                                      {j.ctc}
                                    </span>
                                  </div>
                                  <div style={{ fontSize: '0.72rem', color: '#64748b', marginTop: '3px' }}>
                                    Min CGPA: {j.minCgpa ?? 'N/A'} • Max Arrears: {j.maxArrears ?? 0} • Deadline: {j.deadline ? new Date(j.deadline).toLocaleDateString() : 'Open'}
                                  </div>
                                </div>
                                <div style={{ display: 'flex', alignItems: 'center', gap: '5px', flexShrink: 0 }}>
                                  <button
                                    type="button"
                                    onClick={() => {
                                      setSelectedEligibleJob(j._id || j.jobId || j.id);
                                      handleTabClick('Eligibility Tracker');
                                    }}
                                    style={{ padding: '5px 10px', background: '#eff6ff', border: '1px solid #bfdbfe', borderRadius: '7px', color: '#2563eb', fontWeight: 700, fontSize: '0.72rem', cursor: 'pointer' }}
                                    title="Check Eligible Students"
                                  >
                                    Eligible →
                                  </button>
                                  <button
                                    type="button"
                                    onClick={() => handleDeleteJob(j._id || j.jobId || j.id, comp.name, j.role)}
                                    style={{ padding: '5px 8px', background: '#fee2e2', border: '1px solid #fecaca', borderRadius: '7px', color: '#dc2626', cursor: 'pointer' }}
                                    title="Delete this drive"
                                  >
                                    <Trash2 size={13} />
                                  </button>
                                </div>
                              </div>
                            ))}
                          </div>
                        ) : (
                          <div style={{ fontSize: '0.75rem', color: '#94a3b8', fontStyle: 'italic', textAlign: 'center', padding: '8px 0' }}>
                            No active drives scheduled yet. Click "Schedule Drive" below.
                          </div>
                        )}
                      </div>
                    </div>

                    {/* Card Actions Footer */}
                    <div style={{ borderTop: '1px solid var(--border-color, #f1f5f9)', paddingTop: '14px', display: 'flex', justifyContent: 'space-between', alignItems: 'center', gap: '8px' }}>
                      <button 
                        type="button" 
                        onClick={() => handleDeleteCompany(comp._id || comp.companyId, comp.name)}
                        style={{ padding: '7px 12px', background: '#fee2e2', border: '1px solid #fecaca', borderRadius: '8px', color: '#dc2626', fontWeight: 700, fontSize: '0.76rem', cursor: 'pointer', display: 'flex', alignItems: 'center', gap: '5px' }}
                      >
                        <Trash2 size={13} /> Delete Company
                      </button>

                      <button 
                        type="button" 
                        onClick={() => {
                          setJobForm(prev => ({ ...prev, company: comp.name }));
                          setShowJobModal(true);
                        }}
                        style={{ padding: '7px 16px', background: 'linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%)', border: 'none', borderRadius: '8px', color: '#ffffff', fontWeight: 700, fontSize: '0.8rem', cursor: 'pointer', display: 'flex', alignItems: 'center', gap: '6px', boxShadow: '0 2px 6px rgba(37,99,235,0.25)' }}
                      >
                        <Plus size={14} /> Schedule Drive
                      </button>
                    </div>
                  </div>
                );
              })}
            {companies.length === 0 && (
              <div style={{ gridColumn: '1 / -1', padding: '3.5rem', textAlign: 'center', background: 'var(--bg-card, #ffffff)', borderRadius: '14px', border: '1px solid var(--border-color, #e2e8f0)', color: 'var(--text-muted)' }}>
                No corporate partner recruiters registered yet. Click "Add Partner Recruiter" to add companies.
              </div>
            )}
          </div>

        </div>
      )}

      {/* 3. JOB OPENINGS & DRIVES */}
      {activeTab === 'Job Openings' && (
        <div style={{ display: 'flex', flexDirection: 'column', gap: '16px' }}>
          
          <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', flexWrap: 'wrap', gap: '12px' }}>
            <div style={{ display: 'flex', alignItems: 'center', width: '280px', background: 'var(--bg-card, #ffffff)', border: '1px solid var(--border-color, #cbd5e1)', borderRadius: '8px', padding: '0 10px' }}>
              <Search size={15} style={{ color: 'var(--text-muted)', flexShrink: 0 }} />
              <input 
                value={search} 
                onChange={e => setSearch(e.target.value)} 
                placeholder="Search job drives..." 
                style={{ border: 'none', background: 'transparent', outline: 'none', padding: '8px 8px', fontSize: '0.82rem', width: '100%', color: 'var(--text-main, #0f172a)' }} 
              />
            </div>

            <button 
              type="button" 
              onClick={() => setShowJobModal(true)} 
              style={{ display: 'flex', alignItems: 'center', gap: '6px', padding: '8px 16px', background: '#2563eb', color: '#ffffff', border: 'none', borderRadius: '8px', fontSize: '0.85rem', fontWeight: 700, cursor: 'pointer' }}
            >
              <Plus size={16} /> Post New Campus Drive
            </button>
          </div>

          <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fit, minmax(340px, 1fr))', gap: '16px' }}>
            {jobs
              .filter(j => (j.company || '').toLowerCase().includes(search.toLowerCase()) || (j.role || '').toLowerCase().includes(search.toLowerCase()))
              .map((job, idx) => {
                const jobApps = applications.filter(a => 
                  (a.jobId && (a.jobId === job._id || a.jobId === job.jobId || a.jobId === job.id)) ||
                  (String(a.company || '').toLowerCase() === String(job.company || '').toLowerCase() && String(a.role || '').toLowerCase() === String(job.role || '').toLowerCase())
                );

                return (
                  <div key={job._id || job.jobId || idx} style={{ background: 'var(--bg-card, #ffffff)', borderRadius: '14px', border: '1px solid var(--border-color, #e2e8f0)', padding: '20px', boxShadow: '0 2px 6px rgba(0,0,0,0.02)', display: 'flex', flexDirection: 'column', justifyContent: 'space-between', gap: '14px' }}>
                    <div>
                      <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: '8px' }}>
                        <span style={{ fontSize: '0.82rem', fontWeight: 800, padding: '3px 10px', borderRadius: '6px', background: '#dcfce7', color: '#15803d' }}>
                          💰 {job.ctc || 'Not Disclosed'}
                        </span>
                        <span style={{ fontSize: '0.72rem', fontWeight: 700, padding: '3px 8px', borderRadius: '6px', background: '#eff6ff', color: '#2563eb' }}>
                          {job.status || 'Active Drive'}
                        </span>
                      </div>

                      <h3 style={{ margin: '0 0 2px 0', fontSize: '1.2rem', fontWeight: 800, color: 'var(--text-main, #0f172a)' }}>
                        {job.role}
                      </h3>

                      <div style={{ display: 'flex', alignItems: 'center', gap: '6px', fontSize: '0.9rem', fontWeight: 700, color: '#2563eb', marginBottom: '10px' }}>
                        <Building size={15} />
                        <span>{job.company}</span>
                      </div>

                      <div style={{ fontSize: '0.78rem', color: 'var(--text-muted, #64748b)', background: 'var(--bg-secondary, #f8fafc)', padding: '10px 12px', borderRadius: '8px', margin: '8px 0', display: 'flex', flexDirection: 'column', gap: '4px' }}>
                        <div style={{ display: 'flex', justifyContent: 'space-between' }}>
                          <span>Min CGPA Cutoff:</span>
                          <strong style={{ color: '#0f172a' }}>{job.minCgpa ?? 'None'}</strong>
                        </div>
                        <div style={{ display: 'flex', justifyContent: 'space-between' }}>
                          <span>Max Arrears Allowed:</span>
                          <strong style={{ color: '#0f172a' }}>{job.maxArrears ?? 0} Arrears</strong>
                        </div>
                        <div style={{ display: 'flex', justifyContent: 'space-between' }}>
                          <span>Eligible Departments:</span>
                          <strong style={{ color: '#0f172a' }}>{Array.isArray(job.eligibleDepartments) ? job.eligibleDepartments.join(', ') : 'All Departments'}</strong>
                        </div>
                        <div style={{ display: 'flex', justifyContent: 'space-between', borderTop: '1px solid #e2e8f0', paddingTop: '4px', marginTop: '2px' }}>
                          <span>Application Deadline:</span>
                          <strong style={{ color: '#dc2626' }}>{job.deadline ? new Date(job.deadline).toLocaleDateString() : 'Open'}</strong>
                        </div>
                      </div>

                      <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', flexWrap: 'wrap', gap: '6px', marginTop: '6px' }}>
                        <div style={{ display: 'flex', alignItems: 'center', gap: '6px', fontSize: '0.78rem', color: '#6d28d9', background: '#f5f3ff', padding: '5px 10px', borderRadius: '6px' }}>
                          <Users size={14} />
                          <span><strong>{jobApps.length}</strong> Applied</span>
                        </div>
                        <div style={{ display: 'flex', alignItems: 'center', gap: '6px', fontSize: '0.78rem', color: '#0369a1', background: '#e0f2fe', padding: '5px 10px', borderRadius: '6px', fontWeight: 700 }}>
                          <Layers size={14} />
                          <span>{job.totalRounds || (job.rounds ? job.rounds.length : 3)} Interview Rounds</span>
                        </div>
                      </div>
                    </div>

                    <div style={{ borderTop: '1px solid var(--border-color, #f1f5f9)', paddingTop: '12px', display: 'flex', justifyContent: 'space-between', alignItems: 'center', fontSize: '0.78rem', flexWrap: 'wrap', gap: '8px' }}>
                      <button 
                        type="button" 
                        onClick={() => handleDeleteJob(job._id || job.jobId || job.id, job.company, job.role)}
                        style={{ padding: '6px 12px', background: '#fee2e2', border: '1px solid #fecaca', borderRadius: '6px', color: '#dc2626', fontWeight: 700, fontSize: '0.75rem', cursor: 'pointer', display: 'flex', alignItems: 'center', gap: '4px' }}
                      >
                        <Trash2 size={13} /> Delete
                      </button>

                      <div style={{ display: 'flex', gap: '6px', flexWrap: 'wrap' }}>
                        <button
                          type="button"
                          onClick={() => {
                            setSelectedInterviewJob(job._id || job.jobId || job.id);
                            setSelectedRoundIndex(0);
                            handleTabClick('Interviews');
                          }}
                          style={{ padding: '6px 12px', background: '#f0fdf4', border: '1px solid #86efac', color: '#15803d', borderRadius: '6px', fontWeight: 700, fontSize: '0.75rem', cursor: 'pointer', display: 'flex', alignItems: 'center', gap: '4px' }}
                        >
                          <Target size={13} /> Round Evaluations →
                        </button>
                        <button 
                          type="button" 
                          onClick={() => {
                            setSelectedEligibleJob(job._id || job.jobId || job.id);
                            handleTabClick('Eligibility Tracker');
                          }}
                          style={{ padding: '6px 12px', background: '#2563eb', color: '#ffffff', border: 'none', borderRadius: '6px', fontWeight: 700, fontSize: '0.75rem', cursor: 'pointer' }}
                        >
                          Eligibility →
                        </button>
                      </div>
                    </div>
                  </div>
                );
              })}
            {jobs.length === 0 && (
              <div style={{ gridColumn: '1 / -1', padding: '3.5rem', textAlign: 'center', background: 'var(--bg-card, #ffffff)', borderRadius: '14px', border: '1px solid var(--border-color, #e2e8f0)', color: 'var(--text-muted)' }}>
                No active recruitment drives posted yet. Click "+ Post New Campus Drive" to publish jobs.
              </div>
            )}
          </div>

        </div>
      )}

      {/* 4. STUDENT APPLICATIONS */}
      {activeTab === 'Applications' && (
        <div style={{ background: 'var(--bg-card, #ffffff)', borderRadius: '14px', border: '1px solid var(--border-color, #e2e8f0)', overflow: 'hidden', boxShadow: '0 2px 6px rgba(0,0,0,0.02)' }}>
          <div style={{ padding: '16px 20px', borderBottom: '1px solid var(--border-color, #e2e8f0)', display: 'flex', justifyContent: 'space-between', alignItems: 'center', flexWrap: 'wrap', gap: '10px' }}>
            <div>
              <h3 style={{ margin: 0, fontSize: '1.05rem', fontWeight: 800, color: 'var(--text-main, #0f172a)' }}>
                Submitted Student Applications ({applications.length})
              </h3>
              <p style={{ margin: '2px 0 0', fontSize: '0.8rem', color: 'var(--text-muted)' }}>
                Filter, review candidate profiles, and manage shortlisting workflow.
              </p>
            </div>

            <div style={{ display: 'flex', gap: '10px', alignItems: 'center' }}>
              <div style={{ position: 'relative', width: '240px' }}>
                <Search size={14} style={{ position: 'absolute', left: 10, top: '50%', transform: 'translateY(-50%)', color: 'var(--text-muted)' }} />
                <input 
                  value={search} 
                  onChange={e => setSearch(e.target.value)} 
                  placeholder="Filter applicant..." 
                  style={{ padding: '6px 10px 6px 30px', borderRadius: 8, border: '1px solid var(--border-color, #cbd5e1)', background: 'var(--bg-card, #ffffff)', color: 'var(--text-main, #0f172a)', fontSize: '0.8rem', width: '100%', outline: 'none' }} 
                />
              </div>

              <button 
                type="button" 
                onClick={() => {
                  const headers = ['Register No', 'Student Name', 'Department', 'CGPA', 'Company', 'Role', 'Status'];
                  const rows = applications.map(a => [a.regNo, a.student, a.dept, a.cgpa, a.company, a.role, a.status]);
                  exportCSV('Placement_Applications_Roster', headers, rows);
                }}
                style={{ padding: '6px 12px', background: 'var(--bg-card, #ffffff)', border: '1px solid var(--border-color, #e2e8f0)', borderRadius: '8px', fontSize: '0.78rem', fontWeight: 700, cursor: 'pointer', display: 'flex', alignItems: 'center', gap: '4px' }}
              >
                <Download size={13} /> Export (.CSV)
              </button>
            </div>
          </div>

          <div style={{ overflowX: 'auto' }}>
            <table style={{ width: '100%', borderCollapse: 'collapse', fontSize: '0.85rem' }}>
              <thead>
                <tr style={{ background: 'var(--bg-secondary, #f8fafc)', borderBottom: '1px solid var(--border-color, #e2e8f0)', color: 'var(--text-muted, #64748b)', textTransform: 'uppercase', fontSize: '0.72rem', fontWeight: 700 }}>
                  <th style={{ padding: '12px 18px', textAlign: 'left' }}>Register No</th>
                  <th style={{ padding: '12px 18px', textAlign: 'left' }}>Student Name</th>
                  <th style={{ padding: '12px 18px', textAlign: 'center' }}>Department</th>
                  <th style={{ padding: '12px 18px', textAlign: 'center' }}>CGPA</th>
                  <th style={{ padding: '12px 18px', textAlign: 'left' }}>Company</th>
                  <th style={{ padding: '12px 18px', textAlign: 'left' }}>Job Role</th>
                  <th style={{ padding: '12px 18px', textAlign: 'right' }}>Application Stage</th>
                </tr>
              </thead>
              <tbody>
                {applications
                  .filter(a => {
                    const q = (search || '').toLowerCase();
                    const sName = String(a.student || a.studentName || a.name || '').toLowerCase();
                    const sComp = String(a.company || '').toLowerCase();
                    const sReg = String(a.regNo || a.registerNo || a.rollNo || '').toLowerCase();
                    const sRole = String(a.role || '').toLowerCase();
                    const sDept = String(a.dept || a.department || '').toLowerCase();
                    return sName.includes(q) || sComp.includes(q) || sReg.includes(q) || sRole.includes(q) || sDept.includes(q);
                  })
                  .map((app, idx) => (
                    <tr key={app._id || app.applicationId || idx} style={{ borderBottom: '1px solid var(--border-color, #f1f5f9)' }}>
                      <td style={{ padding: '12px 18px', fontFamily: 'monospace', fontWeight: 600, color: 'var(--text-muted)' }}>{app.regNo || app.registerNo || app.rollNo || 'N/A'}</td>
                      <td style={{ padding: '12px 18px', fontWeight: 800, color: 'var(--text-main)' }}>{app.student || app.studentName || app.name || 'Candidate'}</td>
                      <td style={{ padding: '12px 18px', textAlign: 'center', color: 'var(--text-muted)' }}>{app.dept || app.department || 'TAMIL'}</td>
                      <td style={{ padding: '12px 18px', textAlign: 'center', fontWeight: 700, color: '#2563eb' }}>{app.cgpa !== undefined && app.cgpa !== null ? app.cgpa : '0.0'}</td>
                      <td style={{ padding: '12px 18px', fontWeight: 800, color: '#2563eb' }}>{app.company}</td>
                      <td style={{ padding: '12px 18px', fontWeight: 600 }}>{app.role}</td>
                      <td style={{ padding: '12px 18px', textAlign: 'right' }}>
                        <select 
                          value={app.status || 'Applied'} 
                          onChange={(e) => handleUpdateAppStatus(app._id || app.applicationId, e.target.value)}
                          style={{ 
                            background: app.status === 'Shortlisted' ? '#fef3c7' : 
                                        app.status === 'Selected' ? '#dcfce7' : 
                                        app.status === 'Rejected' ? '#fee2e2' : '#eff6ff', 
                            color: app.status === 'Shortlisted' ? '#b45309' : 
                                   app.status === 'Selected' ? '#15803d' : 
                                   app.status === 'Rejected' ? '#dc2626' : '#2563eb', 
                            padding: '5px 10px', borderRadius: 6, fontSize: '0.78rem', fontWeight: 700, border: '1px solid var(--border-color, #e2e8f0)', outline: 'none', cursor: 'pointer'
                          }}
                        >
                          <option value="Applied">Applied</option>
                          <option value="Shortlisted">Shortlisted</option>
                          <option value="Selected">Selected</option>
                          <option value="Waitlisted">Waitlisted</option>
                          <option value="Rejected">Rejected</option>
                        </select>
                      </td>
                    </tr>
                  ))}
                {applications.length === 0 && (
                  <tr>
                    <td colSpan={7} style={{ textAlign: 'center', padding: '3rem', color: 'var(--text-muted)' }}>
                      No student applications recorded in this cycle yet.
                    </td>
                  </tr>
                )}
              </tbody>
            </table>
          </div>
        </div>
      )}

      {/* 5. ELIGIBILITY MATRIX */}
      {activeTab === 'Eligibility Tracker' && (
        <div style={{ display: 'flex', flexDirection: 'column', gap: '16px' }}>
          
          <div style={{ background: 'var(--bg-card, #ffffff)', padding: '18px 20px', borderRadius: '14px', border: '1px solid var(--border-color, #e2e8f0)', display: 'flex', justifyContent: 'space-between', alignItems: 'center', flexWrap: 'wrap', gap: '14px' }}>
            <div style={{ display: 'flex', alignItems: 'center', gap: '12px' }}>
              <label style={{ fontSize: '0.85rem', fontWeight: 800, color: 'var(--text-main)' }}>Select Active Recruitment Drive:</label>
              <select 
                value={selectedEligibleJob} 
                onChange={e => setSelectedEligibleJob(e.target.value)}
                style={{ padding: '8px 14px', borderRadius: '8px', border: '1px solid var(--border-color, #cbd5e1)', background: 'var(--bg-primary, #ffffff)', color: 'var(--text-main, #0f172a)', fontWeight: 700, fontSize: '0.85rem', outline: 'none' }}
              >
                {jobs.map(j => (
                  <option key={j._id || j.jobId || j.id} value={j._id || j.jobId || j.id}>
                    {j.company} — {j.role} ({j.ctc || 'N/A'})
                  </option>
                ))}
                {jobs.length === 0 && <option value="">No active drives available</option>}
              </select>
            </div>

            <div style={{ display: 'flex', gap: '10px' }}>
              <span style={{ fontSize: '0.8rem', fontWeight: 700, padding: '6px 12px', borderRadius: '8px', background: '#dcfce7', color: '#15803d' }}>
                {liveEligible.length} Scholars Eligible
              </span>
              <span style={{ fontSize: '0.8rem', fontWeight: 700, padding: '6px 12px', borderRadius: '8px', background: '#fee2e2', color: '#991b1b' }}>
                {liveIneligible.length} Ineligible
              </span>
            </div>
          </div>

          {/* Eligible Table */}
          <div style={{ background: 'var(--bg-card, #ffffff)', borderRadius: '14px', border: '1px solid var(--border-color, #e2e8f0)', overflow: 'hidden', boxShadow: '0 2px 6px rgba(0,0,0,0.02)' }}>
            <div style={{ padding: '14px 20px', borderBottom: '1px solid var(--border-color, #e2e8f0)', background: 'rgba(22, 163, 74, 0.05)', display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
              <h3 style={{ margin: 0, fontSize: '1rem', fontWeight: 800, color: '#15803d' }}>
                ✓ Eligible Candidates ({liveEligible.length})
              </h3>
              <button 
                type="button" 
                onClick={() => showToast(`Notified ${liveEligible.length} eligible students via email & portal!`)}
                style={{ padding: '5px 12px', background: '#16a34a', color: '#ffffff', border: 'none', borderRadius: '6px', fontWeight: 700, fontSize: '0.75rem', cursor: 'pointer' }}
              >
                Notify Eligible Scholars
              </button>
            </div>

            <div style={{ overflowX: 'auto' }}>
              <table style={{ width: '100%', borderCollapse: 'collapse', fontSize: '0.85rem' }}>
                <thead>
                  <tr style={{ background: 'var(--bg-secondary, #f8fafc)', borderBottom: '1px solid var(--border-color, #e2e8f0)', color: 'var(--text-muted, #64748b)', textTransform: 'uppercase', fontSize: '0.72rem', fontWeight: 700 }}>
                    <th style={{ padding: '12px 18px', textAlign: 'left' }}>Register No</th>
                    <th style={{ padding: '12px 18px', textAlign: 'left' }}>Student Name</th>
                    <th style={{ padding: '12px 18px', textAlign: 'center' }}>Department</th>
                    <th style={{ padding: '12px 18px', textAlign: 'center' }}>Live CGPA</th>
                    <th style={{ padding: '12px 18px', textAlign: 'center' }}>Arrears</th>
                    <th style={{ padding: '12px 18px', textAlign: 'center' }}>Attendance</th>
                    <th style={{ padding: '12px 18px', textAlign: 'right' }}>Status</th>
                  </tr>
                </thead>
                <tbody>
                  {liveEligible.map(st => (
                    <tr key={st.id || st.rollNo} style={{ borderBottom: '1px solid var(--border-color, #f1f5f9)' }}>
                      <td style={{ padding: '12px 18px', fontFamily: 'monospace', fontWeight: 600, color: 'var(--text-muted)' }}>{st.id || st.rollNo}</td>
                      <td style={{ padding: '12px 18px', fontWeight: 800, color: 'var(--text-main)' }}>{st.name}</td>
                      <td style={{ padding: '12px 18px', textAlign: 'center', color: 'var(--text-muted)' }}>{st.dept || 'TAMIL'}</td>
                      <td style={{ padding: '12px 18px', textAlign: 'center', fontWeight: 800, color: '#2563eb' }}>{st.cgpa ?? 'N/A'}</td>
                      <td style={{ padding: '12px 18px', textAlign: 'center', fontWeight: 700, color: '#15803d' }}>{st.arrears ?? '0'}</td>
                      <td style={{ padding: '12px 18px', textAlign: 'center', fontWeight: 600, color: '#15803d' }}>{st.attendance || '100%'}</td>
                      <td style={{ padding: '12px 18px', textAlign: 'right' }}>
                        <span style={{ padding: '4px 10px', borderRadius: '6px', background: '#dcfce7', color: '#15803d', fontWeight: 800, fontSize: '0.75rem' }}>
                          ✓ Qualified
                        </span>
                      </td>
                    </tr>
                  ))}
                  {liveEligible.length === 0 && (
                    <tr>
                      <td colSpan={7} style={{ textAlign: 'center', padding: '2.5rem', color: 'var(--text-muted)' }}>
                        No candidates currently meet all cutoff criteria for this drive.
                      </td>
                    </tr>
                  )}
                </tbody>
              </table>
            </div>
          </div>

          {/* Ineligible Table */}
          {liveIneligible.length > 0 && (
            <div style={{ background: 'var(--bg-card, #ffffff)', borderRadius: '14px', border: '1px solid var(--border-color, #e2e8f0)', overflow: 'hidden', boxShadow: '0 2px 6px rgba(0,0,0,0.02)' }}>
              <div style={{ padding: '14px 20px', borderBottom: '1px solid var(--border-color, #e2e8f0)', background: 'rgba(239, 68, 68, 0.05)' }}>
                <h3 style={{ margin: 0, fontSize: '1rem', fontWeight: 800, color: '#dc2626' }}>
                  ❌ Criteria Pending / Ineligible Candidates ({liveIneligible.length})
                </h3>
              </div>

              <div style={{ overflowX: 'auto' }}>
                <table style={{ width: '100%', borderCollapse: 'collapse', fontSize: '0.85rem' }}>
                  <thead>
                    <tr style={{ background: 'var(--bg-secondary, #f8fafc)', borderBottom: '1px solid var(--border-color, #e2e8f0)', color: 'var(--text-muted, #64748b)', textTransform: 'uppercase', fontSize: '0.72rem', fontWeight: 700 }}>
                      <th style={{ padding: '12px 18px', textAlign: 'left' }}>Register No</th>
                      <th style={{ padding: '12px 18px', textAlign: 'left' }}>Student Name</th>
                      <th style={{ padding: '12px 18px', textAlign: 'center' }}>Department</th>
                      <th style={{ padding: '12px 18px', textAlign: 'center' }}>CGPA</th>
                      <th style={{ padding: '12px 18px', textAlign: 'left' }}>Ineligibility Reason</th>
                    </tr>
                  </thead>
                  <tbody>
                    {liveIneligible.map(st => (
                      <tr key={st.id || st.rollNo} style={{ borderBottom: '1px solid var(--border-color, #f1f5f9)' }}>
                        <td style={{ padding: '12px 18px', fontFamily: 'monospace', fontWeight: 600, color: 'var(--text-muted)' }}>{st.id || st.rollNo}</td>
                        <td style={{ padding: '12px 18px', fontWeight: 700, color: 'var(--text-main)' }}>{st.name}</td>
                        <td style={{ padding: '12px 18px', textAlign: 'center', color: 'var(--text-muted)' }}>{st.dept || 'TAMIL'}</td>
                        <td style={{ padding: '12px 18px', textAlign: 'center', fontWeight: 700, color: '#dc2626' }}>{st.cgpa ?? '0.0'}</td>
                        <td style={{ padding: '12px 18px', color: '#dc2626', fontWeight: 600 }}>{st.reason}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>
          )}
        </div>
      )}

      {/* 6. INTERVIEWS & ROUND-BY-ROUND EVALUATIONS */}
      {activeTab === 'Interviews' && (
        <div style={{ display: 'flex', flexDirection: 'column', gap: '20px' }}>
          
          {/* ── UNIFIED ENTERPRISE RECRUITMENT CONTROL CARD ── */}
          <div style={{ 
            background: 'var(--bg-card, #ffffff)', 
            borderRadius: '16px', 
            border: '1px solid var(--border-color, #e2e8f0)', 
            boxShadow: '0 2px 10px rgba(0,0,0,0.03)',
            overflow: 'hidden'
          }}>
            {/* Top Row: Drive Selector & Primary Actions */}
            <div style={{ 
              padding: '18px 24px', 
              background: 'linear-gradient(180deg, #f8fafc 0%, #ffffff 100%)', 
              borderBottom: '1px solid var(--border-color, #e2e8f0)',
              display: 'flex', 
              justifyContent: 'space-between', 
              alignItems: 'center', 
              flexWrap: 'wrap', 
              gap: '16px' 
            }}>
              <div style={{ display: 'flex', alignItems: 'center', gap: '14px', flexWrap: 'wrap' }}>
                <div style={{ 
                  width: '42px', 
                  height: '42px', 
                  borderRadius: '12px', 
                  background: 'linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%)', 
                  color: '#ffffff', 
                  display: 'flex', 
                  alignItems: 'center', 
                  justifyContent: 'center',
                  boxShadow: '0 3px 8px rgba(37,99,235,0.25)'
                }}>
                  <Briefcase size={20} />
                </div>
                <div>
                  <div style={{ fontSize: '0.7rem', fontWeight: 800, color: '#64748b', textTransform: 'uppercase', letterSpacing: '0.05em' }}>
                    Active Recruitment Drive
                  </div>
                  <select 
                    value={selectedInterviewJob} 
                    onChange={e => {
                      setSelectedInterviewJob(e.target.value);
                      setSelectedRoundIndex(0);
                    }}
                    style={{ 
                      marginTop: '2px',
                      padding: '7px 14px', 
                      borderRadius: '8px', 
                      border: '1.5px solid #cbd5e1', 
                      background: '#ffffff', 
                      color: '#0f172a', 
                      fontWeight: 700, 
                      fontSize: '0.92rem', 
                      outline: 'none', 
                      cursor: 'pointer', 
                      minWidth: '320px',
                      boxShadow: '0 1px 2px rgba(0,0,0,0.05)'
                    }}
                  >
                    {jobs.map(j => (
                      <option key={j._id || j.jobId || j.id} value={j._id || j.jobId || j.id}>
                        {j.company} — {j.role} ({j.ctc || 'N/A'})
                      </option>
                    ))}
                    {jobs.length === 0 && <option value="">No recruitment drives posted</option>}
                  </select>
                </div>
              </div>

              <div style={{ display: 'flex', gap: '10px', alignItems: 'center', flexWrap: 'wrap' }}>
                {currentInterviewJob && currentJobApplications.length === 0 && (
                  <button
                    type="button"
                    onClick={() => handleBulkEnrollEligibleStudents(currentInterviewJob)}
                    style={{ 
                      display: 'flex', 
                      alignItems: 'center', 
                      gap: '7px', 
                      padding: '9px 16px', 
                      background: '#fef3c7', 
                      color: '#92400e', 
                      border: '1px solid #fde68a', 
                      borderRadius: '8px', 
                      fontSize: '0.84rem', 
                      fontWeight: 700, 
                      cursor: 'pointer',
                      transition: 'all 0.15s ease'
                    }}
                  >
                    <Zap size={16} /> Auto-Enroll Eligible Scholars ({liveEligible.length})
                  </button>
                )}
                <button 
                  type="button" 
                  onClick={() => {
                    if (currentInterviewJob) {
                      setInterviewForm(prev => ({
                        ...prev,
                        company: currentInterviewJob.company,
                        role: currentInterviewJob.role,
                        round: currentJobRounds[selectedRoundIndex]?.name || `Round ${selectedRoundIndex + 1}`
                      }));
                    }
                    setShowInterviewModal(true);
                  }} 
                  style={{ 
                    display: 'flex', 
                    alignItems: 'center', 
                    gap: '7px', 
                    padding: '9px 18px', 
                    background: '#2563eb', 
                    color: '#ffffff', 
                    border: 'none', 
                    borderRadius: '8px', 
                    fontSize: '0.84rem', 
                    fontWeight: 700, 
                    cursor: 'pointer',
                    boxShadow: '0 2px 6px rgba(37,99,235,0.25)',
                    transition: 'all 0.15s ease'
                  }}
                >
                  <Plus size={16} /> Schedule Interview Session
                </button>
              </div>
            </div>

            {/* Bottom Row: Role, Eligibility Specs & Live KPI Counters */}
            {currentInterviewJob && (
              <div style={{ 
                padding: '16px 24px', 
                display: 'flex', 
                justifyContent: 'space-between', 
                alignItems: 'center', 
                flexWrap: 'wrap', 
                gap: '16px',
                background: '#ffffff'
              }}>
                <div>
                  <div style={{ display: 'flex', alignItems: 'center', gap: '8px', flexWrap: 'wrap', marginBottom: '6px' }}>
                    <span style={{ 
                      padding: '3px 10px', 
                      borderRadius: '6px', 
                      background: '#eff6ff', 
                      color: '#1e40af', 
                      fontSize: '0.78rem', 
                      fontWeight: 800, 
                      border: '1px solid #bfdbfe' 
                    }}>
                      🏢 {currentInterviewJob.company}
                    </span>
                    <span style={{ 
                      padding: '3px 10px', 
                      borderRadius: '6px', 
                      background: '#ecfdf5', 
                      color: '#065f46', 
                      fontSize: '0.78rem', 
                      fontWeight: 800, 
                      border: '1px solid #a7f3d0' 
                    }}>
                      💼 {currentInterviewJob.ctc || 'Negotiable'}
                    </span>
                    <span style={{ 
                      padding: '3px 10px', 
                      borderRadius: '6px', 
                      background: '#f8fafc', 
                      color: '#475569', 
                      fontSize: '0.78rem', 
                      fontWeight: 700, 
                      border: '1px solid #e2e8f0' 
                    }}>
                      🎯 {currentJobRounds.length} Total Rounds
                    </span>
                  </div>
                  <h2 style={{ margin: '4px 0', fontSize: '1.25rem', fontWeight: 800, color: '#0f172a' }}>
                    {currentInterviewJob.role}
                  </h2>
                  <div style={{ fontSize: '0.8rem', color: '#64748b', display: 'flex', gap: '12px', flexWrap: 'wrap', marginTop: '4px' }}>
                    <span>Min CGPA: <strong style={{ color: '#0f172a' }}>{currentInterviewJob.minCgpa ?? 'None'}</strong></span>
                    <span>•</span>
                    <span>Max Arrears: <strong style={{ color: '#0f172a' }}>{currentInterviewJob.maxArrears ?? 0}</strong></span>
                    <span>•</span>
                    <span>Eligible Depts: <strong style={{ color: '#0f172a' }}>{Array.isArray(currentInterviewJob.eligibleDepartments) ? currentInterviewJob.eligibleDepartments.join(', ') : 'ALL'}</strong></span>
                  </div>
                </div>

                <div style={{ display: 'flex', gap: '14px', alignItems: 'center' }}>
                  <div style={{ 
                    textAlign: 'center', 
                    background: '#f8fafc', 
                    border: '1px solid #e2e8f0', 
                    padding: '10px 20px', 
                    borderRadius: '10px',
                    minWidth: '110px'
                  }}>
                    <div style={{ fontSize: '1.5rem', fontWeight: 800, color: '#2563eb' }}>
                      {currentJobApplications.length}
                    </div>
                    <div style={{ fontSize: '0.72rem', color: '#64748b', fontWeight: 700, textTransform: 'uppercase' }}>
                      Total Applied
                    </div>
                  </div>

                  <div style={{ 
                    textAlign: 'center', 
                    background: '#ecfdf5', 
                    border: '1px solid #a7f3d0', 
                    padding: '10px 20px', 
                    borderRadius: '10px',
                    minWidth: '110px'
                  }}>
                    <div style={{ fontSize: '1.5rem', fontWeight: 800, color: '#059669' }}>
                      {currentJobApplications.filter(a => a.status === 'Selected').length}
                    </div>
                    <div style={{ fontSize: '0.72rem', color: '#065f46', fontWeight: 700, textTransform: 'uppercase' }}>
                      Offers Issued
                    </div>
                  </div>
                </div>
              </div>
            )}
          </div>

          {/* ── REFINED PIPELINE STEPPER & CANDIDATE EVALUATION ── */}
          {currentInterviewJob && (
            <div style={{ display: 'flex', flexDirection: 'column', gap: '16px' }}>
              
              {/* Stepper / Round Tabs */}
              <div style={{ 
                display: 'flex', 
                gap: '12px', 
                overflowX: 'auto', 
                padding: '4px 2px 8px',
                scrollbarWidth: 'none'
              }}>
                {currentJobRounds.map((rnd, idx) => {
                  const isSelected = selectedRoundIndex === idx;
                  const roundName = rnd.name || `Round ${idx + 1}`;
                  
                  // Compute candidates currently at or qualified in this round
                  let candidateCount = 0;
                  if (idx === 0) {
                    candidateCount = currentJobApplications.length;
                  } else {
                    const prevRoundName = currentJobRounds[idx - 1]?.name || `Round ${idx}`;
                    candidateCount = currentJobApplications.filter(a => {
                      const prevEval = a.roundEvaluations?.[prevRoundName];
                      return prevEval?.status === 'Qualified' || prevEval?.status === 'Selected' || (a.currentRound || 1) > idx;
                    }).length;
                  }

                  return (
                    <button
                      key={idx}
                      type="button"
                      onClick={() => setSelectedRoundIndex(idx)}
                      style={{
                        padding: '12px 18px',
                        borderRadius: '12px',
                        border: isSelected ? '2px solid #2563eb' : '1px solid #e2e8f0',
                        background: isSelected ? '#ffffff' : '#f8fafc',
                        color: isSelected ? '#1e40af' : '#475569',
                        cursor: 'pointer',
                        display: 'flex',
                        alignItems: 'center',
                        gap: '12px',
                        minWidth: '240px',
                        boxShadow: isSelected ? '0 4px 12px rgba(37,99,235,0.1)' : 'none',
                        transition: 'all 0.15s ease',
                        textAlign: 'left'
                      }}
                    >
                      <div style={{
                        width: '32px', 
                        height: '32px', 
                        borderRadius: '10px',
                        background: isSelected ? '#2563eb' : '#e2e8f0',
                        color: isSelected ? '#ffffff' : '#64748b',
                        display: 'flex', 
                        alignItems: 'center', 
                        justifyContent: 'center',
                        fontWeight: 800, 
                        fontSize: '0.85rem'
                      }}>
                        {idx + 1}
                      </div>
                      <div style={{ flex: 1 }}>
                        <div style={{ fontSize: '0.86rem', fontWeight: 800, color: isSelected ? '#0f172a' : '#334155' }}>
                          {rnd.name || `Round ${idx + 1}`}
                        </div>
                        <div style={{ fontSize: '0.72rem', color: '#64748b', marginTop: '2px' }}>
                          {rnd.type || 'Assessment'} • <strong style={{ color: isSelected ? '#2563eb' : '#475569' }}>{candidateCount} Candidates</strong>
                        </div>
                      </div>
                    </button>
                  );
                })}
              </div>

              {/* ACTIVE ROUND CANDIDATE EVALUATION ROSTER & FORM */}
              {(() => {
                const activeRound = currentJobRounds[selectedRoundIndex] || { name: `Round ${selectedRoundIndex + 1}`, type: 'Technical' };
                const prevRound = selectedRoundIndex > 0 ? currentJobRounds[selectedRoundIndex - 1]?.name : null;

                // Candidates for this round
                const roundCandidates = selectedRoundIndex === 0
                  ? currentJobApplications
                  : currentJobApplications.filter(a => {
                      const prevEval = a.roundEvaluations?.[prevRound];
                      return prevEval?.status === 'Qualified' || prevEval?.status === 'Selected' || (a.currentRound || 1) > selectedRoundIndex;
                    });

                const qualifiedCount = roundCandidates.filter(a => a.roundEvaluations?.[activeRound.name]?.status === 'Qualified').length;
                const selectedCount = roundCandidates.filter(a => a.roundEvaluations?.[activeRound.name]?.status === 'Selected').length;
                const rejectedCount = roundCandidates.filter(a => a.roundEvaluations?.[activeRound.name]?.status === 'Rejected').length;

                return (
                  <div style={{ 
                    background: 'var(--bg-card, #ffffff)', 
                    borderRadius: '16px', 
                    border: '1px solid var(--border-color, #e2e8f0)', 
                    overflow: 'hidden', 
                    boxShadow: '0 2px 10px rgba(0,0,0,0.03)' 
                  }}>
                    
                    {/* Round Header & Metrics */}
                    <div style={{ 
                      padding: '16px 22px', 
                      borderBottom: '1px solid var(--border-color, #e2e8f0)', 
                      background: '#f8fafc', 
                      display: 'flex', 
                      justifyContent: 'space-between', 
                      alignItems: 'center', 
                      flexWrap: 'wrap', 
                      gap: '14px' 
                    }}>
                      <div>
                        <div style={{ display: 'flex', alignItems: 'center', gap: '8px' }}>
                          <span style={{ fontSize: '0.72rem', fontWeight: 800, padding: '3px 8px', borderRadius: '6px', background: '#2563eb', color: '#ffffff' }}>
                            Round {selectedRoundIndex + 1} of {currentJobRounds.length}
                          </span>
                          <h3 style={{ margin: 0, fontSize: '1.05rem', fontWeight: 800, color: '#0f172a' }}>
                            {activeRound.name}
                          </h3>
                        </div>
                        <p style={{ margin: '3px 0 0 0', fontSize: '0.8rem', color: '#64748b' }}>
                          {selectedRoundIndex === 0 
                            ? 'All student applicants enrolled in the primary assessment stage.' 
                            : `Candidates qualified and advanced from ${prevRound || 'previous round'}.`}
                        </p>
                      </div>

                      {/* 4 Clean Round KPIs */}
                      <div style={{ display: 'flex', gap: '8px', flexWrap: 'wrap' }}>
                        <span style={{ padding: '5px 12px', borderRadius: '8px', background: '#eff6ff', color: '#1e40af', fontSize: '0.78rem', fontWeight: 700, border: '1px solid #bfdbfe' }}>
                          Total: <strong>{roundCandidates.length}</strong>
                        </span>
                        <span style={{ padding: '5px 12px', borderRadius: '8px', background: '#ecfdf5', color: '#065f46', fontSize: '0.78rem', fontWeight: 700, border: '1px solid #a7f3d0' }}>
                          Qualified: <strong>{qualifiedCount}</strong>
                        </span>
                        <span style={{ padding: '5px 12px', borderRadius: '8px', background: '#fffbeb', color: '#92400e', fontSize: '0.78rem', fontWeight: 700, border: '1px solid #fde68a' }}>
                          Selected: <strong>{selectedCount}</strong>
                        </span>
                        <span style={{ padding: '5px 12px', borderRadius: '8px', background: '#fef2f2', color: '#991b1b', fontSize: '0.78rem', fontWeight: 700, border: '1px solid #fecaca' }}>
                          Rejected: <strong>{rejectedCount}</strong>
                        </span>
                      </div>
                    </div>

                    {/* Round Actions Bar */}
                    <div style={{ 
                      padding: '12px 22px', 
                      borderBottom: '1px solid var(--border-color, #e2e8f0)', 
                      display: 'flex', 
                      justifyContent: 'space-between', 
                      alignItems: 'center', 
                      flexWrap: 'wrap', 
                      gap: '12px',
                      background: '#ffffff'
                    }}>
                      <div style={{ position: 'relative', width: '280px' }}>
                        <Search size={15} style={{ position: 'absolute', left: 12, top: '50%', transform: 'translateY(-50%)', color: '#94a3b8' }} />
                        <input 
                          value={search} 
                          onChange={e => setSearch(e.target.value)} 
                          placeholder="Filter candidates by name, reg no, dept..." 
                          style={{ 
                            padding: '7px 12px 7px 34px', 
                            borderRadius: '8px', 
                            border: '1px solid #cbd5e1', 
                            background: '#f8fafc', 
                            color: '#0f172a', 
                            fontSize: '0.82rem', 
                            width: '100%', 
                            outline: 'none' 
                          }} 
                        />
                      </div>

                      <div style={{ display: 'flex', gap: '10px', alignItems: 'center' }}>
                        <button
                          type="button"
                          onClick={() => {
                            const headers = ['Register No', 'Student Name', 'Department', 'CGPA', 'Round Name', 'Round Status', 'Evaluation Notes'];
                            const rows = roundCandidates.map(a => {
                              const rData = a.roundEvaluations?.[activeRound.name] || {};
                              return [
                                a.regNo || a.studentId,
                                a.student || a.name,
                                a.dept || 'General',
                                a.cgpa || 0,
                                activeRound.name,
                                rData.status || a.status || 'Pending',
                                rData.notes || ''
                              ];
                            });
                            exportCSV(`Evaluation_${activeRound.name.replace(/\s+/g, '_')}`, headers, rows);
                          }}
                          style={{ 
                            padding: '7px 14px', 
                            background: '#ffffff', 
                            border: '1px solid #cbd5e1', 
                            borderRadius: '8px', 
                            fontSize: '0.8rem', 
                            fontWeight: 700, 
                            color: '#334155',
                            cursor: 'pointer', 
                            display: 'flex', 
                            alignItems: 'center', 
                            gap: '6px' 
                          }}
                        >
                          <Download size={14} /> Export CSV
                        </button>

                        <button
                          type="button"
                          onClick={() => showToast(`Dispatched alert to ${roundCandidates.length} scholars for ${activeRound.name}!`)}
                          style={{ 
                            padding: '7px 14px', 
                            background: '#eff6ff', 
                            border: '1px solid #bfdbfe', 
                            borderRadius: '8px', 
                            color: '#2563eb', 
                            fontSize: '0.8rem', 
                            fontWeight: 700, 
                            cursor: 'pointer' 
                          }}
                        >
                          Notify Candidates
                        </button>
                      </div>
                    </div>

                    {/* Candidate Evaluation Table */}
                    <div style={{ overflowX: 'auto' }}>
                      <table style={{ width: '100%', borderCollapse: 'collapse', fontSize: '0.85rem' }}>
                        <thead>
                          <tr style={{ 
                            background: '#f8fafc', 
                            borderBottom: '1.5px solid #e2e8f0', 
                            color: '#475569', 
                            textTransform: 'uppercase', 
                            fontSize: '0.72rem', 
                            fontWeight: 800,
                            letterSpacing: '0.04em'
                          }}>
                            <th style={{ padding: '12px 20px', textAlign: 'left' }}>Register No</th>
                            <th style={{ padding: '12px 20px', textAlign: 'left' }}>Student Scholar</th>
                            <th style={{ padding: '12px 16px', textAlign: 'center' }}>Dept</th>
                            <th style={{ padding: '12px 16px', textAlign: 'center' }}>CGPA</th>
                            <th style={{ padding: '12px 16px', textAlign: 'center' }}>Backlogs</th>
                            <th style={{ padding: '12px 16px', textAlign: 'center' }}>Attendance</th>
                            <th style={{ padding: '12px 16px', textAlign: 'left', minWidth: '200px' }}>Evaluation Remarks</th>
                            <th style={{ padding: '12px 20px', textAlign: 'right', minWidth: '200px' }}>Round Status</th>
                          </tr>
                        </thead>
                        <tbody>
                          {roundCandidates
                            .filter(a => 
                              (a.student || a.name || '').toLowerCase().includes(search.toLowerCase()) || 
                              (a.regNo || '').toLowerCase().includes(search.toLowerCase()) ||
                              (a.dept || '').toLowerCase().includes(search.toLowerCase())
                            )
                            .map((app, cIdx) => {
                              const rData = app.roundEvaluations?.[activeRound.name] || {};
                              const currentStatus = rData.status || (selectedRoundIndex === 0 ? app.status : 'Pending');
                              const currentNotes = rData.notes || '';

                              return (
                                <tr key={app._id || app.applicationId || cIdx} style={{ borderBottom: '1px solid #f1f5f9', transition: 'background 0.1s ease' }}>
                                  <td style={{ padding: '14px 20px', fontFamily: 'monospace', fontWeight: 700, color: '#64748b' }}>
                                    {app.regNo || app.studentId}
                                  </td>
                                  <td style={{ padding: '14px 20px' }}>
                                    <div style={{ fontWeight: 800, color: '#0f172a' }}>{app.student || app.name}</div>
                                    <div style={{ fontSize: '0.72rem', color: '#94a3b8' }}>ID: {app.applicationId || app._id}</div>
                                  </td>
                                  <td style={{ padding: '14px 16px', textAlign: 'center' }}>
                                    <span style={{ padding: '3px 8px', borderRadius: '6px', background: '#f1f5f9', color: '#334155', fontSize: '0.75rem', fontWeight: 700 }}>
                                      {app.dept || 'General'}
                                    </span>
                                  </td>
                                  <td style={{ padding: '14px 16px', textAlign: 'center', fontWeight: 800, color: '#2563eb' }}>
                                    {app.cgpa ?? 'N/A'}
                                  </td>
                                  <td style={{ padding: '14px 16px', textAlign: 'center', fontWeight: 700, color: (app.arrears || 0) === 0 ? '#15803d' : '#dc2626' }}>
                                    {app.arrears ?? '0'}
                                  </td>
                                  <td style={{ padding: '14px 16px', textAlign: 'center', fontWeight: 600, color: '#15803d' }}>
                                    {app.attendance || '100%'}
                                  </td>
                                  <td style={{ padding: '14px 16px' }}>
                                    <input
                                      type="text"
                                      defaultValue={currentNotes}
                                      placeholder="e.g. 85/100, Strong in DSA"
                                      onBlur={(e) => {
                                        if (e.target.value !== currentNotes) {
                                          handleUpdateStudentRoundStatus(app, activeRound.name, selectedRoundIndex, currentStatus, e.target.value);
                                        }
                                      }}
                                      style={{
                                        padding: '6px 12px',
                                        borderRadius: '6px',
                                        border: '1px solid #cbd5e1',
                                        background: '#f8fafc',
                                        fontSize: '0.8rem',
                                        width: '100%',
                                        color: '#0f172a',
                                        outline: 'none'
                                      }}
                                    />
                                  </td>
                                  <td style={{ padding: '14px 20px', textAlign: 'right' }}>
                                    <select
                                      value={currentStatus}
                                      onChange={(e) => handleUpdateStudentRoundStatus(app, activeRound.name, selectedRoundIndex, e.target.value, currentNotes)}
                                      style={{
                                        padding: '6px 12px',
                                        borderRadius: '8px',
                                        fontSize: '0.8rem',
                                        fontWeight: 800,
                                        border: '1.5px solid #cbd5e1',
                                        cursor: 'pointer',
                                        outline: 'none',
                                        background: 
                                          currentStatus === 'Qualified' ? '#ecfdf5' : 
                                          currentStatus === 'Selected' ? '#fffbeb' : 
                                          currentStatus === 'Rejected' ? '#fef2f2' : 
                                          currentStatus === 'Absent' ? '#f1f5f9' : '#eff6ff',
                                        color: 
                                          currentStatus === 'Qualified' ? '#065f46' : 
                                          currentStatus === 'Selected' ? '#92400e' : 
                                          currentStatus === 'Rejected' ? '#991b1b' : 
                                          currentStatus === 'Absent' ? '#64748b' : '#1e40af'
                                      }}
                                    >
                                      <option value="Pending">⏳ Pending Evaluation</option>
                                      <option value="Qualified">✓ Qualified (Next Round)</option>
                                      <option value="Selected">🏆 Selected (Final Offer)</option>
                                      <option value="Rejected">❌ Rejected</option>
                                      <option value="Absent">🚫 Absent</option>
                                    </select>
                                  </td>
                                </tr>
                              );
                            })}

                          {roundCandidates.length === 0 && (
                            <tr>
                              <td colSpan={8} style={{ textAlign: 'center', padding: '3.5rem 1rem', color: '#64748b' }}>
                                <div style={{ display: 'flex', flexDirection: 'column', alignItems: 'center', gap: '8px' }}>
                                  <Users size={36} color="#94a3b8" />
                                  <div style={{ fontWeight: 800, fontSize: '1rem', color: '#0f172a' }}>
                                    {selectedRoundIndex === 0 
                                      ? 'No registered candidates found in Round 1.' 
                                      : `No candidates qualified yet from ${prevRound || 'previous round'}.`}
                                  </div>
                                  <p style={{ margin: 0, fontSize: '0.82rem', maxWidth: '420px', color: '#64748b' }}>
                                    {selectedRoundIndex === 0
                                      ? 'You can automatically enroll all eligible students based on CGPA and department cutoffs.'
                                      : 'Evaluate scholars in the previous round and mark them as "Qualified" to advance them here.'}
                                  </p>
                                  {selectedRoundIndex === 0 && currentInterviewJob && (
                                    <button
                                      type="button"
                                      onClick={() => handleBulkEnrollEligibleStudents(currentInterviewJob)}
                                      style={{ 
                                        marginTop: '10px', 
                                        display: 'flex', 
                                        alignItems: 'center', 
                                        gap: '6px', 
                                        padding: '9px 18px', 
                                        background: '#2563eb', 
                                        color: '#ffffff', 
                                        border: 'none', 
                                        borderRadius: '8px', 
                                        fontSize: '0.84rem', 
                                        fontWeight: 700, 
                                        cursor: 'pointer' 
                                      }}
                                    >
                                      <Zap size={16} /> Enroll All {liveEligible.length} Eligible Scholars Now
                                    </button>
                                  )}
                                </div>
                              </td>
                            </tr>
                          )}
                        </tbody>
                      </table>
                    </div>

                  </div>
                );
              })()}

            </div>
          )}

          {/* SCHEDULED INTERVIEW SESSIONS TABLE */}
          <div style={{ background: 'var(--bg-card, #ffffff)', borderRadius: '14px', border: '1px solid var(--border-color, #e2e8f0)', overflow: 'hidden', boxShadow: '0 2px 6px rgba(0,0,0,0.02)', marginTop: '8px' }}>
            <div style={{ padding: '14px 20px', borderBottom: '1px solid var(--border-color, #e2e8f0)', background: 'var(--bg-secondary, #f8fafc)', display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
              <h3 style={{ margin: 0, fontSize: '0.95rem', fontWeight: 800, color: 'var(--text-main)' }}>
                🗓 Scheduled Interview Sessions & Virtual Meeting Links ({interviews.length})
              </h3>
            </div>

            <div style={{ overflowX: 'auto' }}>
              <table style={{ width: '100%', borderCollapse: 'collapse', fontSize: '0.85rem' }}>
                <thead>
                  <tr style={{ background: 'var(--bg-secondary, #f8fafc)', borderBottom: '1px solid var(--border-color, #e2e8f0)', color: 'var(--text-muted, #64748b)', textTransform: 'uppercase', fontSize: '0.72rem', fontWeight: 700 }}>
                    <th style={{ padding: '12px 18px', textAlign: 'left' }}>Company</th>
                    <th style={{ padding: '12px 18px', textAlign: 'left' }}>Job Role</th>
                    <th style={{ padding: '12px 18px', textAlign: 'left' }}>Assessment Round</th>
                    <th style={{ padding: '12px 18px', textAlign: 'center' }}>Date & Time</th>
                    <th style={{ padding: '12px 18px', textAlign: 'center' }}>Venue / Mode</th>
                    <th style={{ padding: '12px 18px', textAlign: 'right' }}>Action</th>
                  </tr>
                </thead>
                <tbody>
                  {interviews.map((int, idx) => (
                    <tr key={int._id || int.interviewId || idx} style={{ borderBottom: '1px solid var(--border-color, #f1f5f9)' }}>
                      <td style={{ padding: '12px 18px', fontWeight: 800, color: '#2563eb' }}>{int.company}</td>
                      <td style={{ padding: '12px 18px', fontWeight: 600 }}>{int.role}</td>
                      <td style={{ padding: '12px 18px' }}>
                        <span style={{ padding: '3px 8px', borderRadius: 4, background: '#eff6ff', color: '#2563eb', fontWeight: 700, fontSize: '0.75rem' }}>
                          {int.round}
                        </span>
                      </td>
                      <td style={{ padding: '12px 18px', textAlign: 'center' }}>{int.date ? new Date(int.date).toLocaleDateString() : 'TBA'} ({int.time || '10:00 AM'})</td>
                      <td style={{ padding: '12px 18px', textAlign: 'center' }}>
                        <span style={{ padding: '3px 8px', borderRadius: 6, background: int.mode === 'Online' ? '#eff6ff' : '#f1f5f9', color: int.mode === 'Online' ? '#2563eb' : '#475569', fontWeight: 700, fontSize: '0.75rem' }}>
                          {int.mode || 'Online'} • {int.venue}
                        </span>
                      </td>
                      <td style={{ padding: '12px 18px', textAlign: 'right' }}>
                        <button 
                          type="button" 
                          onClick={() => showToast(`Notification dispatched to candidates for ${int.company} interview!`)}
                          style={{ padding: '5px 12px', background: '#eff6ff', border: '1px solid #bfdbfe', borderRadius: '6px', color: '#2563eb', fontWeight: 700, fontSize: '0.75rem', cursor: 'pointer' }}
                        >
                          Notify Candidates
                        </button>
                      </td>
                    </tr>
                  ))}
                  {interviews.length === 0 && (
                    <tr>
                      <td colSpan={6} style={{ textAlign: 'center', padding: '2.5rem', color: 'var(--text-muted)' }}>
                        No interview sessions scheduled yet. Click "+ Schedule Interview Session" to create one.
                      </td>
                    </tr>
                  )}
                </tbody>
              </table>
            </div>
          </div>

        </div>
      )}

      {/* 6.5 TRAINING PROGRAMS */}
      {activeTab === 'Training Programs' && (
        <div style={{ display: 'flex', flexDirection: 'column', gap: '16px' }}>
          
          <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', flexWrap: 'wrap', gap: '12px' }}>
            <div>
              <h3 style={{ margin: 0, fontSize: '1.05rem', fontWeight: 800, color: 'var(--text-main, #0f172a)' }}>
                📚 Campus Training & Skill Development Programs ({trainingPrograms.length})
              </h3>
              <p style={{ margin: '2px 0 0 0', fontSize: '0.8rem', color: 'var(--text-muted, #64748b)' }}>
                Technical bootcamps, quantitative aptitude, mock interviews, and corporate soft skills workshops.
              </p>
            </div>
            <div style={{ display: 'flex', gap: '10px', alignItems: 'center', flexWrap: 'wrap' }}>
              <button 
                type="button" 
                onClick={() => {
                  const headers = ['Program ID', 'Title', 'Trainer', 'Department', 'Date', 'Time', 'Venue', 'Mode', 'Status'];
                  const rows = trainingPrograms.map(p => [p.id, p.title, p.trainer, p.targetDepartment, p.date, p.time, p.venue, p.mode, p.status]);
                  exportCSV('Placement_Training_Programs', headers, rows);
                }}
                style={{ padding: '8px 14px', background: 'var(--bg-card, #ffffff)', border: '1px solid var(--border-color, #e2e8f0)', borderRadius: '8px', fontSize: '0.82rem', fontWeight: 700, cursor: 'pointer', display: 'flex', alignItems: 'center', gap: '6px' }}
              >
                <Download size={14} /> Export Schedule (.CSV)
              </button>
              <button 
                type="button" 
                onClick={() => setShowTrainingModal(true)} 
                style={{ display: 'flex', alignItems: 'center', gap: '6px', padding: '8px 16px', background: '#2563eb', color: '#ffffff', border: 'none', borderRadius: '8px', fontSize: '0.85rem', fontWeight: 700, cursor: 'pointer' }}
              >
                <Plus size={16} /> Schedule Training Program
              </button>
            </div>
          </div>

          {/* 4 Executive KPI Cards for Training */}
          <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fit, minmax(220px, 1fr))', gap: '14px' }}>
            <div style={{ background: 'var(--bg-card, #ffffff)', padding: '16px 18px', borderRadius: '14px', border: '1px solid var(--border-color, #e2e8f0)', boxShadow: '0 2px 6px rgba(0,0,0,0.02)' }}>
              <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
                <span style={{ fontSize: '0.72rem', fontWeight: 700, color: '#2563eb', textTransform: 'uppercase' }}>Total Modules</span>
                <div style={{ width: '32px', height: '32px', borderRadius: '8px', background: 'rgba(37,99,235,0.1)', color: '#2563eb', display: 'flex', alignItems: 'center', justifyContent: 'center' }}>
                  <BookOpen size={16} />
                </div>
              </div>
              <div style={{ fontSize: '1.65rem', fontWeight: 800, color: 'var(--text-main, #0f172a)', marginTop: '4px' }}>{trainingPrograms.length}</div>
              <div style={{ fontSize: '0.72rem', color: 'var(--text-muted, #64748b)', marginTop: '2px' }}>Curriculum Bootcamps</div>
            </div>

            <div style={{ background: 'var(--bg-card, #ffffff)', padding: '16px 18px', borderRadius: '14px', border: '1px solid var(--border-color, #e2e8f0)', boxShadow: '0 2px 6px rgba(0,0,0,0.02)' }}>
              <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
                <span style={{ fontSize: '0.72rem', fontWeight: 700, color: '#16a34a', textTransform: 'uppercase' }}>Active / Upcoming</span>
                <div style={{ width: '32px', height: '32px', borderRadius: '8px', background: 'rgba(22,163,74,0.1)', color: '#16a34a', display: 'flex', alignItems: 'center', justifyContent: 'center' }}>
                  <Calendar size={16} />
                </div>
              </div>
              <div style={{ fontSize: '1.65rem', fontWeight: 800, color: '#15803d', marginTop: '4px' }}>
                {trainingPrograms.filter(p => p.status === 'Scheduled').length}
              </div>
              <div style={{ fontSize: '0.72rem', color: '#16a34a', marginTop: '2px', fontWeight: 600 }}>Scheduled Sessions</div>
            </div>

            <div style={{ background: 'var(--bg-card, #ffffff)', padding: '16px 18px', borderRadius: '14px', border: '1px solid var(--border-color, #e2e8f0)', boxShadow: '0 2px 6px rgba(0,0,0,0.02)' }}>
              <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
                <span style={{ fontSize: '0.72rem', fontWeight: 700, color: '#7c3aed', textTransform: 'uppercase' }}>Eligible Students</span>
                <div style={{ width: '32px', height: '32px', borderRadius: '8px', background: 'rgba(124,58,237,0.1)', color: '#7c3aed', display: 'flex', alignItems: 'center', justifyContent: 'center' }}>
                  <Users size={16} />
                </div>
              </div>
              <div style={{ fontSize: '1.65rem', fontWeight: 800, color: '#6d28d9', marginTop: '4px' }}>{allStudents.length}</div>
              <div style={{ fontSize: '0.72rem', color: '#7c3aed', marginTop: '2px', fontWeight: 600 }}>Enrolled Scholars</div>
            </div>

            <div style={{ background: 'var(--bg-card, #ffffff)', padding: '16px 18px', borderRadius: '14px', border: '1px solid var(--border-color, #e2e8f0)', boxShadow: '0 2px 6px rgba(0,0,0,0.02)' }}>
              <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
                <span style={{ fontSize: '0.72rem', fontWeight: 700, color: '#d97706', textTransform: 'uppercase' }}>Targeted Rounds</span>
                <div style={{ width: '32px', height: '32px', borderRadius: '8px', background: 'rgba(217,119,6,0.1)', color: '#d97706', display: 'flex', alignItems: 'center', justifyContent: 'center' }}>
                  <Layers size={16} />
                </div>
              </div>
              <div style={{ fontSize: '1.65rem', fontWeight: 800, color: '#b45309', marginTop: '4px' }}>
                Round 1 - 3
              </div>
              <div style={{ fontSize: '0.72rem', color: '#d97706', marginTop: '2px', fontWeight: 600 }}>Aptitude, Tech & HR</div>
            </div>
          </div>

          {/* Interview Round Filter Bar for Training Programs */}
          <div style={{ display: 'flex', alignItems: 'center', gap: '8px', flexWrap: 'wrap', background: 'var(--bg-card, #ffffff)', padding: '12px 16px', borderRadius: '12px', border: '1px solid var(--border-color, #e2e8f0)' }}>
            <span style={{ fontSize: '0.8rem', fontWeight: 800, color: 'var(--text-main, #0f172a)', marginRight: '4px' }}>
              🎯 Filter by Target Interview Round:
            </span>
            {[
              { id: 'ALL', label: 'All Training Modules' },
              { id: 'Round 1', label: 'Round 1 Prep (Aptitude & Online Test)' },
              { id: 'Round 2', label: 'Round 2 Prep (Technical & Coding)' },
              { id: 'Round 3', label: 'Round 3 Prep (HR & Soft Skills)' }
            ].map(f => (
              <button
                key={f.id}
                type="button"
                onClick={() => setTrainingRoundFilter(f.id)}
                style={{
                  padding: '6px 14px',
                  borderRadius: '8px',
                  border: trainingRoundFilter === f.id ? '1px solid #2563eb' : '1px solid var(--border-color, #cbd5e1)',
                  background: trainingRoundFilter === f.id ? '#2563eb' : 'var(--bg-primary, #ffffff)',
                  color: trainingRoundFilter === f.id ? '#ffffff' : 'var(--text-main, #0f172a)',
                  fontWeight: 700,
                  fontSize: '0.78rem',
                  cursor: 'pointer',
                  transition: 'all 0.15s ease'
                }}
              >
                {f.label}
              </button>
            ))}
          </div>

          {/* Programs Table */}
          <div style={{ background: 'var(--bg-card, #ffffff)', borderRadius: '14px', border: '1px solid var(--border-color, #e2e8f0)', overflow: 'hidden', boxShadow: '0 2px 6px rgba(0,0,0,0.02)' }}>
            <div style={{ overflowX: 'auto' }}>
              <table style={{ width: '100%', borderCollapse: 'collapse', fontSize: '0.85rem' }}>
                <thead>
                  <tr style={{ background: 'var(--bg-secondary, #f8fafc)', borderBottom: '1px solid var(--border-color, #e2e8f0)', color: 'var(--text-muted, #64748b)', textTransform: 'uppercase', fontSize: '0.72rem', fontWeight: 700 }}>
                    <th style={{ padding: '12px 18px', textAlign: 'left' }}>Module / Program Title</th>
                    <th style={{ padding: '12px 18px', textAlign: 'left' }}>Targeted Interview Round</th>
                    <th style={{ padding: '12px 18px', textAlign: 'left' }}>Trainer / Partner</th>
                    <th style={{ padding: '12px 18px', textAlign: 'left' }}>Target Department</th>
                    <th style={{ padding: '12px 18px', textAlign: 'center' }}>Date & Timing</th>
                    <th style={{ padding: '12px 18px', textAlign: 'center' }}>Venue / Mode</th>
                    <th style={{ padding: '12px 18px', textAlign: 'center' }}>Status</th>
                    <th style={{ padding: '12px 18px', textAlign: 'right' }}>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  {trainingPrograms
                    .filter(p => {
                      if (trainingRoundFilter === 'ALL') return true;
                      const r = String(p.targetRound || p.title || '').toLowerCase();
                      if (trainingRoundFilter === 'Round 1') return r.includes('round 1') || r.includes('aptitude') || r.includes('quantitative');
                      if (trainingRoundFilter === 'Round 2') return r.includes('round 2') || r.includes('technical') || r.includes('coding') || r.includes('full stack');
                      if (trainingRoundFilter === 'Round 3') return r.includes('round 3') || r.includes('hr') || r.includes('soft skills') || r.includes('gd');
                      return true;
                    })
                    .map(prog => (
                      <tr key={prog.id} style={{ borderBottom: '1px solid var(--border-color, #f1f5f9)' }}>
                        <td style={{ padding: '12px 18px' }}>
                          <div style={{ fontWeight: 800, color: 'var(--text-main, #0f172a)' }}>{prog.title}</div>
                          <div style={{ fontSize: '0.75rem', color: 'var(--text-muted, #64748b)', marginTop: '2px' }}>{prog.description || 'Professional placement readiness module'}</div>
                        </td>
                        <td style={{ padding: '12px 18px' }}>
                          <span style={{ 
                            padding: '4px 10px', borderRadius: '6px', 
                            background: 
                              String(prog.targetRound || prog.title).toLowerCase().includes('aptitude') || String(prog.targetRound || prog.title).toLowerCase().includes('round 1') ? '#eff6ff' :
                              String(prog.targetRound || prog.title).toLowerCase().includes('tech') || String(prog.targetRound || prog.title).toLowerCase().includes('round 2') ? '#f5f3ff' :
                              String(prog.targetRound || prog.title).toLowerCase().includes('hr') || String(prog.targetRound || prog.title).toLowerCase().includes('round 3') ? '#fef3c7' : '#f0fdf4',
                            color: 
                              String(prog.targetRound || prog.title).toLowerCase().includes('aptitude') || String(prog.targetRound || prog.title).toLowerCase().includes('round 1') ? '#1d4ed8' :
                              String(prog.targetRound || prog.title).toLowerCase().includes('tech') || String(prog.targetRound || prog.title).toLowerCase().includes('round 2') ? '#6d28d9' :
                              String(prog.targetRound || prog.title).toLowerCase().includes('hr') || String(prog.targetRound || prog.title).toLowerCase().includes('round 3') ? '#b45309' : '#15803d',
                            fontWeight: 800, fontSize: '0.75rem' 
                          }}>
                            {prog.targetRound || (
                              String(prog.title).toLowerCase().includes('aptitude') ? 'Round 1 (Aptitude)' :
                              String(prog.title).toLowerCase().includes('java') || String(prog.title).toLowerCase().includes('tech') ? 'Round 2 (Technical)' :
                              String(prog.title).toLowerCase().includes('hr') || String(prog.title).toLowerCase().includes('soft') ? 'Round 3 (HR & GD)' : 'All Interview Rounds'
                            )}
                          </span>
                        </td>
                        <td style={{ padding: '12px 18px', fontWeight: 600, color: '#2563eb' }}>
                          {prog.trainer}
                        </td>
                        <td style={{ padding: '12px 18px' }}>
                          <span style={{ padding: '3px 8px', borderRadius: '6px', background: '#eff6ff', color: '#2563eb', fontWeight: 700, fontSize: '0.75rem' }}>
                            {prog.targetDepartment}
                          </span>
                        </td>
                        <td style={{ padding: '12px 18px', textAlign: 'center' }}>
                          <div style={{ fontWeight: 700 }}>{new Date(prog.date).toLocaleDateString()}</div>
                          <div style={{ fontSize: '0.72rem', color: 'var(--text-muted, #64748b)' }}>{prog.time}</div>
                        </td>
                        <td style={{ padding: '12px 18px', textAlign: 'center' }}>
                          <span style={{ 
                            padding: '3px 8px', borderRadius: '6px', 
                            background: prog.mode === 'Online' ? '#e0e7ff' : prog.mode === 'Hybrid' ? '#fef3c7' : '#f1f5f9', 
                            color: prog.mode === 'Online' ? '#4338ca' : prog.mode === 'Hybrid' ? '#b45309' : '#334155', 
                            fontWeight: 700, fontSize: '0.75rem' 
                          }}>
                            {prog.mode} • {prog.venue}
                          </span>
                        </td>
                        <td style={{ padding: '12px 18px', textAlign: 'center' }}>
                          <span style={{ 
                            padding: '3px 8px', borderRadius: '6px', 
                            background: prog.status === 'Completed' ? '#dcfce7' : '#eff6ff', 
                            color: prog.status === 'Completed' ? '#15803d' : '#2563eb', 
                            fontWeight: 800, fontSize: '0.75rem' 
                          }}>
                            {prog.status}
                          </span>
                        </td>
                        <td style={{ padding: '12px 18px', textAlign: 'right' }}>
                          <div style={{ display: 'flex', justifyContent: 'flex-end', gap: '6px' }}>
                            <button
                              type="button"
                              onClick={() => setSelectedTrainingForAttendance(prog)}
                              style={{ padding: '5px 10px', fontSize: '0.75rem', fontWeight: 700, borderRadius: '6px', background: '#2563eb', color: '#ffffff', border: 'none', cursor: 'pointer' }}
                            >
                              Student Roster
                            </button>
                            <button
                              type="button"
                              onClick={() => handleDeleteTrainingProgram(prog.id)}
                              style={{ padding: '5px 8px', fontSize: '0.75rem', fontWeight: 700, borderRadius: '6px', background: '#fee2e2', color: '#dc2626', border: '1px solid #fecaca', cursor: 'pointer' }}
                              title="Remove program"
                            >
                              <Trash2 size={13} />
                            </button>
                          </div>
                        </td>
                      </tr>
                    ))}
                  {trainingPrograms.length === 0 && (
                    <tr>
                      <td colSpan={8} style={{ textAlign: 'center', padding: '3rem', color: 'var(--text-muted, #64748b)' }}>
                        No training programs scheduled yet. Click "+ Schedule Training Program" to add one.
                      </td>
                    </tr>
                  )}
                </tbody>
              </table>
            </div>
          </div>

        </div>
      )}

      {/* 7. SELECTIONS & OFFERS */}
      {activeTab === 'Selected Students' && (
        <div style={{ display: 'flex', flexDirection: 'column', gap: '16px' }}>
          
          <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', flexWrap: 'wrap', gap: '12px' }}>
            <div>
              <h3 style={{ margin: 0, fontSize: '1.05rem', fontWeight: 800, color: 'var(--text-main)' }}>
                🏆 Verified Placement Selections & Offer Roll ({selections.length})
              </h3>
            </div>
            <div style={{ display: 'flex', gap: '10px' }}>
              <button 
                type="button" 
                onClick={() => {
                  const headers = ['Register No', 'Student Name', 'Company', 'Designation', 'Package (CTC)', 'Offer Date'];
                  const rows = selections.map(s => [s.regNo, s.student, s.company, s.role, s.ctc, s.date]);
                  exportCSV('Verified_Selections_Offers', headers, rows);
                }}
                style={{ padding: '8px 14px', background: 'var(--bg-card, #ffffff)', border: '1px solid var(--border-color, #e2e8f0)', borderRadius: '8px', fontSize: '0.82rem', fontWeight: 700, cursor: 'pointer', display: 'flex', alignItems: 'center', gap: '6px' }}
              >
                <Download size={14} /> Export Offer Roll (.CSV)
              </button>
              <button 
                type="button" 
                onClick={() => setShowSelectionModal(true)} 
                style={{ display: 'flex', alignItems: 'center', gap: '6px', padding: '8px 16px', background: '#16a34a', color: '#ffffff', border: 'none', borderRadius: '8px', fontSize: '0.85rem', fontWeight: 700, cursor: 'pointer' }}
              >
                <Plus size={16} /> Record Student Selection
              </button>
            </div>
          </div>

          <div style={{ background: 'var(--bg-card, #ffffff)', borderRadius: '14px', border: '1px solid var(--border-color, #e2e8f0)', overflow: 'hidden', boxShadow: '0 2px 6px rgba(0,0,0,0.02)' }}>
            <div style={{ overflowX: 'auto' }}>
              <table style={{ width: '100%', borderCollapse: 'collapse', fontSize: '0.85rem' }}>
                <thead>
                  <tr style={{ background: 'var(--bg-secondary, #f8fafc)', borderBottom: '1px solid var(--border-color, #e2e8f0)', color: 'var(--text-muted, #64748b)', textTransform: 'uppercase', fontSize: '0.72rem', fontWeight: 700 }}>
                    <th style={{ padding: '12px 18px', textAlign: 'left' }}>Register No</th>
                    <th style={{ padding: '12px 18px', textAlign: 'left' }}>Student Name</th>
                    <th style={{ padding: '12px 18px', textAlign: 'left' }}>Recruiting Company</th>
                    <th style={{ padding: '12px 18px', textAlign: 'left' }}>Job Designation</th>
                    <th style={{ padding: '12px 18px', textAlign: 'center' }}>Package (CTC)</th>
                    <th style={{ padding: '12px 18px', textAlign: 'right' }}>Offer Date</th>
                  </tr>
                </thead>
                <tbody>
                  {selections.map((sel, idx) => (
                    <tr key={sel._id || sel.selectionId || idx} style={{ borderBottom: '1px solid var(--border-color, #f1f5f9)' }}>
                      <td style={{ padding: '12px 18px', fontFamily: 'monospace', fontWeight: 600, color: 'var(--text-muted)' }}>{sel.regNo}</td>
                      <td style={{ padding: '12px 18px', fontWeight: 800, color: 'var(--text-main)' }}>{sel.student}</td>
                      <td style={{ padding: '12px 18px', fontWeight: 800, color: '#2563eb' }}>{sel.company}</td>
                      <td style={{ padding: '12px 18px', fontWeight: 600 }}>{sel.role}</td>
                      <td style={{ padding: '12px 18px', textAlign: 'center' }}>
                        <span style={{ padding: '3px 8px', borderRadius: '6px', background: '#dcfce7', color: '#15803d', fontWeight: 800, fontSize: '0.8rem' }}>
                          {sel.ctc}
                        </span>
                      </td>
                      <td style={{ padding: '12px 18px', textAlign: 'right', color: 'var(--text-muted)' }}>
                        {sel.date ? new Date(sel.date).toLocaleDateString() : 'Active'}
                      </td>
                    </tr>
                  ))}
                  {selections.length === 0 && (
                    <tr>
                      <td colSpan={6} style={{ textAlign: 'center', padding: '3rem', color: 'var(--text-muted)' }}>
                        No corporate placement selections recorded yet.
                      </td>
                    </tr>
                  )}
                </tbody>
              </table>
            </div>
          </div>

        </div>
      )}

      {/* 8. COMPLETE ENTERPRISE PLACEMENT REPORTS & ANALYTICS SUITE */}
      {activeTab === 'Reports' && (() => {
        // ── LIVE REPORT METRIC COMPUTATIONS ──
        const totalStudentsCount = allStudents.length || 0;
        
        // Unique Applied Students
        const uniqueAppliedRegNos = new Set(applications.map(a => a.regNo || a.studentId || a.id).filter(Boolean));
        const totalAppliedStudentsCount = uniqueAppliedRegNos.size;

        // Unique Placed Students (from selections + selected applications)
        const uniquePlacedRegNos = new Set([
          ...selections.map(s => s.regNo).filter(Boolean),
          ...applications.filter(a => a.status === 'Selected').map(a => a.regNo || a.studentId || a.id).filter(Boolean)
        ]);
        const totalPlacedStudentsCount = uniquePlacedRegNos.size;
        const totalNotPlacedStudentsCount = Math.max(0, totalStudentsCount - totalPlacedStudentsCount);

        // Drives & Companies
        const totalCompaniesCount = companies.length || new Set(jobs.map(j => j.company)).size;
        const totalJobDrivesCount = jobs.length;

        // Offers, Active In Rounds & Rejections
        const totalOffersCount = selections.length + applications.filter(a => a.status === 'Selected' && !selections.some(s => s.regNo === (a.regNo || a.studentId))).length;
        const totalAttendingRoundsCount = applications.filter(a => !['Selected', 'Rejected', 'Absent'].includes(a.status)).length;
        const totalRejectedCount = applications.filter(a => a.status === 'Rejected').length;
        const overallPlacementRate = totalStudentsCount > 0 ? ((totalPlacedStudentsCount / totalStudentsCount) * 100).toFixed(1) : '0.0';

        // Available Filter Options
        const uniqueDepts = Array.from(new Set([
          ...allStudents.map(s => s.dept).filter(Boolean),
          ...applications.map(a => a.dept).filter(Boolean),
          ...selections.map(s => s.dept).filter(Boolean),
          'TAMIL', 'ENGLISH', 'COMMERCE', 'BScCs', 'BCA', 'MATHS', 'MANAGEMENT'
        ]));

        const uniqueCompanies = Array.from(new Set([
          ...companies.map(c => c.name).filter(Boolean),
          ...jobs.map(j => j.company).filter(Boolean),
          ...applications.map(a => a.company).filter(Boolean),
          ...selections.map(s => s.company).filter(Boolean)
        ]));

        // Global Filter Matching Helper
        const matchesGlobalFilters = (item) => {
          const q = (reportSearch || '').trim().toLowerCase();
          const matchQuery = !q || 
            String(item.student || item.studentName || item.name || '').toLowerCase().includes(q) ||
            String(item.regNo || item.studentId || item.id || '').toLowerCase().includes(q) ||
            String(item.company || '').toLowerCase().includes(q) ||
            String(item.role || item.jobTitle || '').toLowerCase().includes(q) ||
            String(item.dept || '').toLowerCase().includes(q);

          const matchDept = reportDeptFilter === 'ALL' || (item.dept || 'TAMIL').toUpperCase() === reportDeptFilter.toUpperCase();
          const matchCompany = reportCompanyFilter === 'ALL' || String(item.company || '').toLowerCase() === reportCompanyFilter.toLowerCase();
          
          let matchStatus = true;
          if (reportStatusFilter === 'Placed') matchStatus = item.status === 'Selected' || item.isPlaced;
          else if (reportStatusFilter === 'Attending') matchStatus = !['Selected', 'Rejected', 'Absent'].includes(item.status);
          else if (reportStatusFilter === 'Rejected') matchStatus = item.status === 'Rejected';
          else if (reportStatusFilter === 'OfferReleased') matchStatus = item.status === 'Selected' || Boolean(item.ctc);

          return matchQuery && matchDept && matchCompany && matchStatus;
        };

        // 1. Department-Wise Dataset
        const deptWiseRows = applications.filter(matchesGlobalFilters).map((app, idx) => {
          const matchingJob = jobs.find(j => (j._id && j._id === app.jobId) || (j.company === app.company && j.role === app.role));
          const totalRounds = matchingJob?.totalRounds || (matchingJob?.rounds ? matchingJob.rounds.length : 3);
          const isSelected = app.status === 'Selected';
          const isRejected = app.status === 'Rejected';
          
          return {
            id: app._id || app.applicationId || idx,
            dept: app.dept || 'TAMIL',
            student: app.student || app.name || 'Candidate Scholar',
            regNo: app.regNo || app.studentId || 'N/A',
            batch: app.batch || 'UG 2023-2027',
            company: app.company || 'Corporate Recruiter',
            role: app.role || 'Associate',
            appDate: app.appliedDate || app.date ? new Date(app.appliedDate || app.date).toLocaleDateString() : '2026-10-09',
            currentRound: isSelected ? `Completed (Round ${totalRounds})` : isRejected ? `Eliminated in Round ${app.currentRound || 1}` : `Round ${app.currentRound || 1}`,
            totalRounds,
            status: app.status || 'Applied',
            offerStatus: isSelected ? 'Offer Released' : isRejected ? 'Not Applicable' : 'Pending Evaluation'
          };
        });

        // 2. Company-Wise Dataset
        const companyWiseRows = (reportCompanyFilter === 'ALL' ? uniqueCompanies : [reportCompanyFilter]).map(compName => {
          const compJobs = jobs.filter(j => (j.company || '').toLowerCase() === compName.toLowerCase());
          const compApps = applications.filter(a => (a.company || '').toLowerCase() === compName.toLowerCase());
          const compSels = selections.filter(s => (s.company || '').toLowerCase() === compName.toLowerCase());
          
          const primaryJob = compJobs[0];
          const openings = compJobs.reduce((acc, j) => acc + (j.openings || 1), 0) || 1;
          const applied = compApps.length;
          const shortlisted = compApps.filter(a => a.status === 'Shortlisted' || a.status === 'Qualified' || a.status === 'Selected' || (a.currentRound || 1) > 1).length;
          
          const r1Passed = compApps.filter(a => (a.currentRound || 1) > 1 || a.status === 'Selected' || a.roundEvaluations?.['Round 1']?.status === 'Qualified').length;
          const r2Passed = compApps.filter(a => (a.currentRound || 1) > 2 || a.status === 'Selected' || a.roundEvaluations?.['Round 2']?.status === 'Qualified').length;
          const r3Passed = compApps.filter(a => (a.currentRound || 1) > 3 || a.status === 'Selected' || a.roundEvaluations?.['Round 3']?.status === 'Qualified').length;
          
          const rejected = compApps.filter(a => a.status === 'Rejected').length;
          const completedAll = compApps.filter(a => a.status === 'Selected' || (a.currentRound || 1) >= (primaryJob?.rounds?.length || 3)).length;
          const finalSelected = compSels.length || compApps.filter(a => a.status === 'Selected').length;
          const offersReleased = finalSelected;
          const offersAccepted = Math.max(0, finalSelected);
          const offersDeclinedOrPending = Math.max(0, offersReleased - offersAccepted);

          return {
            company: compName,
            role: primaryJob?.role || 'Various Placement Roles',
            openings,
            applied,
            shortlisted,
            r1Passed,
            r2Passed,
            r3Passed,
            rejected,
            completedAll,
            finalSelected,
            offersReleased,
            offersAccepted,
            offersDeclinedOrPending
          };
        }).filter(r => r.applied > 0 || r.finalSelected > 0 || reportCompanyFilter !== 'ALL');

        // 3. Round-Wise Dataset for selected or active drive
        const activeReportJob = jobs.find(j => (j._id || j.jobId || j.id) === (reportRoundJobId || selectedInterviewJob)) || jobs[0];
        const activeJobRounds = activeReportJob?.rounds && activeReportJob.rounds.length > 0 
          ? activeReportJob.rounds 
          : generateDefaultRounds(activeReportJob?.totalRounds || 3);

        const getRoundOutcome = (app, roundName, roundNum) => {
          const evaluation = app.roundEvaluations?.[roundName];

          // Always trust an explicitly recorded round result.
          if (evaluation?.status) return evaluation.status;

          // Fallback for older applications without round evaluations.
          if (app.status === 'Selected') return 'Selected';

          if (
            app.status === 'Rejected' &&
            (app.currentRound || 1) === roundNum
          ) {
            return 'Rejected';
          }

          if ((app.currentRound || 1) > roundNum) {
            return 'Qualified';
          }

          return 'Pending';
        };

        const roundWiseData = activeJobRounds.map((rnd, rIdx) => {
          const rNum = rIdx + 1;
          const roundName = rnd.name || `Round ${rNum}`;

          const jobApps = applications.filter(a =>
            activeReportJob
              ? (
                  a.jobId &&
                  a.jobId === (activeReportJob._id || activeReportJob.jobId)
                ) ||
                (
                  a.company === activeReportJob.company &&
                  a.role === activeReportJob.role
                )
              : true
          );

          const attended = rIdx === 0
            ? jobApps.length
            : jobApps.filter(a => {
                const previousRound =
                  activeJobRounds[rIdx - 1]?.name || `Round ${rIdx}`;

                const outcome = getRoundOutcome(
                  a,
                  previousRound,
                  rIdx
                );

                return outcome === 'Qualified' || outcome === 'Selected';
              }).length;

          const selectedNext = jobApps.filter(a => {
            const outcome = getRoundOutcome(a, roundName, rNum);
            return outcome === 'Qualified' || outcome === 'Selected';
          }).length;

          const rejected = jobApps.filter(a =>
            getRoundOutcome(a, roundName, rNum) === 'Rejected'
          ).length;

          const awaiting = Math.max(
            0,
            attended - selectedNext - rejected
          );

          return {
            roundNum: rNum,
            roundName,
            type: rnd.type || 'Assessment',
            attended,
            selectedNext,
            rejected,
            awaiting
          };
        });

        // 4. Salary Package Dataset
        const parseCtcNum = (ctcStr) => {
          if (!ctcStr) return 0;
          const m = String(ctcStr).match(/([0-9]+(?:\.[0-9]+)?)/);
          return m ? parseFloat(m[1]) : 0;
        };

        const salaryRows = selections.filter(matchesGlobalFilters).map((sel, sIdx) => {
          const ctcVal = parseCtcNum(sel.ctc);
          const monthlyEst = ctcVal > 0 ? Math.round((ctcVal * 100000) / 12) : 0;
          return {
            id: sel._id || sel.selectionId || sIdx,
            student: sel.student || 'Placed Scholar',
            regNo: sel.regNo || 'N/A',
            dept: sel.dept || 'TAMIL',
            company: sel.company || 'Recruiter',
            role: sel.role || 'Designate',
            ctcNum: ctcVal,
            ctcDisplay: sel.ctc || `${ctcVal} LPA`,
            monthlySalary: monthlyEst > 0 ? `₹ ${monthlyEst.toLocaleString('en-IN')}` : '₹ 37,500',
            offerDate: sel.date ? new Date(sel.date).toLocaleDateString() : '2026-10-09',
            status: 'Accepted & Confirmed'
          };
        });

        // Sort Salary Rows
        if (reportSort === 'ctc_desc') {
          salaryRows.sort((a, b) => b.ctcNum - a.ctcNum);
        } else if (reportSort === 'ctc_asc') {
          salaryRows.sort((a, b) => a.ctcNum - b.ctcNum);
        }

        const salaryNumbers = salaryRows.map(s => s.ctcNum).filter(n => n > 0);
        const highestPackageVal = salaryNumbers.length > 0 ? Math.max(...salaryNumbers) : 4.5;
        const lowestPackageVal = salaryNumbers.length > 0 ? Math.min(...salaryNumbers) : 3.2;
        const avgPackageVal = salaryNumbers.length > 0 ? (salaryNumbers.reduce((a, b) => a + b, 0) / salaryNumbers.length).toFixed(2) : '4.50';

        // 5. Offer Letter Tracking Dataset
        const offerLetterRows = selections.filter(matchesGlobalFilters).map((sel, idx) => ({
          id: sel._id || idx,
          student: sel.student,
          regNo: sel.regNo,
          dept: sel.dept || 'TAMIL',
          company: sel.company,
          role: sel.role,
          interviewDate: sel.date ? new Date(sel.date).toLocaleDateString() : '2026-10-01',
          offerReleaseDate: sel.date ? new Date(sel.date).toLocaleDateString() : '2026-10-05',
          letterStatus: 'Released (Verified PDF)',
          acceptanceStatus: 'Accepted by Scholar',
          joiningDate: '2027-06-15'
        }));

        // ── MASTER EXCEL DOWNLOAD HANDLER (ALL 6 WORKSHEETS) ──
        const handleDownloadMasterExcel = () => {
          const worksheets = [
            // Sheet 1: Placement Summary
            {
              name: '1_Placement_Summary',
              title: 'College ERP — Overall Campus Placement Summary & KPIs',
              headers: ['Metric Name', 'Count / Value', 'Description & Notes'],
              rows: [
                ['Academic Year', reportYearFilter, 'Official Placement Evaluation Cycle'],
                ['Total Registered Students', totalStudentsCount, 'Total scholars enrolled in graduating batch'],
                ['Total Students Applied for Jobs', totalAppliedStudentsCount, 'Scholars submitted at least 1 job application'],
                ['Total Students Placed (Unique)', totalPlacedStudentsCount, 'Unique scholars with confirmed placement offers'],
                ['Total Students Not Yet Placed', totalNotPlacedStudentsCount, 'Scholars pending final placement offers'],
                ['Total Partner Companies', totalCompaniesCount, 'Active corporate recruiters with posted drives'],
                ['Total Job Openings / Drives', totalJobDrivesCount, 'Total campus recruitment drives published'],
                ['Total Offers Issued', totalOffersCount, 'Cumulative offer letters released across all drives'],
                ['Total Attending Interview Rounds', totalAttendingRoundsCount, 'Scholars actively participating in interview rounds'],
                ['Total Candidates Rejected', totalRejectedCount, 'Scholars not qualified during evaluation rounds'],
                ['Overall Placement Rate (%)', `${overallPlacementRate}%`, 'Unique placed scholars / Total enrolled scholars']
              ]
            },
            // Sheet 2: Department-Wise Placement
            {
              name: '2_Department_Wise',
              title: 'Department-Wise Student Placement Breakdown',
              headers: ['Department', 'Student Name', 'Register No', 'Batch', 'Company', 'Job Title', 'Application Date', 'Current Round', 'Total Rounds', 'Selection Status', 'Offer Status'],
              rows: deptWiseRows.map(r => [
                r.dept, r.student, r.regNo, r.batch, r.company, r.role, r.appDate, r.currentRound, r.totalRounds, r.status, r.offerStatus
              ])
            },
            // Sheet 3: Company-Wise Recruitment
            {
              name: '3_Company_Wise',
              title: 'Company-Wise Campus Recruitment & Conversion Funnel',
              headers: ['Company Name', 'Job Role', 'Openings', 'Applied', 'Shortlisted', 'Round 1 Passed', 'Round 2 Passed', 'Round 3 Passed', 'Rejected', 'Completed All Rounds', 'Final Selected', 'Offers Released', 'Offers Accepted', 'Offers Declined/Pending'],
              rows: companyWiseRows.map(r => [
                r.company, r.role, r.openings, r.applied, r.shortlisted, r.r1Passed, r.r2Passed, r.r3Passed, r.rejected, r.completedAll, r.finalSelected, r.offersReleased, r.offersAccepted, r.offersDeclinedOrPending
              ])
            },
            // Sheet 4: Round-Wise Evaluations
            {
              name: '4_Round_Wise_Results',
              title: `Interview Round-Wise Progression Report (${activeReportJob?.company || 'All Drives'} - ${activeReportJob?.role || 'Roles'})`,
              headers: ['Round No', 'Round Name', 'Assessment Type', 'Total Attended', 'Selected / Qualified to Next', 'Rejected', 'Awaiting Results'],
              rows: roundWiseData.map(r => [
                r.roundNum, r.roundName, r.type, r.attended, r.selectedNext, r.rejected, r.awaiting
              ])
            },
            // Sheet 5: Salary Package Details
            {
              name: '5_Salary_Package_Report',
              title: 'Campus Placement Compensation & Salary Packages Report',
              headers: ['Student Scholar', 'Register No', 'Department', 'Company Name', 'Job Title', 'Annual Salary CTC', 'Estimated Monthly (₹)', 'Offer Release Date', 'Offer Acceptance Status'],
              rows: salaryRows.map(r => [
                r.student, r.regNo, r.dept, r.company, r.role, r.ctcDisplay, r.monthlySalary, r.offerDate, r.status
              ])
            },
            // Sheet 6: Offer Letters Tracking
            {
              name: '6_Offer_Letters_Tracking',
              title: 'Official Placement Offer Letters & Joining Verification Roll',
              headers: ['Student Scholar', 'Register No', 'Department', 'Company Name', 'Job Title', 'Interview Date', 'Offer Release Date', 'Offer Letter Status', 'Acceptance Status', 'Joining Date'],
              rows: offerLetterRows.map(r => [
                r.student, r.regNo, r.dept, r.company, r.role, r.interviewDate, r.offerReleaseDate, r.letterStatus, r.acceptanceStatus, r.joiningDate
              ])
            }
          ];

          downloadMultiSheetExcel(
            `College_ERP_Placement_Master_Report_${reportYearFilter}`,
            worksheets,
            reportYearFilter
          );
          showToast('✓ Master Excel Workbook downloaded with all 6 comprehensive worksheets!');
        };

        return (
          <div style={{ display: 'flex', flexDirection: 'column', gap: '20px' }}>
            
            {/* ── TOP ACTION & GLOBAL FILTERS HEADER ── */}
            <div style={{ 
              background: 'var(--bg-card, #ffffff)', 
              borderRadius: '16px', 
              border: '1px solid var(--border-color, #e2e8f0)', 
              boxShadow: '0 2px 10px rgba(0,0,0,0.03)',
              padding: '20px 24px',
              display: 'flex',
              flexDirection: 'column',
              gap: '16px'
            }}>
              
              {/* Row 1: Title & Master Excel Download Button */}
              <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', flexWrap: 'wrap', gap: '14px' }}>
                <div>
                  <div style={{ display: 'flex', alignItems: 'center', gap: '10px' }}>
                    <div style={{ width: '38px', height: '38px', borderRadius: '10px', background: 'linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%)', color: '#ffffff', display: 'flex', alignItems: 'center', justifyContent: 'center' }}>
                      <FileText size={20} />
                    </div>
                    <div>
                      <h2 style={{ margin: 0, fontSize: '1.25rem', fontWeight: 800, color: '#0f172a' }}>
                        Campus Recruitment & Placement Analytics Suite
                      </h2>
                      <p style={{ margin: '2px 0 0', fontSize: '0.8rem', color: '#64748b' }}>
                        Real-time verified departmental summaries, company funnels, round progressions, salary packages, and offer letter rolls.
                      </p>
                    </div>
                  </div>
                </div>

                <div style={{ display: 'flex', gap: '10px', alignItems: 'center', flexWrap: 'wrap' }}>
                  <button
                    type="button"
                    onClick={handleDownloadMasterExcel}
                    style={{
                      display: 'flex',
                      alignItems: 'center',
                      gap: '8px',
                      padding: '10px 20px',
                      background: 'linear-gradient(135deg, #16a34a 0%, #15803d 100%)',
                      color: '#ffffff',
                      border: 'none',
                      borderRadius: '10px',
                      fontSize: '0.88rem',
                      fontWeight: 800,
                      cursor: 'pointer',
                      boxShadow: '0 3px 10px rgba(22,163,74,0.25)',
                      transition: 'all 0.15s ease'
                    }}
                  >
                    <Download size={16} /> Download Master Excel (.XLS • 6 Worksheets)
                  </button>
                </div>
              </div>

              {/* Row 2: Comprehensive Global Filter Bar */}
              <div style={{ 
                display: 'flex', 
                gap: '12px', 
                flexWrap: 'wrap', 
                alignItems: 'center',
                paddingTop: '12px',
                borderTop: '1px solid #f1f5f9'
              }}>
                
                {/* Search */}
                <div style={{ position: 'relative', width: '260px' }}>
                  <Search size={14} style={{ position: 'absolute', left: 10, top: '50%', transform: 'translateY(-50%)', color: '#94a3b8' }} />
                  <input
                    value={reportSearch}
                    onChange={e => setReportSearch(e.target.value)}
                    placeholder="Search by student, reg no, role..."
                    style={{
                      width: '100%',
                      padding: '7px 10px 7px 32px',
                      borderRadius: '8px',
                      border: '1px solid #cbd5e1',
                      background: '#f8fafc',
                      fontSize: '0.8rem',
                      color: '#0f172a',
                      outline: 'none'
                    }}
                  />
                </div>

                {/* Academic Year Filter */}
                <div style={{ display: 'flex', alignItems: 'center', gap: '6px' }}>
                  <span style={{ fontSize: '0.74rem', fontWeight: 800, color: '#64748b' }}>Year:</span>
                  <select
                    value={reportYearFilter}
                    onChange={e => setReportYearFilter(e.target.value)}
                    style={{ padding: '6px 12px', borderRadius: '8px', border: '1px solid #cbd5e1', background: '#ffffff', fontSize: '0.8rem', fontWeight: 700, color: '#0f172a', cursor: 'pointer', outline: 'none' }}
                  >
                    <option value="2026-2027">2026-2027 (Current)</option>
                    <option value="2025-2026">2025-2026</option>
                    <option value="2024-2025">2024-2025</option>
                  </select>
                </div>

                {/* Department Filter */}
                <div style={{ display: 'flex', alignItems: 'center', gap: '6px' }}>
                  <span style={{ fontSize: '0.74rem', fontWeight: 800, color: '#64748b' }}>Dept:</span>
                  <select
                    value={reportDeptFilter}
                    onChange={e => setReportDeptFilter(e.target.value)}
                    style={{ padding: '6px 12px', borderRadius: '8px', border: '1px solid #cbd5e1', background: '#ffffff', fontSize: '0.8rem', fontWeight: 700, color: '#0f172a', cursor: 'pointer', outline: 'none' }}
                  >
                    <option value="ALL">All Departments</option>
                    {uniqueDepts.map(d => <option key={d} value={d}>{d}</option>)}
                  </select>
                </div>

                {/* Company Filter */}
                <div style={{ display: 'flex', alignItems: 'center', gap: '6px' }}>
                  <span style={{ fontSize: '0.74rem', fontWeight: 800, color: '#64748b' }}>Company:</span>
                  <select
                    value={reportCompanyFilter}
                    onChange={e => setReportCompanyFilter(e.target.value)}
                    style={{ padding: '6px 12px', borderRadius: '8px', border: '1px solid #cbd5e1', background: '#ffffff', fontSize: '0.8rem', fontWeight: 700, color: '#0f172a', cursor: 'pointer', outline: 'none' }}
                  >
                    <option value="ALL">All Companies</option>
                    {uniqueCompanies.map(c => <option key={c} value={c}>{c}</option>)}
                  </select>
                </div>

                {/* Status Filter */}
                <div style={{ display: 'flex', alignItems: 'center', gap: '6px' }}>
                  <span style={{ fontSize: '0.74rem', fontWeight: 800, color: '#64748b' }}>Status:</span>
                  <select
                    value={reportStatusFilter}
                    onChange={e => setReportStatusFilter(e.target.value)}
                    style={{ padding: '6px 12px', borderRadius: '8px', border: '1px solid #cbd5e1', background: '#ffffff', fontSize: '0.8rem', fontWeight: 700, color: '#0f172a', cursor: 'pointer', outline: 'none' }}
                  >
                    <option value="ALL">All Statuses</option>
                    <option value="Placed">🏆 Placed / Selected</option>
                    <option value="Attending">⏳ Attending Rounds</option>
                    <option value="OfferReleased">📜 Offer Released</option>
                    <option value="Rejected">❌ Rejected</option>
                  </select>
                </div>

                {/* Clear Filters Button */}
                {(reportSearch || reportDeptFilter !== 'ALL' || reportCompanyFilter !== 'ALL' || reportStatusFilter !== 'ALL') && (
                  <button
                    type="button"
                    onClick={() => {
                      setReportSearch('');
                      setReportDeptFilter('ALL');
                      setReportCompanyFilter('ALL');
                      setReportStatusFilter('ALL');
                    }}
                    style={{ padding: '6px 10px', background: '#f1f5f9', border: '1px solid #cbd5e1', borderRadius: '6px', fontSize: '0.75rem', fontWeight: 700, color: '#475569', cursor: 'pointer' }}
                  >
                    Clear Filters
                  </button>
                )}
              </div>

            </div>

            {/* ── 6 REPORT SUB-NAVIGATION TABS ── */}
            <div style={{
              display: 'flex',
              gap: '8px',
              overflowX: 'auto',
              background: '#f8fafc',
              padding: '6px 6px 0',
              borderRadius: '12px',
              border: '1px solid #e2e8f0',
              scrollbarWidth: 'none'
            }}>
              {[
                { id: 'summary', label: '1. Overall Summary', icon: <Briefcase size={16} /> },
                { id: 'department', label: '2. Department-Wise Placement', icon: <Building size={16} />, count: deptWiseRows.length },
                { id: 'company', label: '3. Company-Wise Analytics', icon: <Layers size={16} />, count: companyWiseRows.length },
                { id: 'rounds', label: '4. Interview Round-Wise', icon: <Calendar size={16} /> },
                { id: 'salary', label: '5. Salary Packages & CTC', icon: <DollarSign size={16} />, count: salaryRows.length },
                { id: 'offerLetters', label: '6. Offer Letters & Verification', icon: <Award size={16} />, count: offerLetterRows.length }
              ].map(sub => {
                const isActive = reportSubTab === sub.id;
                return (
                  <button
                    key={sub.id}
                    type="button"
                    onClick={() => setReportSubTab(sub.id)}
                    style={{
                      display: 'flex',
                      alignItems: 'center',
                      gap: '8px',
                      padding: '10px 16px',
                      borderRadius: '8px 8px 0 0',
                      border: 'none',
                      borderBottom: isActive ? '3px solid #2563eb' : '3px solid transparent',
                      background: isActive ? '#ffffff' : 'transparent',
                      color: isActive ? '#2563eb' : '#64748b',
                      fontWeight: isActive ? 800 : 600,
                      fontSize: '0.84rem',
                      cursor: 'pointer',
                      whiteSpace: 'nowrap',
                      transition: 'all 0.15s ease'
                    }}
                  >
                    {sub.icon}
                    <span>{sub.label}</span>
                    {sub.count !== undefined && (
                      <span style={{
                        fontSize: '0.7rem',
                        fontWeight: 700,
                        padding: '1px 6px',
                        borderRadius: '10px',
                        background: isActive ? 'rgba(37,99,235,0.12)' : '#e2e8f0',
                        color: isActive ? '#2563eb' : '#475569'
                      }}>
                        {sub.count}
                      </span>
                    )}
                  </button>
                );
              })}
            </div>

            {/* ── SUB-TAB 1: OVERALL PLACEMENT SUMMARY REPORT ── */}
            {reportSubTab === 'summary' && (
              <div style={{ display: 'flex', flexDirection: 'column', gap: '18px' }}>
                
                {/* 10 Master Summary Metric KPI Cards */}
                <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fit, minmax(220px, 1fr))', gap: '14px' }}>
                  
                  <div style={{ background: '#ffffff', padding: '16px 20px', borderRadius: '14px', border: '1px solid #e2e8f0', boxShadow: '0 2px 6px rgba(0,0,0,0.02)' }}>
                    <span style={{ fontSize: '0.72rem', fontWeight: 800, color: '#2563eb', textTransform: 'uppercase' }}>1. Total Enrolled</span>
                    <div style={{ fontSize: '1.75rem', fontWeight: 800, color: '#0f172a', marginTop: '4px' }}>{totalStudentsCount}</div>
                    <div style={{ fontSize: '0.75rem', color: '#64748b', marginTop: '2px' }}>Graduating Scholars Batch</div>
                  </div>

                  <div style={{ background: '#ffffff', padding: '16px 20px', borderRadius: '14px', border: '1px solid #e2e8f0', boxShadow: '0 2px 6px rgba(0,0,0,0.02)' }}>
                    <span style={{ fontSize: '0.72rem', fontWeight: 800, color: '#7c3aed', textTransform: 'uppercase' }}>2. Total Applied</span>
                    <div style={{ fontSize: '1.75rem', fontWeight: 800, color: '#6d28d9', marginTop: '4px' }}>{totalAppliedStudentsCount}</div>
                    <div style={{ fontSize: '0.75rem', color: '#64748b', marginTop: '2px' }}>Submitted Drive Applications</div>
                  </div>

                  <div style={{ background: '#ecfdf5', padding: '16px 20px', borderRadius: '14px', border: '1px solid #a7f3d0', boxShadow: '0 2px 6px rgba(0,0,0,0.02)' }}>
                    <span style={{ fontSize: '0.72rem', fontWeight: 800, color: '#065f46', textTransform: 'uppercase' }}>3. Placed Scholars</span>
                    <div style={{ fontSize: '1.75rem', fontWeight: 800, color: '#059669', marginTop: '4px' }}>{totalPlacedStudentsCount}</div>
                    <div style={{ fontSize: '0.75rem', color: '#065f46', marginTop: '2px', fontWeight: 700 }}>{overallPlacementRate}% Placement Rate</div>
                  </div>

                  <div style={{ background: '#ffffff', padding: '16px 20px', borderRadius: '14px', border: '1px solid #e2e8f0', boxShadow: '0 2px 6px rgba(0,0,0,0.02)' }}>
                    <span style={{ fontSize: '0.72rem', fontWeight: 800, color: '#d97706', textTransform: 'uppercase' }}>4. Not Yet Placed</span>
                    <div style={{ fontSize: '1.75rem', fontWeight: 800, color: '#b45309', marginTop: '4px' }}>{totalNotPlacedStudentsCount}</div>
                    <div style={{ fontSize: '0.75rem', color: '#64748b', marginTop: '2px' }}>Seeking Opportunities</div>
                  </div>

                  <div style={{ background: '#ffffff', padding: '16px 20px', borderRadius: '14px', border: '1px solid #e2e8f0', boxShadow: '0 2px 6px rgba(0,0,0,0.02)' }}>
                    <span style={{ fontSize: '0.72rem', fontWeight: 800, color: '#0284c7', textTransform: 'uppercase' }}>5. Total Companies</span>
                    <div style={{ fontSize: '1.75rem', fontWeight: 800, color: '#0369a1', marginTop: '4px' }}>{totalCompaniesCount}</div>
                    <div style={{ fontSize: '0.75rem', color: '#64748b', marginTop: '2px' }}>Recruiters Participated</div>
                  </div>

                  <div style={{ background: '#ffffff', padding: '16px 20px', borderRadius: '14px', border: '1px solid #e2e8f0', boxShadow: '0 2px 6px rgba(0,0,0,0.02)' }}>
                    <span style={{ fontSize: '0.72rem', fontWeight: 800, color: '#4338ca', textTransform: 'uppercase' }}>6. Total Job Openings</span>
                    <div style={{ fontSize: '1.75rem', fontWeight: 800, color: '#3730a3', marginTop: '4px' }}>{totalJobDrivesCount}</div>
                    <div style={{ fontSize: '0.75rem', color: '#64748b', marginTop: '2px' }}>Published Campus Drives</div>
                  </div>

                  <div style={{ background: '#ffffff', padding: '16px 20px', borderRadius: '14px', border: '1px solid #e2e8f0', boxShadow: '0 2px 6px rgba(0,0,0,0.02)' }}>
                    <span style={{ fontSize: '0.72rem', fontWeight: 800, color: '#059669', textTransform: 'uppercase' }}>7. Total Offers Issued</span>
                    <div style={{ fontSize: '1.75rem', fontWeight: 800, color: '#047857', marginTop: '4px' }}>{totalOffersCount}</div>
                    <div style={{ fontSize: '0.75rem', color: '#64748b', marginTop: '2px' }}>Verified Corporate Offers</div>
                  </div>

                  <div style={{ background: '#ffffff', padding: '16px 20px', borderRadius: '14px', border: '1px solid #e2e8f0', boxShadow: '0 2px 6px rgba(0,0,0,0.02)' }}>
                    <span style={{ fontSize: '0.72rem', fontWeight: 800, color: '#2563eb', textTransform: 'uppercase' }}>8. Attending Rounds</span>
                    <div style={{ fontSize: '1.75rem', fontWeight: 800, color: '#1e40af', marginTop: '4px' }}>{totalAttendingRoundsCount}</div>
                    <div style={{ fontSize: '0.75rem', color: '#64748b', marginTop: '2px' }}>Active in Interview Rounds</div>
                  </div>

                  <div style={{ background: '#ffffff', padding: '16px 20px', borderRadius: '14px', border: '1px solid #e2e8f0', boxShadow: '0 2px 6px rgba(0,0,0,0.02)' }}>
                    <span style={{ fontSize: '0.72rem', fontWeight: 800, color: '#dc2626', textTransform: 'uppercase' }}>9. Total Rejected</span>
                    <div style={{ fontSize: '1.75rem', fontWeight: 800, color: '#991b1b', marginTop: '4px' }}>{totalRejectedCount}</div>
                    <div style={{ fontSize: '0.75rem', color: '#64748b', marginTop: '2px' }}>Eliminated in Selection</div>
                  </div>

                  <div style={{ background: '#eff6ff', padding: '16px 20px', borderRadius: '14px', border: '1.5px solid #bfdbfe', boxShadow: '0 2px 6px rgba(0,0,0,0.02)' }}>
                    <span style={{ fontSize: '0.72rem', fontWeight: 800, color: '#1e40af', textTransform: 'uppercase' }}>10. Overall Placement %</span>
                    <div style={{ fontSize: '1.75rem', fontWeight: 800, color: '#1e40af', marginTop: '4px' }}>{overallPlacementRate}%</div>
                    <div style={{ fontSize: '0.75rem', color: '#1e40af', marginTop: '2px', fontWeight: 700 }}>NIRF Accredited Benchmark</div>
                  </div>

                </div>

                {/* Department Summary Table */}
                <div style={{ background: '#ffffff', borderRadius: '14px', border: '1px solid #e2e8f0', overflow: 'hidden' }}>
                  <div style={{ padding: '14px 20px', borderBottom: '1px solid #e2e8f0', background: '#f8fafc', display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
                    <h3 style={{ margin: 0, fontSize: '0.95rem', fontWeight: 800, color: '#0f172a' }}>
                      Department-Wise Performance Matrix
                    </h3>
                    <button
                      type="button"
                      onClick={() => {
                        const headers = ['Department', 'Enrolled Scholars', 'Applied', 'Placed', 'Placement Ratio (%)'];
                        const rows = deptStats.map(d => [d.dept, d.total, applications.filter(a => (a.dept || 'TAMIL') === d.dept).length, d.placed, `${d.percentage}%`]);
                        exportCSV('Department_Placement_Summary', headers, rows);
                      }}
                      style={{ padding: '5px 12px', background: '#ffffff', border: '1px solid #cbd5e1', borderRadius: '6px', fontSize: '0.75rem', fontWeight: 700, cursor: 'pointer', display: 'flex', alignItems: 'center', gap: '4px' }}
                    >
                      <Download size={13} /> Export CSV
                    </button>
                  </div>

                  <div style={{ overflowX: 'auto' }}>
                    <table style={{ width: '100%', borderCollapse: 'collapse', fontSize: '0.84rem' }}>
                      <thead>
                        <tr style={{ background: '#f8fafc', borderBottom: '1px solid #e2e8f0', color: '#475569', textTransform: 'uppercase', fontSize: '0.72rem', fontWeight: 800 }}>
                          <th style={{ padding: '12px 18px', textAlign: 'left' }}>Department</th>
                          <th style={{ padding: '12px 18px', textAlign: 'center' }}>Enrolled Scholars</th>
                          <th style={{ padding: '12px 18px', textAlign: 'center' }}>Applied for Jobs</th>
                          <th style={{ padding: '12px 18px', textAlign: 'center' }}>Verified Placed</th>
                          <th style={{ padding: '12px 18px', textAlign: 'center' }}>Placement Ratio (%)</th>
                          <th style={{ padding: '12px 18px', textAlign: 'right' }}>Performance Status</th>
                        </tr>
                      </thead>
                      <tbody>
                        {deptStats.map(d => {
                          const deptApplied = applications.filter(a => (a.dept || 'TAMIL') === d.dept).length;
                          return (
                            <tr key={d.dept} style={{ borderBottom: '1px solid #f1f5f9' }}>
                              <td style={{ padding: '12px 18px', fontWeight: 800, color: '#0f172a' }}>{d.dept}</td>
                              <td style={{ padding: '12px 18px', textAlign: 'center' }}>{d.total}</td>
                              <td style={{ padding: '12px 18px', textAlign: 'center', fontWeight: 700, color: '#2563eb' }}>{deptApplied}</td>
                              <td style={{ padding: '12px 18px', textAlign: 'center', fontWeight: 800, color: '#059669' }}>{d.placed}</td>
                              <td style={{ padding: '12px 18px', textAlign: 'center' }}>
                                <span style={{ padding: '3px 8px', borderRadius: '6px', background: '#ecfdf5', color: '#065f46', fontWeight: 800 }}>
                                  {d.percentage}%
                                </span>
                              </td>
                              <td style={{ padding: '12px 18px', textAlign: 'right' }}>
                                <span style={{ padding: '3px 8px', borderRadius: '6px', background: d.percentage >= 50 ? '#dcfce7' : '#fef3c7', color: d.percentage >= 50 ? '#15803d' : '#b45309', fontSize: '0.75rem', fontWeight: 700 }}>
                                  {d.percentage >= 80 ? '🌟 Outstanding' : d.percentage >= 50 ? '✓ On Track' : '⚡ Drives in Progress'}
                                </span>
                              </td>
                            </tr>
                          );
                        })}
                      </tbody>
                    </table>
                  </div>
                </div>

              </div>
            )}

            {/* ── SUB-TAB 2: DEPARTMENT-WISE PLACEMENT REPORT ── */}
            {reportSubTab === 'department' && (
              <div style={{ background: '#ffffff', borderRadius: '14px', border: '1px solid #e2e8f0', overflow: 'hidden' }}>
                <div style={{ padding: '14px 20px', borderBottom: '1px solid #e2e8f0', background: '#f8fafc', display: 'flex', justifyContent: 'space-between', alignItems: 'center', flexWrap: 'wrap', gap: '10px' }}>
                  <div>
                    <h3 style={{ margin: 0, fontSize: '0.98rem', fontWeight: 800, color: '#0f172a' }}>
                      Department-Wise Student Placement Roster ({deptWiseRows.length})
                    </h3>
                    <p style={{ margin: '2px 0 0', fontSize: '0.78rem', color: '#64748b' }}>
                      Detailed audit log of candidates, applied roles, current interview stages, and final offer releases.
                    </p>
                  </div>

                  <button
                    type="button"
                    onClick={() => {
                      const headers = ['Department', 'Student Name', 'Register No', 'Batch', 'Company', 'Job Title', 'Application Date', 'Current Round', 'Total Rounds', 'Selection Status', 'Offer Status'];
                      const rows = deptWiseRows.map(r => [r.dept, r.student, r.regNo, r.batch, r.company, r.role, r.appDate, r.currentRound, r.totalRounds, r.status, r.offerStatus]);
                      exportCSV(`Department_Wise_Placement_Report_${reportDeptFilter}`, headers, rows);
                    }}
                    style={{ padding: '6px 14px', background: '#2563eb', color: '#ffffff', border: 'none', borderRadius: '8px', fontSize: '0.8rem', fontWeight: 700, cursor: 'pointer', display: 'flex', alignItems: 'center', gap: '6px' }}
                  >
                    <Download size={14} /> Export Department Sheet (.CSV)
                  </button>
                </div>

                <div style={{ overflowX: 'auto' }}>
                  <table style={{ width: '100%', borderCollapse: 'collapse', fontSize: '0.83rem' }}>
                    <thead>
                      <tr style={{ background: '#f8fafc', borderBottom: '1px solid #e2e8f0', color: '#475569', textTransform: 'uppercase', fontSize: '0.72rem', fontWeight: 800 }}>
                        <th style={{ padding: '12px 16px', textAlign: 'left' }}>Department</th>
                        <th style={{ padding: '12px 16px', textAlign: 'left' }}>Student Name</th>
                        <th style={{ padding: '12px 16px', textAlign: 'left' }}>Register No</th>
                        <th style={{ padding: '12px 16px', textAlign: 'left' }}>Course & Batch</th>
                        <th style={{ padding: '12px 16px', textAlign: 'left' }}>Company</th>
                        <th style={{ padding: '12px 16px', textAlign: 'left' }}>Job Role</th>
                        <th style={{ padding: '12px 16px', textAlign: 'center' }}>App Date</th>
                        <th style={{ padding: '12px 16px', textAlign: 'center' }}>Interview Stage</th>
                        <th style={{ padding: '12px 16px', textAlign: 'center' }}>Status</th>
                        <th style={{ padding: '12px 16px', textAlign: 'right' }}>Offer Status</th>
                      </tr>
                    </thead>
                    <tbody>
                      {deptWiseRows.map(row => (
                        <tr key={row.id} style={{ borderBottom: '1px solid #f1f5f9' }}>
                          <td style={{ padding: '12px 16px', fontWeight: 800, color: '#0f172a' }}>
                            <span style={{ padding: '2px 8px', borderRadius: '6px', background: '#eff6ff', color: '#2563eb', fontSize: '0.74rem' }}>
                              {row.dept}
                            </span>
                          </td>
                          <td style={{ padding: '12px 16px', fontWeight: 800, color: '#0f172a' }}>{row.student}</td>
                          <td style={{ padding: '12px 16px', fontFamily: 'monospace', fontWeight: 700, color: '#64748b' }}>{row.regNo}</td>
                          <td style={{ padding: '12px 16px', color: '#64748b' }}>{row.batch}</td>
                          <td style={{ padding: '12px 16px', fontWeight: 700, color: '#2563eb' }}>{row.company}</td>
                          <td style={{ padding: '12px 16px' }}>{row.role}</td>
                          <td style={{ padding: '12px 16px', textAlign: 'center', color: '#64748b' }}>{row.appDate}</td>
                          <td style={{ padding: '12px 16px', textAlign: 'center' }}>
                            <span style={{ fontSize: '0.74rem', padding: '2px 7px', borderRadius: '4px', background: '#f1f5f9', color: '#334155', fontWeight: 700 }}>
                              {row.currentRound} of {row.totalRounds}
                            </span>
                          </td>
                          <td style={{ padding: '12px 16px', textAlign: 'center' }}>
                            <span style={{
                              padding: '3px 8px', borderRadius: '6px', fontSize: '0.75rem', fontWeight: 800,
                              background: row.status === 'Selected' ? '#ecfdf5' : row.status === 'Rejected' ? '#fef2f2' : '#eff6ff',
                              color: row.status === 'Selected' ? '#065f46' : row.status === 'Rejected' ? '#991b1b' : '#1e40af'
                            }}>
                              {row.status === 'Selected' ? '🏆 Selected' : row.status === 'Rejected' ? '❌ Rejected' : '⏳ In Progress'}
                            </span>
                          </td>
                          <td style={{ padding: '12px 16px', textAlign: 'right' }}>
                            <span style={{
                              padding: '3px 8px', borderRadius: '6px', fontSize: '0.75rem', fontWeight: 800,
                              background: row.offerStatus === 'Offer Released' ? '#ecfdf5' : '#f1f5f9',
                              color: row.offerStatus === 'Offer Released' ? '#059669' : '#64748b'
                            }}>
                              {row.offerStatus}
                            </span>
                          </td>
                        </tr>
                      ))}

                      {deptWiseRows.length === 0 && (
                        <tr>
                          <td colSpan={10} style={{ padding: '3rem', textAlign: 'center', color: '#64748b' }}>
                            No student placement records found matching the active filters.
                          </td>
                        </tr>
                      )}
                    </tbody>
                  </table>
                </div>
              </div>
            )}

            {/* ── SUB-TAB 3: COMPANY-WISE PLACEMENT REPORT ── */}
            {reportSubTab === 'company' && (
              <div style={{ background: '#ffffff', borderRadius: '14px', border: '1px solid #e2e8f0', overflow: 'hidden' }}>
                <div style={{ padding: '14px 20px', borderBottom: '1px solid #e2e8f0', background: '#f8fafc', display: 'flex', justifyContent: 'space-between', alignItems: 'center', flexWrap: 'wrap', gap: '10px' }}>
                  <div>
                    <h3 style={{ margin: 0, fontSize: '0.98rem', fontWeight: 800, color: '#0f172a' }}>
                      Company-Wise Recruitment Funnel & Offer Roster ({companyWiseRows.length})
                    </h3>
                    <p style={{ margin: '2px 0 0', fontSize: '0.78rem', color: '#64748b' }}>
                      Tracks round-by-round candidate clearance, final selections, and accepted offer counts per company.
                    </p>
                  </div>

                  <button
                    type="button"
                    onClick={() => {
                      const headers = ['Company Name', 'Job Role', 'Openings', 'Applied', 'Shortlisted', 'Round 1 Passed', 'Round 2 Passed', 'Round 3 Passed', 'Rejected', 'Completed All Rounds', 'Final Selected', 'Offers Released', 'Offers Accepted', 'Offers Declined/Pending'];
                      const rows = companyWiseRows.map(r => [r.company, r.role, r.openings, r.applied, r.shortlisted, r.r1Passed, r.r2Passed, r.r3Passed, r.rejected, r.completedAll, r.finalSelected, r.offersReleased, r.offersAccepted, r.offersDeclinedOrPending]);
                      exportCSV('Company_Wise_Placement_Analytics', headers, rows);
                    }}
                    style={{ padding: '6px 14px', background: '#2563eb', color: '#ffffff', border: 'none', borderRadius: '8px', fontSize: '0.8rem', fontWeight: 700, cursor: 'pointer', display: 'flex', alignItems: 'center', gap: '6px' }}
                  >
                    <Download size={14} /> Export Company Sheet (.CSV)
                  </button>
                </div>

                <div style={{ overflowX: 'auto' }}>
                  <table style={{ width: '100%', borderCollapse: 'collapse', fontSize: '0.82rem' }}>
                    <thead>
                      <tr style={{ background: '#f8fafc', borderBottom: '1px solid #e2e8f0', color: '#475569', textTransform: 'uppercase', fontSize: '0.7rem', fontWeight: 800 }}>
                        <th style={{ padding: '12px 14px', textAlign: 'left' }}>Company</th>
                        <th style={{ padding: '12px 14px', textAlign: 'left' }}>Job Role</th>
                        <th style={{ padding: '12px 14px', textAlign: 'center' }}>Openings</th>
                        <th style={{ padding: '12px 14px', textAlign: 'center' }}>Applied</th>
                        <th style={{ padding: '12px 14px', textAlign: 'center' }}>Shortlisted</th>
                        <th style={{ padding: '12px 14px', textAlign: 'center' }}>R1 Pass</th>
                        <th style={{ padding: '12px 14px', textAlign: 'center' }}>R2 Pass</th>
                        <th style={{ padding: '12px 14px', textAlign: 'center' }}>R3 Pass</th>
                        <th style={{ padding: '12px 14px', textAlign: 'center' }}>Rejected</th>
                        <th style={{ padding: '12px 14px', textAlign: 'center' }}>All Done</th>
                        <th style={{ padding: '12px 14px', textAlign: 'center' }}>Selected</th>
                        <th style={{ padding: '12px 14px', textAlign: 'center' }}>Offers Released</th>
                        <th style={{ padding: '12px 14px', textAlign: 'right' }}>Accepted</th>
                      </tr>
                    </thead>
                    <tbody>
                      {companyWiseRows.map((r, i) => (
                        <tr key={i} style={{ borderBottom: '1px solid #f1f5f9' }}>
                          <td style={{ padding: '12px 14px', fontWeight: 800, color: '#0f172a' }}>{r.company}</td>
                          <td style={{ padding: '12px 14px', color: '#475569' }}>{r.role}</td>
                          <td style={{ padding: '12px 14px', textAlign: 'center' }}>{r.openings}</td>
                          <td style={{ padding: '12px 14px', textAlign: 'center', fontWeight: 700, color: '#2563eb' }}>{r.applied}</td>
                          <td style={{ padding: '12px 14px', textAlign: 'center' }}>{r.shortlisted}</td>
                          <td style={{ padding: '12px 14px', textAlign: 'center', color: '#059669', fontWeight: 700 }}>{r.r1Passed}</td>
                          <td style={{ padding: '12px 14px', textAlign: 'center', color: '#059669', fontWeight: 700 }}>{r.r2Passed}</td>
                          <td style={{ padding: '12px 14px', textAlign: 'center', color: '#059669', fontWeight: 700 }}>{r.r3Passed}</td>
                          <td style={{ padding: '12px 14px', textAlign: 'center', color: '#dc2626', fontWeight: 700 }}>{r.rejected}</td>
                          <td style={{ padding: '12px 14px', textAlign: 'center' }}>{r.completedAll}</td>
                          <td style={{ padding: '12px 14px', textAlign: 'center', fontWeight: 800, color: '#059669' }}>{r.finalSelected}</td>
                          <td style={{ padding: '12px 14px', textAlign: 'center' }}>
                            <span style={{ padding: '2px 7px', borderRadius: '4px', background: '#ecfdf5', color: '#065f46', fontWeight: 800 }}>
                              {r.offersReleased}
                            </span>
                          </td>
                          <td style={{ padding: '12px 14px', textAlign: 'right', fontWeight: 800, color: '#16a34a' }}>
                            {r.offersAccepted}
                          </td>
                        </tr>
                      ))}

                      {companyWiseRows.length === 0 && (
                        <tr>
                          <td colSpan={13} style={{ padding: '3rem', textAlign: 'center', color: '#64748b' }}>
                            No company recruitment records found for the selected filters.
                          </td>
                        </tr>
                      )}
                    </tbody>
                  </table>
                </div>
              </div>
            )}

            {/* ── SUB-TAB 4: INTERVIEW ROUND-WISE REPORT ── */}
            {reportSubTab === 'rounds' && (
              <div style={{ display: 'flex', flexDirection: 'column', gap: '16px' }}>
                
                {/* Drive Selector */}
                <div style={{ background: '#ffffff', padding: '16px 20px', borderRadius: '14px', border: '1px solid #e2e8f0', display: 'flex', justifyContent: 'space-between', alignItems: 'center', flexWrap: 'wrap', gap: '12px' }}>
                  <div style={{ display: 'flex', alignItems: 'center', gap: '10px' }}>
                    <label style={{ fontSize: '0.85rem', fontWeight: 800, color: '#0f172a' }}>Select Recruitment Drive:</label>
                    <select
                      value={reportRoundJobId || activeReportJob?._id || ''}
                      onChange={e => setReportRoundJobId(e.target.value)}
                      style={{ padding: '6px 12px', borderRadius: '8px', border: '1.5px solid #cbd5e1', background: '#ffffff', fontSize: '0.85rem', fontWeight: 700, color: '#0f172a', outline: 'none', minWidth: '280px' }}
                    >
                      {jobs.map(j => (
                        <option key={j._id || j.jobId || j.id} value={j._id || j.jobId || j.id}>
                          {j.company} — {j.role} ({j.ctc || 'N/A'})
                        </option>
                      ))}
                    </select>
                  </div>

                  <button
                    type="button"
                    onClick={() => {
                      const headers = ['Round No', 'Round Name', 'Assessment Type', 'Total Attended', 'Selected / Qualified to Next', 'Rejected', 'Awaiting Results'];
                      const rows = roundWiseData.map(r => [r.roundNum, r.roundName, r.type, r.attended, r.selectedNext, r.rejected, r.awaiting]);
                      exportCSV(`Round_Wise_Report_${activeReportJob?.company || 'Drive'}`, headers, rows);
                    }}
                    style={{ padding: '6px 14px', background: '#2563eb', color: '#ffffff', border: 'none', borderRadius: '8px', fontSize: '0.8rem', fontWeight: 700, cursor: 'pointer', display: 'flex', alignItems: 'center', gap: '6px' }}
                  >
                    <Download size={14} /> Export Round Summary (.CSV)
                  </button>
                </div>

                {/* Dynamic Rounds Cards Grid */}
                <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fit, minmax(280px, 1fr))', gap: '16px' }}>
                  {roundWiseData.map(r => (
                    <div key={r.roundNum} style={{ background: '#ffffff', borderRadius: '14px', border: '1px solid #e2e8f0', padding: '18px', display: 'flex', flexDirection: 'column', gap: '12px', boxShadow: '0 2px 6px rgba(0,0,0,0.02)' }}>
                      <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
                        <span style={{ padding: '3px 8px', borderRadius: '6px', background: '#2563eb', color: '#ffffff', fontSize: '0.74rem', fontWeight: 800 }}>
                          Round {r.roundNum}
                        </span>
                        <span style={{ fontSize: '0.74rem', color: '#64748b', fontWeight: 700 }}>
                          Type: {r.type}
                        </span>
                      </div>

                      <h4 style={{ margin: 0, fontSize: '1.05rem', fontWeight: 800, color: '#0f172a' }}>
                        {r.roundName}
                      </h4>

                      <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: '8px', paddingTop: '6px', borderTop: '1px solid #f1f5f9' }}>
                        <div style={{ background: '#f8fafc', padding: '8px', borderRadius: '8px', textAlign: 'center' }}>
                          <div style={{ fontSize: '1.2rem', fontWeight: 800, color: '#2563eb' }}>{r.attended}</div>
                          <div style={{ fontSize: '0.7rem', color: '#64748b', fontWeight: 700 }}>Attended</div>
                        </div>
                        <div style={{ background: '#ecfdf5', padding: '8px', borderRadius: '8px', textAlign: 'center' }}>
                          <div style={{ fontSize: '1.2rem', fontWeight: 800, color: '#059669' }}>{r.selectedNext}</div>
                          <div style={{ fontSize: '0.7rem', color: '#065f46', fontWeight: 700 }}>Passed Round</div>
                        </div>
                        <div style={{ background: '#fef2f2', padding: '8px', borderRadius: '8px', textAlign: 'center' }}>
                          <div style={{ fontSize: '1.2rem', fontWeight: 800, color: '#dc2626' }}>{r.rejected}</div>
                          <div style={{ fontSize: '0.7rem', color: '#991b1b', fontWeight: 700 }}>Rejected</div>
                        </div>
                        <div style={{ background: '#fffbeb', padding: '8px', borderRadius: '8px', textAlign: 'center' }}>
                          <div style={{ fontSize: '1.2rem', fontWeight: 800, color: '#b45309' }}>{r.awaiting}</div>
                          <div style={{ fontSize: '0.7rem', color: '#92400e', fontWeight: 700 }}>In Progress</div>
                        </div>
                      </div>
                    </div>
                  ))}
                </div>

              </div>
            )}

            {/* ── SUB-TAB 5: SALARY PACKAGE REPORT ── */}
            {reportSubTab === 'salary' && (
              <div style={{ display: 'flex', flexDirection: 'column', gap: '16px' }}>
                
                {/* 4 Salary Statistic Banners */}
                <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fit, minmax(220px, 1fr))', gap: '14px' }}>
                  <div style={{ background: '#ffffff', padding: '16px 20px', borderRadius: '14px', border: '1px solid #fde68a', boxShadow: '0 2px 6px rgba(0,0,0,0.02)' }}>
                    <span style={{ fontSize: '0.72rem', fontWeight: 800, color: '#d97706', textTransform: 'uppercase' }}>Highest Package (CTC)</span>
                    <div style={{ fontSize: '1.75rem', fontWeight: 800, color: '#b45309', marginTop: '4px' }}>₹ {highestPackageVal} LPA</div>
                    <div style={{ fontSize: '0.74rem', color: '#92400e', marginTop: '2px' }}>Annual Institutional High</div>
                  </div>

                  <div style={{ background: '#ffffff', padding: '16px 20px', borderRadius: '14px', border: '1px solid #bfdbfe', boxShadow: '0 2px 6px rgba(0,0,0,0.02)' }}>
                    <span style={{ fontSize: '0.72rem', fontWeight: 800, color: '#2563eb', textTransform: 'uppercase' }}>Average CTC (Mean)</span>
                    <div style={{ fontSize: '1.75rem', fontWeight: 800, color: '#1e40af', marginTop: '4px' }}>₹ {avgPackageVal} LPA</div>
                    <div style={{ fontSize: '0.74rem', color: '#1e40af', marginTop: '2px' }}>Overall Placed Average</div>
                  </div>

                  <div style={{ background: '#ffffff', padding: '16px 20px', borderRadius: '14px', border: '1px solid #e2e8f0', boxShadow: '0 2px 6px rgba(0,0,0,0.02)' }}>
                    <span style={{ fontSize: '0.72rem', fontWeight: 800, color: '#64748b', textTransform: 'uppercase' }}>Lowest Package (CTC)</span>
                    <div style={{ fontSize: '1.75rem', fontWeight: 800, color: '#334155', marginTop: '4px' }}>₹ {lowestPackageVal} LPA</div>
                    <div style={{ fontSize: '0.74rem', color: '#64748b', marginTop: '2px' }}>Baseline Compensation</div>
                  </div>

                  <div style={{ background: '#ffffff', padding: '16px 20px', borderRadius: '14px', border: '1px solid #a7f3d0', boxShadow: '0 2px 6px rgba(0,0,0,0.02)' }}>
                    <span style={{ fontSize: '0.72rem', fontWeight: 800, color: '#059669', textTransform: 'uppercase' }}>Total Placed Scholars</span>
                    <div style={{ fontSize: '1.75rem', fontWeight: 800, color: '#047857', marginTop: '4px' }}>{salaryRows.length}</div>
                    <div style={{ fontSize: '0.74rem', color: '#047857', marginTop: '2px' }}>Verified Corporate Packages</div>
                  </div>
                </div>

                {/* Salary Package Roll Table */}
                <div style={{ background: '#ffffff', borderRadius: '14px', border: '1px solid #e2e8f0', overflow: 'hidden' }}>
                  <div style={{ padding: '14px 20px', borderBottom: '1px solid #e2e8f0', background: '#f8fafc', display: 'flex', justifyContent: 'space-between', alignItems: 'center', flexWrap: 'wrap', gap: '10px' }}>
                    <div style={{ display: 'flex', alignItems: 'center', gap: '12px' }}>
                      <h3 style={{ margin: 0, fontSize: '0.98rem', fontWeight: 800, color: '#0f172a' }}>
                        Placed Students Salary Compensation Register ({salaryRows.length})
                      </h3>
                      
                      {/* Sort Dropdown */}
                      <select
                        value={reportSort}
                        onChange={e => setReportSort(e.target.value)}
                        style={{ padding: '4px 10px', borderRadius: '6px', border: '1px solid #cbd5e1', fontSize: '0.75rem', fontWeight: 700, color: '#0f172a', outline: 'none' }}
                      >
                        <option value="default">Default Sort</option>
                        <option value="ctc_desc">Package: Highest First</option>
                        <option value="ctc_asc">Package: Lowest First</option>
                      </select>
                    </div>

                    <button
                      type="button"
                      onClick={() => {
                        const headers = ['Student Scholar', 'Register No', 'Department', 'Company Name', 'Job Title', 'Annual Salary CTC', 'Estimated Monthly (₹)', 'Offer Release Date', 'Offer Acceptance Status'];
                        const rows = salaryRows.map(r => [r.student, r.regNo, r.dept, r.company, r.role, r.ctcDisplay, r.monthlySalary, r.offerDate, r.status]);
                        exportCSV('Salary_Packages_Report', headers, rows);
                      }}
                      style={{ padding: '6px 14px', background: '#2563eb', color: '#ffffff', border: 'none', borderRadius: '8px', fontSize: '0.8rem', fontWeight: 700, cursor: 'pointer', display: 'flex', alignItems: 'center', gap: '6px' }}
                    >
                      <Download size={14} /> Export Salary Roll (.CSV)
                    </button>
                  </div>

                  <div style={{ overflowX: 'auto' }}>
                    <table style={{ width: '100%', borderCollapse: 'collapse', fontSize: '0.84rem' }}>
                      <thead>
                        <tr style={{ background: '#f8fafc', borderBottom: '1px solid #e2e8f0', color: '#475569', textTransform: 'uppercase', fontSize: '0.72rem', fontWeight: 800 }}>
                          <th style={{ padding: '12px 18px', textAlign: 'left' }}>Student Scholar</th>
                          <th style={{ padding: '12px 18px', textAlign: 'left' }}>Register No</th>
                          <th style={{ padding: '12px 18px', textAlign: 'center' }}>Department</th>
                          <th style={{ padding: '12px 18px', textAlign: 'left' }}>Company</th>
                          <th style={{ padding: '12px 18px', textAlign: 'left' }}>Job Designation</th>
                          <th style={{ padding: '12px 18px', textAlign: 'center' }}>Annual CTC (LPA)</th>
                          <th style={{ padding: '12px 18px', textAlign: 'center' }}>Monthly Salary</th>
                          <th style={{ padding: '12px 18px', textAlign: 'center' }}>Offer Date</th>
                          <th style={{ padding: '12px 18px', textAlign: 'right' }}>Acceptance Status</th>
                        </tr>
                      </thead>
                      <tbody>
                        {salaryRows.map(row => (
                          <tr key={row.id} style={{ borderBottom: '1px solid #f1f5f9' }}>
                            <td style={{ padding: '12px 18px', fontWeight: 800, color: '#0f172a' }}>{row.student}</td>
                            <td style={{ padding: '12px 18px', fontFamily: 'monospace', fontWeight: 700, color: '#64748b' }}>{row.regNo}</td>
                            <td style={{ padding: '12px 18px', textAlign: 'center' }}>
                              <span style={{ padding: '2px 8px', borderRadius: '6px', background: '#eff6ff', color: '#2563eb', fontWeight: 700, fontSize: '0.75rem' }}>
                                {row.dept}
                              </span>
                            </td>
                            <td style={{ padding: '12px 18px', fontWeight: 700, color: '#2563eb' }}>{row.company}</td>
                            <td style={{ padding: '12px 18px' }}>{row.role}</td>
                            <td style={{ padding: '12px 18px', textAlign: 'center' }}>
                              <span style={{ padding: '3px 8px', borderRadius: '6px', background: '#ecfdf5', color: '#065f46', fontWeight: 800 }}>
                                💰 {row.ctcDisplay}
                              </span>
                            </td>
                            <td style={{ padding: '12px 18px', textAlign: 'center', fontWeight: 700, color: '#475569' }}>
                              {row.monthlySalary}
                            </td>
                            <td style={{ padding: '12px 18px', textAlign: 'center', color: '#64748b' }}>
                              {row.offerDate}
                            </td>
                            <td style={{ padding: '12px 18px', textAlign: 'right' }}>
                              <span style={{ padding: '3px 8px', borderRadius: '6px', background: '#dcfce7', color: '#15803d', fontSize: '0.75rem', fontWeight: 800 }}>
                                ✓ {row.status}
                              </span>
                            </td>
                          </tr>
                        ))}

                        {salaryRows.length === 0 && (
                          <tr>
                            <td colSpan={9} style={{ padding: '3rem', textAlign: 'center', color: '#64748b' }}>
                              No placement salary package records available for the selected filters.
                            </td>
                          </tr>
                        )}
                      </tbody>
                    </table>
                  </div>
                </div>

              </div>
            )}

            {/* ── SUB-TAB 6: OFFER LETTER TRACKING REPORT ── */}
            {reportSubTab === 'offerLetters' && (
              <div style={{ background: '#ffffff', borderRadius: '14px', border: '1px solid #e2e8f0', overflow: 'hidden' }}>
                <div style={{ padding: '14px 20px', borderBottom: '1px solid #e2e8f0', background: '#f8fafc', display: 'flex', justifyContent: 'space-between', alignItems: 'center', flexWrap: 'wrap', gap: '10px' }}>
                  <div>
                    <h3 style={{ margin: 0, fontSize: '0.98rem', fontWeight: 800, color: '#0f172a' }}>
                      Official Offer Letter Release & Joining Verification Roll ({offerLetterRows.length})
                    </h3>
                    <p style={{ margin: '2px 0 0', fontSize: '0.78rem', color: '#64748b' }}>
                      Tracks offer release dates, dispatch statuses, candidate acceptances, and onboarding joining dates.
                    </p>
                  </div>

                  <button
                    type="button"
                    onClick={() => {
                      const headers = ['Student Scholar', 'Register No', 'Department', 'Company Name', 'Job Title', 'Interview Date', 'Offer Release Date', 'Offer Letter Status', 'Acceptance Status', 'Joining Date'];
                      const rows = offerLetterRows.map(r => [r.student, r.regNo, r.dept, r.company, r.role, r.interviewDate, r.offerReleaseDate, r.letterStatus, r.acceptanceStatus, r.joiningDate]);
                      exportCSV('Offer_Letters_Tracking_Roll', headers, rows);
                    }}
                    style={{ padding: '6px 14px', background: '#2563eb', color: '#ffffff', border: 'none', borderRadius: '8px', fontSize: '0.8rem', fontWeight: 700, cursor: 'pointer', display: 'flex', alignItems: 'center', gap: '6px' }}
                  >
                    <Download size={14} /> Export Offer Letters (.CSV)
                  </button>
                </div>

                <div style={{ overflowX: 'auto' }}>
                  <table style={{ width: '100%', borderCollapse: 'collapse', fontSize: '0.84rem' }}>
                    <thead>
                      <tr style={{ background: '#f8fafc', borderBottom: '1px solid #e2e8f0', color: '#475569', textTransform: 'uppercase', fontSize: '0.72rem', fontWeight: 800 }}>
                        <th style={{ padding: '12px 18px', textAlign: 'left' }}>Student Scholar</th>
                        <th style={{ padding: '12px 18px', textAlign: 'left' }}>Register No</th>
                        <th style={{ padding: '12px 18px', textAlign: 'center' }}>Dept</th>
                        <th style={{ padding: '12px 18px', textAlign: 'left' }}>Company</th>
                        <th style={{ padding: '12px 18px', textAlign: 'left' }}>Job Designation</th>
                        <th style={{ padding: '12px 18px', textAlign: 'center' }}>Interview Done</th>
                        <th style={{ padding: '12px 18px', textAlign: 'center' }}>Offer Release Date</th>
                        <th style={{ padding: '12px 18px', textAlign: 'center' }}>Offer Letter Status</th>
                        <th style={{ padding: '12px 18px', textAlign: 'center' }}>Acceptance Status</th>
                        <th style={{ padding: '12px 18px', textAlign: 'right' }}>Joining Date</th>
                      </tr>
                    </thead>
                    <tbody>
                      {offerLetterRows.map(row => (
                        <tr key={row.id} style={{ borderBottom: '1px solid #f1f5f9' }}>
                          <td style={{ padding: '12px 18px', fontWeight: 800, color: '#0f172a' }}>{row.student}</td>
                          <td style={{ padding: '12px 18px', fontFamily: 'monospace', fontWeight: 700, color: '#64748b' }}>{row.regNo}</td>
                          <td style={{ padding: '12px 18px', textAlign: 'center' }}>
                            <span style={{ padding: '2px 8px', borderRadius: '6px', background: '#f1f5f9', color: '#334155', fontWeight: 700, fontSize: '0.75rem' }}>
                              {row.dept}
                            </span>
                          </td>
                          <td style={{ padding: '12px 18px', fontWeight: 700, color: '#2563eb' }}>{row.company}</td>
                          <td style={{ padding: '12px 18px' }}>{row.role}</td>
                          <td style={{ padding: '12px 18px', textAlign: 'center', color: '#64748b' }}>{row.interviewDate}</td>
                          <td style={{ padding: '12px 18px', textAlign: 'center', fontWeight: 700, color: '#059669' }}>{row.offerReleaseDate}</td>
                          <td style={{ padding: '12px 18px', textAlign: 'center' }}>
                            <span style={{ padding: '3px 8px', borderRadius: '6px', background: '#ecfdf5', color: '#065f46', fontSize: '0.75rem', fontWeight: 800 }}>
                              ✓ {row.letterStatus}
                            </span>
                          </td>
                          <td style={{ padding: '12px 18px', textAlign: 'center' }}>
                            <span style={{ padding: '3px 8px', borderRadius: '6px', background: '#eff6ff', color: '#1e40af', fontSize: '0.75rem', fontWeight: 800 }}>
                              {row.acceptanceStatus}
                            </span>
                          </td>
                          <td style={{ padding: '12px 18px', textAlign: 'right', fontWeight: 700, color: '#0f172a' }}>
                            {row.joiningDate}
                          </td>
                        </tr>
                      ))}

                      {offerLetterRows.length === 0 && (
                        <tr>
                          <td colSpan={10} style={{ padding: '3rem', textAlign: 'center', color: '#64748b' }}>
                            No offer letters currently recorded for the selected filters.
                          </td>
                        </tr>
                      )}
                    </tbody>
                  </table>
                </div>
              </div>
            )}

          </div>
        );
      })()}

      {/* ── REAL-TIME ERP MODALS ── */}

      {/* 1. Add Company Modal */}
      {showCompanyModal && (
        <div className="erp-modal-overlay">
          <div className="erp-modal-box" style={{ maxWidth: '640px', width: '100%' }}>
            
            <div className="erp-modal-header">
              <div className="erp-modal-header-info">
                <div className="erp-modal-icon-badge" style={{ background: 'rgba(37,99,235,0.1)', color: '#2563eb' }}>
                  <Building size={20} />
                </div>
                <div>
                  <h2 className="erp-modal-title">Add Partner Recruiter</h2>
                  <p className="erp-modal-subtitle">Register corporate profile, HR point of contact, and industry sector.</p>
                </div>
              </div>
              <button type="button" onClick={() => setShowCompanyModal(false)} className="erp-modal-close">
                <X size={18} />
              </button>
            </div>

            <form onSubmit={handleAddCompany} className="erp-modal-form">
              <div className="erp-modal-body">
                <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fit, minmax(240px, 1fr))', gap: '10px' }}>
                  <div className="erp-form-group">
                    <label className="erp-form-label">
                      <Building size={14} color="#2563eb" /> Company Name <span className="req">*</span>
                    </label>
                    <div className="erp-input-group">
                      <div className="erp-input-icon-box">
                        <Building size={16} />
                      </div>
                      <input 
                        type="text" 
                        value={companyForm.name} 
                        onChange={e => setCompanyForm({...companyForm, name: e.target.value})} 
                        required 
                        placeholder="e.g. Zoho Corp" 
                        className="erp-input-field" 
                      />
                    </div>
                  </div>

                  <div className="erp-form-group">
                    <label className="erp-form-label">
                      <Briefcase size={14} color="#2563eb" /> Industry Sector
                    </label>
                    <div className="erp-input-group">
                      <div className="erp-input-icon-box">
                        <Briefcase size={16} />
                      </div>
                      <input 
                        type="text" 
                        value={companyForm.sector} 
                        onChange={e => setCompanyForm({...companyForm, sector: e.target.value})} 
                        placeholder="e.g. IT & Software" 
                        className="erp-input-field" 
                      />
                    </div>
                  </div>
                </div>

                <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fit, minmax(240px, 1fr))', gap: '10px' }}>
                  <div className="erp-form-group">
                    <label className="erp-form-label">
                      <MapPin size={14} color="#2563eb" /> Location (HQ)
                    </label>
                    <div className="erp-input-group">
                      <div className="erp-input-icon-box">
                        <MapPin size={16} />
                      </div>
                      <input 
                        type="text" 
                        value={companyForm.location} 
                        onChange={e => setCompanyForm({...companyForm, location: e.target.value})} 
                        placeholder="e.g. Chennai / Bengaluru" 
                        className="erp-input-field" 
                      />
                    </div>
                  </div>

                  <div className="erp-form-group">
                    <label className="erp-form-label">
                      <Users size={14} color="#2563eb" /> HR Lead Name
                    </label>
                    <div className="erp-input-group">
                      <div className="erp-input-icon-box">
                        <Users size={16} />
                      </div>
                      <input 
                        type="text" 
                        value={companyForm.hrName} 
                        onChange={e => setCompanyForm({...companyForm, hrName: e.target.value})} 
                        placeholder="e.g. Ramesh Kumar" 
                        className="erp-input-field" 
                      />
                    </div>
                  </div>
                </div>

                <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fit, minmax(240px, 1fr))', gap: '10px' }}>
                  <div className="erp-form-group">
                    <label className="erp-form-label">
                      <Phone size={14} color="#2563eb" /> HR Contact Phone
                    </label>
                    <div className="erp-input-group">
                      <div className="erp-input-icon-box">
                        <Phone size={16} />
                      </div>
                      <input 
                        type="tel" 
                        value={companyForm.hrContact} 
                        onChange={e => setCompanyForm({...companyForm, hrContact: e.target.value})} 
                        placeholder="e.g. +91 9876543210" 
                        className="erp-input-field" 
                      />
                    </div>
                  </div>

                  <div className="erp-form-group">
                    <label className="erp-form-label">
                      <Mail size={14} color="#2563eb" /> HR Official Email
                    </label>
                    <div className="erp-input-group">
                      <div className="erp-input-icon-box">
                        <Mail size={16} />
                      </div>
                      <input 
                        type="email" 
                        value={companyForm.hrEmail} 
                        onChange={e => setCompanyForm({...companyForm, hrEmail: e.target.value})} 
                        placeholder="e.g. campus@company.com" 
                        className="erp-input-field" 
                      />
                    </div>
                  </div>
                </div>
              </div>

              <div className="erp-modal-footer">
                <button type="button" onClick={() => setShowCompanyModal(false)} className="erp-btn-cancel">
                  Cancel
                </button>
                <button type="submit" className="erp-btn-submit">
                  <Building size={16} /> Save Partner Recruiter
                </button>
              </div>
            </form>

          </div>
        </div>
      )}

      {/* 2. Post Job Modal */}
      {showJobModal && (
        <div className="erp-modal-overlay">
          <div className="erp-modal-box" style={{ maxWidth: '860px', width: '100%' }}>
            
            <div className="erp-modal-header">
              <div className="erp-modal-header-info">
                <div className="erp-modal-icon-badge" style={{ background: 'rgba(22,163,74,0.1)', color: '#16a34a' }}>
                  <Briefcase size={20} />
                </div>
                <div>
                  <h2 className="erp-modal-title">Post Campus Recruitment Drive</h2>
                  <p className="erp-modal-subtitle">Configure package CTC, eligibility cutoffs, departments, and deadline.</p>
                </div>
              </div>
              <button type="button" onClick={() => setShowJobModal(false)} className="erp-modal-close">
                <X size={18} />
              </button>
            </div>

            <form onSubmit={handleAddJob} className="erp-modal-form">
              <div className="erp-modal-body" style={{ padding: '20px 24px' }}>
                <div style={{
                  display: 'grid',
                  gridTemplateColumns: 'repeat(auto-fit, minmax(340px, 1fr))',
                  gap: '20px',
                  alignItems: 'start'
                }}>
                  {/* Left Column: Drive Details & Eligibility */}
                  <div style={{ display: 'flex', flexDirection: 'column', gap: '14px' }}>
                    
                    {/* Block 1: Company & Role */}
                    <div style={{ background: '#f8fafc', padding: '14px', borderRadius: '12px', border: '1px solid #e2e8f0', display: 'flex', flexDirection: 'column', gap: '10px' }}>
                      <span style={{ fontSize: '0.74rem', fontWeight: 800, color: '#16a34a', textTransform: 'uppercase', letterSpacing: '0.5px' }}>
                        1. Company & Role Details
                      </span>
                      
                      <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: '10px' }}>
                        <div className="erp-form-group">
                          <label className="erp-form-label">
                            <Building size={14} color="#16a34a" /> Company <span className="req">*</span>
                          </label>
                          <div className="erp-input-group">
                            <div className="erp-input-icon-box">
                              <Building size={16} />
                            </div>
                            <input 
                              type="text" 
                              value={jobForm.company} 
                              onChange={e => setJobForm({...jobForm, company: e.target.value})} 
                              required 
                              placeholder="e.g. Zoho, TCS" 
                              list="partner-companies-modal-list"
                              className="erp-input-field" 
                            />
                            <datalist id="partner-companies-modal-list">
                              {companies.map(c => <option key={c._id || c.companyId || c.name} value={c.name} />)}
                            </datalist>
                          </div>
                        </div>

                        <div className="erp-form-group">
                          <label className="erp-form-label">
                            <Briefcase size={14} color="#16a34a" /> Role <span className="req">*</span>
                          </label>
                          <div className="erp-input-group">
                            <div className="erp-input-icon-box">
                              <Briefcase size={16} />
                            </div>
                            <input 
                              type="text" 
                              value={jobForm.role} 
                              onChange={e => setJobForm({...jobForm, role: e.target.value})} 
                              required 
                              placeholder="e.g. Software Engineer" 
                              className="erp-input-field" 
                            />
                          </div>
                        </div>
                      </div>

                      <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: '10px' }}>
                        <div className="erp-form-group">
                          <label className="erp-form-label">
                            <DollarSign size={14} color="#16a34a" /> Package (LPA) <span className="req">*</span>
                          </label>
                          <div className="erp-input-group">
                            <div className="erp-input-icon-box">
                              <DollarSign size={16} />
                            </div>
                            <input 
                              type="text" 
                              value={jobForm.ctc} 
                              onChange={e => setJobForm({...jobForm, ctc: e.target.value})} 
                              required 
                              placeholder="e.g. 6.5 LPA" 
                              className="erp-input-field" 
                            />
                          </div>
                        </div>

                        <div className="erp-form-group">
                          <label className="erp-form-label">
                            <Users size={14} color="#16a34a" /> Departments
                          </label>
                          <div className="erp-input-group">
                            <div className="erp-input-icon-box">
                              <Users size={16} />
                            </div>
                            <input 
                              type="text" 
                              value={jobForm.eligibleDepartments.join(', ')} 
                              onChange={e => setJobForm({...jobForm, eligibleDepartments: e.target.value.split(',').map(d=>d.trim())})} 
                              placeholder="e.g. CSE, IT or ALL" 
                              className="erp-input-field" 
                            />
                          </div>
                        </div>
                      </div>
                    </div>

                    {/* Block 2: Eligibility Cutoffs & Timelines */}
                    <div style={{ background: '#f8fafc', padding: '14px', borderRadius: '12px', border: '1px solid #e2e8f0', display: 'flex', flexDirection: 'column', gap: '10px' }}>
                      <span style={{ fontSize: '0.74rem', fontWeight: 800, color: '#16a34a', textTransform: 'uppercase', letterSpacing: '0.5px' }}>
                        2. Cutoffs & Timelines
                      </span>

                      <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: '10px' }}>
                        <div className="erp-form-group">
                          <label className="erp-form-label">
                            <Award size={14} color="#16a34a" /> Min CGPA Cutoff
                          </label>
                          <div className="erp-input-group">
                            <div className="erp-input-icon-box">
                              <Award size={16} />
                            </div>
                            <input 
                              type="number" 
                              step="0.1" 
                              min="0" 
                              max="10" 
                              value={jobForm.minCgpa} 
                              onChange={e => setJobForm({...jobForm, minCgpa: Number(e.target.value)})} 
                              placeholder="e.g. 6.5" 
                              className="erp-input-field" 
                            />
                          </div>
                        </div>

                        <div className="erp-form-group">
                          <label className="erp-form-label">
                            <AlertCircle size={14} color="#16a34a" /> Max Backlogs
                          </label>
                          <div className="erp-input-group">
                            <div className="erp-input-icon-box">
                              <AlertCircle size={16} />
                            </div>
                            <input 
                              type="number" 
                              min="0" 
                              max="10" 
                              value={jobForm.maxArrears} 
                              onChange={e => setJobForm({...jobForm, maxArrears: Number(e.target.value)})} 
                              placeholder="0" 
                              className="erp-input-field" 
                            />
                          </div>
                        </div>
                      </div>

                      <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: '10px' }}>
                        <div className="erp-form-group">
                          <label className="erp-form-label">
                            <Calendar size={14} color="#16a34a" /> Drive Date
                          </label>
                          <div className="erp-input-group">
                            <div className="erp-input-icon-box">
                              <Calendar size={16} />
                            </div>
                            <input 
                              type="date" 
                              value={jobForm.driveDate} 
                              onChange={e => setJobForm({...jobForm, driveDate: e.target.value})} 
                              className="erp-input-field" 
                            />
                          </div>
                        </div>

                        <div className="erp-form-group">
                          <label className="erp-form-label">
                            <Clock size={14} color="#16a34a" /> Deadline <span className="req">*</span>
                          </label>
                          <div className="erp-input-group">
                            <div className="erp-input-icon-box">
                              <Clock size={16} />
                            </div>
                            <input 
                              type="date" 
                              value={jobForm.deadline} 
                              onChange={e => setJobForm({...jobForm, deadline: e.target.value})} 
                              required 
                              className="erp-input-field" 
                            />
                          </div>
                        </div>
                      </div>
                    </div>

                  </div>

                  {/* Right Column: Selection Process & Rounds */}
                  <div style={{
                    background: '#f8fafc',
                    padding: '14px',
                    borderRadius: '12px',
                    border: '1px solid #e2e8f0',
                    display: 'flex',
                    flexDirection: 'column',
                    gap: '12px',
                    height: '100%',
                    boxSizing: 'border-box'
                  }}>
                    <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', flexWrap: 'wrap', gap: '6px' }}>
                      <div>
                        <span style={{ fontSize: '0.74rem', fontWeight: 800, color: '#16a34a', textTransform: 'uppercase', letterSpacing: '0.5px', display: 'block' }}>
                          3. Selection Rounds
                        </span>
                        <p style={{ margin: '2px 0 0 0', fontSize: '0.74rem', color: '#64748b' }}>
                          Select total interview rounds:
                        </p>
                      </div>

                      {/* Quick Round Count Selector */}
                      <div style={{ display: 'flex', gap: '4px', alignItems: 'center' }}>
                        {[1, 2, 3, 4, 5].map(num => (
                          <button
                            key={num}
                            type="button"
                            onClick={() => handleRoundCountChange(num)}
                            style={{
                              padding: '4px 10px',
                              borderRadius: '7px',
                              border: (jobForm.totalRounds || (jobForm.rounds ? jobForm.rounds.length : 3)) === num ? '1px solid #16a34a' : '1px solid #cbd5e1',
                              background: (jobForm.totalRounds || (jobForm.rounds ? jobForm.rounds.length : 3)) === num ? '#16a34a' : '#ffffff',
                              color: (jobForm.totalRounds || (jobForm.rounds ? jobForm.rounds.length : 3)) === num ? '#ffffff' : '#334155',
                              fontWeight: 800,
                              fontSize: '0.78rem',
                              cursor: 'pointer',
                              transition: 'all 0.15s ease'
                            }}
                          >
                            {num}
                          </button>
                        ))}
                      </div>
                    </div>

                    {/* List of Rounds */}
                    <div style={{ display: 'flex', flexDirection: 'column', gap: '8px', maxHeight: '270px', overflowY: 'auto', paddingRight: '2px' }}>
                      {(jobForm.rounds || []).map((rnd, idx) => (
                        <div 
                          key={idx} 
                          style={{ 
                            display: 'grid', 
                            gridTemplateColumns: '62px 1fr 115px', 
                            gap: '6px', 
                            alignItems: 'center',
                            padding: '6px 8px',
                            background: '#ffffff',
                            borderRadius: '8px',
                            border: '1px solid #e2e8f0',
                            boxShadow: '0 1px 2px rgba(0,0,0,0.03)'
                          }}
                        >
                          <span style={{ 
                            fontSize: '0.72rem', 
                            fontWeight: 800, 
                            color: '#16a34a',
                            background: 'rgba(22,163,74,0.1)',
                            padding: '4px 6px',
                            borderRadius: '5px',
                            textAlign: 'center'
                          }}>
                            Rnd {idx + 1}
                          </span>
                          <input
                            type="text"
                            value={rnd.name}
                            onChange={(e) => handleRoundDetailChange(idx, 'name', e.target.value)}
                            placeholder={`Round ${idx + 1} Title`}
                            className="erp-input-field"
                            style={{ fontSize: '0.8rem', padding: '4px 8px', height: '32px', background: '#f8fafc', borderRadius: '6px', border: '1px solid #e2e8f0' }}
                            required
                          />
                          <select
                            value={rnd.type || 'Technical'}
                            onChange={(e) => handleRoundDetailChange(idx, 'type', e.target.value)}
                            className="erp-select-field"
                            style={{ fontSize: '0.78rem', padding: '4px 6px', height: '32px', background: '#f8fafc', borderRadius: '6px', border: '1px solid #e2e8f0' }}
                          >
                            <option value="Aptitude">Aptitude</option>
                            <option value="Technical">Technical</option>
                            <option value="Coding">Coding</option>
                            <option value="GD">GD / Group</option>
                            <option value="HR">HR Round</option>
                            <option value="Assessment">Assessment</option>
                          </select>
                        </div>
                      ))}
                    </div>

                    <div style={{ marginTop: 'auto', background: 'rgba(22,163,74,0.06)', padding: '8px 10px', borderRadius: '8px', border: '1px dashed rgba(22,163,74,0.3)' }}>
                      <p style={{ margin: 0, fontSize: '0.72rem', color: '#166534', display: 'flex', alignItems: 'center', gap: '5px' }}>
                        <CheckCircle size={13} color="#16a34a" /> Rounds automatically initialize student assessment scoresheets.
                      </p>
                    </div>
                  </div>

                </div>
              </div>

              <div className="erp-modal-footer">
                <button type="button" onClick={() => setShowJobModal(false)} className="erp-btn-cancel">
                  Cancel
                </button>
                <button type="submit" className="erp-btn-submit green">
                  <Briefcase size={16} /> Post Campus Drive
                </button>
              </div>
            </form>

          </div>
        </div>
      )}

      {/* 3. Schedule Interview Modal */}
      {showInterviewModal && (
        <div className="erp-modal-overlay">
          <div className="erp-modal-box" style={{ maxWidth: '640px', width: '100%' }}>
            
            <div className="erp-modal-header">
              <div className="erp-modal-header-info">
                <div className="erp-modal-icon-badge" style={{ background: 'rgba(124,58,237,0.1)', color: '#7c3aed' }}>
                  <Calendar size={20} />
                </div>
                <div>
                  <h2 className="erp-modal-title">Schedule Interview Session</h2>
                  <p className="erp-modal-subtitle">Set up recruitment round, date/time, and virtual or campus venue.</p>
                </div>
              </div>
              <button type="button" onClick={() => setShowInterviewModal(false)} className="erp-modal-close">
                <X size={18} />
              </button>
            </div>

            <form onSubmit={handleAddInterview} className="erp-modal-form">
              <div className="erp-modal-body">
                <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fit, minmax(240px, 1fr))', gap: '10px' }}>
                  <div className="erp-form-group">
                    <label className="erp-form-label">
                      <Building size={14} color="#7c3aed" /> Company <span className="req">*</span>
                    </label>
                    <div className="erp-input-group">
                      <div className="erp-input-icon-box">
                        <Building size={16} />
                      </div>
                      <input 
                        type="text" 
                        value={interviewForm.company} 
                        onChange={e => setInterviewForm({...interviewForm, company: e.target.value})} 
                        required 
                        placeholder="e.g. Zoho" 
                        list="interview-companies-list"
                        className="erp-input-field" 
                      />
                      <datalist id="interview-companies-list">
                        {companies.map(c => <option key={c._id || c.companyId || c.name} value={c.name} />)}
                      </datalist>
                    </div>
                  </div>

                  <div className="erp-form-group">
                    <label className="erp-form-label">
                      <Briefcase size={14} color="#7c3aed" /> Role <span className="req">*</span>
                    </label>
                    <div className="erp-input-group">
                      <div className="erp-input-icon-box">
                        <Briefcase size={16} />
                      </div>
                      <input 
                        type="text" 
                        value={interviewForm.role} 
                        onChange={e => setInterviewForm({...interviewForm, role: e.target.value})} 
                        required 
                        placeholder="e.g. Software Developer" 
                        className="erp-input-field" 
                      />
                    </div>
                  </div>
                </div>

                <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fit, minmax(240px, 1fr))', gap: '10px' }}>
                  <div className="erp-form-group">
                    <label className="erp-form-label">
                      <Target size={14} color="#7c3aed" /> Assessment Round <span className="req">*</span>
                    </label>
                    <div className="erp-input-group">
                      <div className="erp-input-icon-box">
                        <Target size={16} />
                      </div>
                      <input 
                        type="text" 
                        value={interviewForm.round} 
                        onChange={e => setInterviewForm({...interviewForm, round: e.target.value})} 
                        required 
                        placeholder="e.g. Technical Round 1" 
                        className="erp-input-field" 
                      />
                    </div>
                  </div>

                  <div className="erp-form-group">
                    <label className="erp-form-label">
                      <Clock size={14} color="#7c3aed" /> Time Slot
                    </label>
                    <div className="erp-input-group">
                      <div className="erp-input-icon-box">
                        <Clock size={16} />
                      </div>
                      <input 
                        type="text" 
                        value={interviewForm.time} 
                        onChange={e => setInterviewForm({...interviewForm, time: e.target.value})} 
                        placeholder="e.g. 10:00 AM" 
                        className="erp-input-field" 
                      />
                    </div>
                  </div>
                </div>

                <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fit, minmax(240px, 1fr))', gap: '10px' }}>
                  <div className="erp-form-group">
                    <label className="erp-form-label">
                      <Calendar size={14} color="#7c3aed" /> Date <span className="req">*</span>
                    </label>
                    <div className="erp-input-group">
                      <div className="erp-input-icon-box">
                        <Calendar size={16} />
                      </div>
                      <input 
                        type="date" 
                        value={interviewForm.date} 
                        onChange={e => setInterviewForm({...interviewForm, date: e.target.value})} 
                        required 
                        className="erp-input-field" 
                      />
                    </div>
                  </div>

                  <div className="erp-form-group">
                    <label className="erp-form-label">
                      <Eye size={14} color="#7c3aed" /> Interview Mode
                    </label>
                    <div className="erp-input-group">
                      <div className="erp-input-icon-box">
                        <Eye size={16} />
                      </div>
                      <select 
                        value={interviewForm.mode} 
                        onChange={e => setInterviewForm({...interviewForm, mode: e.target.value})} 
                        className="erp-select-field"
                      >
                        <option value="Online">Online (Zoom / Google Meet)</option>
                        <option value="Offline">Offline (Campus Premises)</option>
                        <option value="Hybrid">Hybrid Assessment</option>
                      </select>
                    </div>
                  </div>
                </div>

                <div className="erp-form-group">
                  <label className="erp-form-label">
                    <MapPin size={14} color="#7c3aed" /> Venue / Meeting Link
                  </label>
                  <div className="erp-input-group">
                    <div className="erp-input-icon-box">
                      <MapPin size={16} />
                    </div>
                    <input 
                      type="text" 
                      value={interviewForm.venue} 
                      onChange={e => setInterviewForm({...interviewForm, venue: e.target.value})} 
                      placeholder="e.g. Placement Block Lab 2 / Zoom URL" 
                      className="erp-input-field" 
                    />
                  </div>
                </div>
              </div>

              <div className="erp-modal-footer">
                <button type="button" onClick={() => setShowInterviewModal(false)} className="erp-btn-cancel">
                  Cancel
                </button>
                <button type="submit" className="erp-btn-submit" style={{ background: 'linear-gradient(135deg, #7c3aed 0%, #6d28d9 100%)' }}>
                  <Calendar size={16} /> Schedule Interview Session
                </button>
              </div>
            </form>

          </div>
        </div>
      )}

      {/* 4. Add Selection Modal */}
      {showSelectionModal && (
        <div className="erp-modal-overlay">
          <div className="erp-modal-box" style={{ maxWidth: '640px', width: '100%' }}>
            
            <div className="erp-modal-header">
              <div className="erp-modal-header-info">
                <div className="erp-modal-icon-badge" style={{ background: 'rgba(217,119,6,0.1)', color: '#d97706' }}>
                  <Award size={20} />
                </div>
                <div>
                  <h2 className="erp-modal-title">Record Verified Placement Offer</h2>
                  <p className="erp-modal-subtitle">Issue accredited placement selection record, candidate roll number, and package.</p>
                </div>
              </div>
              <button type="button" onClick={() => setShowSelectionModal(false)} className="erp-modal-close">
                <X size={18} />
              </button>
            </div>

            <form onSubmit={handleAddSelection} className="erp-modal-form">
              <div className="erp-modal-body">
                <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fit, minmax(240px, 1fr))', gap: '10px' }}>
                  <div className="erp-form-group">
                    <label className="erp-form-label">
                      <Users size={14} color="#d97706" /> Student Name <span className="req">*</span>
                    </label>
                    <div className="erp-input-group">
                      <div className="erp-input-icon-box">
                        <Users size={16} />
                      </div>
                      <input 
                        type="text" 
                        value={selectionForm.student} 
                        onChange={e => setSelectionForm({...selectionForm, student: e.target.value})} 
                        required 
                        placeholder="e.g. Priya Kumar R" 
                        className="erp-input-field" 
                      />
                    </div>
                  </div>

                  <div className="erp-form-group">
                    <label className="erp-form-label">
                      <ShieldCheck size={14} color="#d97706" /> Register No <span className="req">*</span>
                    </label>
                    <div className="erp-input-group">
                      <div className="erp-input-icon-box">
                        <ShieldCheck size={16} />
                      </div>
                      <input 
                        type="text" 
                        value={selectionForm.regNo} 
                        onChange={e => setSelectionForm({...selectionForm, regNo: e.target.value})} 
                        required 
                        placeholder="e.g. 71762104001" 
                        className="erp-input-field" 
                      />
                    </div>
                  </div>
                </div>

                <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fit, minmax(240px, 1fr))', gap: '10px' }}>
                  <div className="erp-form-group">
                    <label className="erp-form-label">
                      <Building size={14} color="#d97706" /> Recruiting Company <span className="req">*</span>
                    </label>
                    <div className="erp-input-group">
                      <div className="erp-input-icon-box">
                        <Building size={16} />
                      </div>
                      <input 
                        type="text" 
                        value={selectionForm.company} 
                        onChange={e => setSelectionForm({...selectionForm, company: e.target.value})} 
                        required 
                        placeholder="e.g. TCS Digital" 
                        list="selections-companies-list"
                        className="erp-input-field" 
                      />
                      <datalist id="selections-companies-list">
                        {companies.map(c => <option key={c._id || c.companyId || c.name} value={c.name} />)}
                      </datalist>
                    </div>
                  </div>

                  <div className="erp-form-group">
                    <label className="erp-form-label">
                      <Briefcase size={14} color="#d97706" /> Designation Role <span className="req">*</span>
                    </label>
                    <div className="erp-input-group">
                      <div className="erp-input-icon-box">
                        <Briefcase size={16} />
                      </div>
                      <input 
                        type="text" 
                        value={selectionForm.role} 
                        onChange={e => setSelectionForm({...selectionForm, role: e.target.value})} 
                        required 
                        placeholder="e.g. Software Engineer" 
                        className="erp-input-field" 
                      />
                    </div>
                  </div>
                </div>

                <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fit, minmax(240px, 1fr))', gap: '10px' }}>
                  <div className="erp-form-group">
                    <label className="erp-form-label">
                      <DollarSign size={14} color="#d97706" /> Package CTC (LPA) <span className="req">*</span>
                    </label>
                    <div className="erp-input-group">
                      <div className="erp-input-icon-box">
                        <DollarSign size={16} />
                      </div>
                      <input 
                        type="text" 
                        value={selectionForm.ctc} 
                        onChange={e => setSelectionForm({...selectionForm, ctc: e.target.value})} 
                        required 
                        placeholder="e.g. 7.5 LPA" 
                        className="erp-input-field" 
                      />
                    </div>
                  </div>

                  <div className="erp-form-group">
                    <label className="erp-form-label">
                      <Calendar size={14} color="#d97706" /> Offer Date
                    </label>
                    <div className="erp-input-group">
                      <div className="erp-input-icon-box">
                        <Calendar size={16} />
                      </div>
                      <input 
                        type="date" 
                        value={selectionForm.date} 
                        onChange={e => setSelectionForm({...selectionForm, date: e.target.value})} 
                        className="erp-input-field" 
                      />
                    </div>
                  </div>
                </div>
              </div>

              <div className="erp-modal-footer">
                <button type="button" onClick={() => setShowSelectionModal(false)} className="erp-btn-cancel">
                  Cancel
                </button>
                <button type="submit" className="erp-btn-submit green">
                  <Award size={16} /> Record Verified Offer
                </button>
              </div>
            </form>

          </div>
        </div>
      )}

      {/* 5. Report Preview Modal */}
      {reportPreview && (
        <div className="erp-modal-overlay">
          <div className="erp-modal-box" style={{ maxWidth: '880px', width: '100%' }}>
            
            <div className="erp-modal-header">
              <div className="erp-modal-header-info">
                <div className="erp-modal-icon-badge" style={{ background: 'rgba(37,99,235,0.1)', color: '#2563eb' }}>
                  <FileText size={22} />
                </div>
                <div>
                  <h2 className="erp-modal-title">{reportPreview.title}</h2>
                  <p className="erp-modal-subtitle">Official accredited report preview with instant CSV export and print.</p>
                </div>
              </div>
              <button type="button" onClick={() => setReportPreview(null)} className="erp-modal-close">
                <X size={18} />
              </button>
            </div>

            <div className="erp-modal-body" style={{ maxHeight: '60vh' }}>
              <div style={{ border: '1px solid var(--border-color, #e2e8f0)', borderRadius: '12px', overflow: 'hidden' }}>
                <table style={{ width: '100%', borderCollapse: 'collapse', fontSize: '0.85rem' }}>
                  <thead>
                    <tr style={{ background: 'var(--bg-secondary, #f8fafc)', borderBottom: '1px solid var(--border-color, #e2e8f0)' }}>
                      {reportPreview.headers.map((h, i) => (
                        <th key={i} style={{ padding: '12px 16px', textAlign: 'left', fontWeight: 800, color: 'var(--text-muted, #64748b)', fontSize: '0.75rem', textTransform: 'uppercase' }}>
                          {h}
                        </th>
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    {reportPreview.rows.map((row, i) => (
                      <tr key={i} style={{ borderBottom: '1px solid var(--border-color, #f1f5f9)' }}>
                        {row.map((cell, j) => (
                          <td key={j} style={{ padding: '12px 16px', fontWeight: j === 1 || j === 2 ? 800 : 500, color: 'var(--text-main, #0f172a)' }}>
                            {cell}
                          </td>
                        ))}
                      </tr>
                    ))}
                    {reportPreview.rows.length === 0 && (
                      <tr>
                        <td colSpan={reportPreview.headers.length} style={{ padding: '3rem', textAlign: 'center', color: 'var(--text-muted)' }}>
                          No records available for this report period.
                        </td>
                      </tr>
                    )}
                  </tbody>
                </table>
              </div>
            </div>

            <div className="erp-modal-footer">
              <button 
                type="button" 
                onClick={() => exportCSV(reportPreview.title.replace(/\s+/g, '_'), reportPreview.headers, reportPreview.rows)}
                className="erp-btn-submit"
              >
                <Download size={15}/> Export (.CSV)
              </button>
              <button 
                type="button" 
                onClick={() => window.print()}
                className="erp-btn-cancel"
                style={{ display: 'flex', alignItems: 'center', gap: '6px' }}
              >
                <FileText size={15}/> Print Document
              </button>
            </div>

          </div>
        </div>
      )}

      {/* Schedule Training Program Modal */}
      {showTrainingModal && (
        <div className="erp-modal-overlay">
          <div className="erp-modal-box" style={{ maxWidth: '640px', width: '100%' }}>
            
            <div className="erp-modal-header">
              <div className="erp-modal-header-info">
                <div className="erp-modal-icon-badge" style={{ background: 'rgba(37,99,235,0.1)', color: '#2563eb' }}>
                  <BookOpen size={20} />
                </div>
                <div>
                  <h2 className="erp-modal-title">Schedule Training & Skill Program</h2>
                  <p className="erp-modal-subtitle">Organize bootcamps, technical modules, or aptitude workshops for candidates.</p>
                </div>
              </div>
              <button type="button" onClick={() => setShowTrainingModal(false)} className="erp-modal-close">
                <X size={18} />
              </button>
            </div>

            <form onSubmit={handleCreateTrainingProgram} className="erp-modal-form">
              <div className="erp-modal-body">
                <div className="erp-form-group">
                  <label className="erp-form-label">
                    <BookOpen size={14} color="#2563eb" /> Module / Program Title <span className="req">*</span>
                  </label>
                  <div className="erp-input-group">
                    <div className="erp-input-icon-box">
                      <BookOpen size={16} />
                    </div>
                    <input 
                      type="text" 
                      value={trainingForm.title} 
                      onChange={e => setTrainingForm({...trainingForm, title: e.target.value})} 
                      required 
                      placeholder="e.g. Full Stack Cloud & Microservices Bootcamp" 
                      className="erp-input-field" 
                    />
                  </div>
                </div>

                <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fit, minmax(240px, 1fr))', gap: '10px' }}>
                  <div className="erp-form-group">
                    <label className="erp-form-label">
                      <Users size={14} color="#2563eb" /> Trainer / Training Partner <span className="req">*</span>
                    </label>
                    <div className="erp-input-group">
                      <div className="erp-input-icon-box">
                        <Users size={16} />
                      </div>
                      <input 
                        type="text" 
                        value={trainingForm.trainer} 
                        onChange={e => setTrainingForm({...trainingForm, trainer: e.target.value})} 
                        required 
                        placeholder="e.g. TalentSprint / Corporate Trainer" 
                        className="erp-input-field" 
                      />
                    </div>
                  </div>

                  <div className="erp-form-group">
                    <label className="erp-form-label">
                      <Building size={14} color="#2563eb" /> Target Department
                    </label>
                    <div className="erp-input-group">
                      <div className="erp-input-icon-box">
                        <Building size={16} />
                      </div>
                      <select 
                        value={trainingForm.targetDepartment} 
                        onChange={e => setTrainingForm({...trainingForm, targetDepartment: e.target.value})} 
                        className="erp-input-field"
                      >
                        <option value="ALL">ALL Departments</option>
                        {Array.from(new Set(allStudents.map(s => s.dept || s.department).filter(Boolean))).map(d => (
                          <option key={d} value={d}>{d}</option>
                        ))}
                        <option value="TAMIL">TAMIL</option>
                        <option value="Computer Science and Engineering">Computer Science and Engineering</option>
                        <option value="Commerce & Finance">Commerce & Finance</option>
                        <option value="Arts & Science">Arts & Science</option>
                      </select>
                    </div>
                  </div>
                </div>

                <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fit, minmax(240px, 1fr))', gap: '10px' }}>
                  <div className="erp-form-group">
                    <label className="erp-form-label">
                      <Calendar size={14} color="#2563eb" /> Scheduled Date <span className="req">*</span>
                    </label>
                    <div className="erp-input-group">
                      <div className="erp-input-icon-box">
                        <Calendar size={16} />
                      </div>
                      <input 
                        type="date" 
                        value={trainingForm.date} 
                        onChange={e => setTrainingForm({...trainingForm, date: e.target.value})} 
                        required 
                        className="erp-input-field" 
                      />
                    </div>
                  </div>

                  <div className="erp-form-group">
                    <label className="erp-form-label">
                      <Clock size={14} color="#2563eb" /> Timing / Duration
                    </label>
                    <div className="erp-input-group">
                      <div className="erp-input-icon-box">
                        <Clock size={16} />
                      </div>
                      <input 
                        type="text" 
                        value={trainingForm.time} 
                        onChange={e => setTrainingForm({...trainingForm, time: e.target.value})} 
                        placeholder="e.g. 09:30 AM - 01:00 PM" 
                        className="erp-input-field" 
                      />
                    </div>
                  </div>
                </div>

                <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fit, minmax(240px, 1fr))', gap: '10px' }}>
                  <div className="erp-form-group">
                    <label className="erp-form-label">
                      <Target size={14} color="#2563eb" /> Target Interview Round
                    </label>
                    <div className="erp-input-group">
                      <div className="erp-input-icon-box">
                        <Target size={16} />
                      </div>
                      <select 
                        value={trainingForm.targetRound || 'ALL'} 
                        onChange={e => setTrainingForm({...trainingForm, targetRound: e.target.value})} 
                        className="erp-input-field"
                      >
                        <option value="ALL">All Rounds (Comprehensive Preparation)</option>
                        <option value="Round 1 (Aptitude & Assessment)">Round 1: Online Aptitude & Assessment</option>
                        <option value="Round 2 (Technical & Coding)">Round 2: Technical & Coding Assessment</option>
                        <option value="Round 3 (HR & Mock Interview)">Round 3: HR, GD & Mock Interview</option>
                      </select>
                    </div>
                  </div>

                  <div className="erp-form-group">
                    <label className="erp-form-label">
                      <Award size={14} color="#2563eb" /> Delivery Mode
                    </label>
                    <div className="erp-input-group">
                      <div className="erp-input-icon-box">
                        <Award size={16} />
                      </div>
                      <select 
                        value={trainingForm.mode} 
                        onChange={e => setTrainingForm({...trainingForm, mode: e.target.value})} 
                        className="erp-input-field"
                      >
                        <option value="Offline">Offline (Campus)</option>
                        <option value="Online">Online (Virtual Portal)</option>
                        <option value="Hybrid">Hybrid</option>
                      </select>
                    </div>
                  </div>
                </div>

                <div className="erp-form-group">
                  <label className="erp-form-label">
                    <MapPin size={14} color="#2563eb" /> Venue / Room / Virtual Link
                  </label>
                  <div className="erp-input-group">
                    <div className="erp-input-icon-box">
                      <MapPin size={16} />
                    </div>
                    <input 
                      type="text" 
                      value={trainingForm.venue} 
                      onChange={e => setTrainingForm({...trainingForm, venue: e.target.value})} 
                      placeholder="e.g. Main Auditorium / LAB-4 / Zoom URL" 
                      className="erp-input-field" 
                    />
                  </div>
                </div>

                <div className="erp-form-group">
                  <label className="erp-form-label">
                    <FileText size={14} color="#2563eb" /> Syllabus / Description
                  </label>
                  <div className="erp-input-group">
                    <textarea 
                      value={trainingForm.description} 
                      onChange={e => setTrainingForm({...trainingForm, description: e.target.value})} 
                      placeholder="Brief overview of curriculum topics covered..." 
                      className="erp-input-field" 
                      style={{ height: '54px', resize: 'none' }}
                    />
                  </div>
                </div>
              </div>

              <div className="erp-modal-footer">
                <button type="button" onClick={() => setShowTrainingModal(false)} className="erp-btn-cancel">
                  Cancel
                </button>
                <button type="submit" className="erp-btn-submit">
                  <CheckCircle size={16} /> Schedule Program
                </button>
              </div>
            </form>

          </div>
        </div>
      )}

      {/* Training Program Student Roster & Attendance Modal */}
      {selectedTrainingForAttendance && (
        <div className="erp-modal-overlay">
          <div className="erp-modal-box" style={{ maxWidth: '780px', width: '100%' }}>
            
            <div className="erp-modal-header">
              <div className="erp-modal-header-info">
                <div className="erp-modal-icon-badge" style={{ background: 'rgba(37,99,235,0.1)', color: '#2563eb' }}>
                  <Users size={22} />
                </div>
                <div>
                  <h2 className="erp-modal-title">{selectedTrainingForAttendance.title}</h2>
                  <p className="erp-modal-subtitle">
                    Conducted by <strong>{selectedTrainingForAttendance.trainer}</strong> • {new Date(selectedTrainingForAttendance.date).toLocaleDateString()} ({selectedTrainingForAttendance.time})
                  </p>
                </div>
              </div>
              <button type="button" onClick={() => setSelectedTrainingForAttendance(null)} className="erp-modal-close">
                <X size={18} />
              </button>
            </div>

            <div className="erp-modal-body" style={{ maxHeight: '60vh' }}>
              <div style={{ border: '1px solid var(--border-color, #e2e8f0)', borderRadius: '12px', overflow: 'hidden' }}>
                <table style={{ width: '100%', borderCollapse: 'collapse', fontSize: '0.85rem' }}>
                  <thead>
                    <tr style={{ background: 'var(--bg-secondary, #f8fafc)', borderBottom: '1px solid var(--border-color, #e2e8f0)' }}>
                      <th style={{ padding: '10px 14px', textAlign: 'left', fontWeight: 800, color: 'var(--text-muted, #64748b)', fontSize: '0.72rem', textTransform: 'uppercase' }}>Student Name</th>
                      <th style={{ padding: '10px 14px', textAlign: 'left', fontWeight: 800, color: 'var(--text-muted, #64748b)', fontSize: '0.72rem', textTransform: 'uppercase' }}>Register No</th>
                      <th style={{ padding: '10px 14px', textAlign: 'left', fontWeight: 800, color: 'var(--text-muted, #64748b)', fontSize: '0.72rem', textTransform: 'uppercase' }}>Department</th>
                      <th style={{ padding: '10px 14px', textAlign: 'right', fontWeight: 800, color: 'var(--text-muted, #64748b)', fontSize: '0.72rem', textTransform: 'uppercase' }}>Attendance Status</th>
                    </tr>
                  </thead>
                  <tbody>
                    {allStudents.map(st => {
                      const key = `${st.id || st.rollNo || st.regNo}-${selectedTrainingForAttendance.id}`;
                      const status = studentTrainingStatus[key] || 'Pending';
                      return (
                        <tr key={st.id || st.rollNo || st.regNo} style={{ borderBottom: '1px solid var(--border-color, #f1f5f9)' }}>
                          <td style={{ padding: '10px 14px', fontWeight: 700, color: 'var(--text-main, #0f172a)' }}>{st.name}</td>
                          <td style={{ padding: '10px 14px', fontFamily: 'monospace', color: 'var(--text-muted, #64748b)' }}>{st.id || st.rollNo || st.regNo}</td>
                          <td style={{ padding: '10px 14px', color: 'var(--text-muted, #64748b)' }}>{st.dept || st.department || 'General'}</td>
                          <td style={{ padding: '10px 14px', textAlign: 'right' }}>
                            <select 
                              value={status} 
                              onChange={(e) => handleUpdateTrainingAttendance(key, e.target.value)}
                              style={{ 
                                padding: '4px 10px', borderRadius: 6, fontSize: '0.78rem', fontWeight: 700,
                                background: status === 'Completed' ? '#d1fae5' : status === 'Absent' ? '#fee2e2' : status === 'Present' ? '#eff6ff' : '#fef3c7',
                                color: status === 'Completed' ? '#065f46' : status === 'Absent' ? '#991b1b' : status === 'Present' ? '#1e40af' : '#92400e',
                                border: '1px solid var(--border-color, #e2e8f0)', outline: 'none', cursor: 'pointer'
                              }}
                            >
                              <option value="Pending">Pending</option>
                              <option value="Present">Present</option>
                              <option value="Completed">Completed</option>
                              <option value="Absent">Absent</option>
                            </select>
                          </td>
                        </tr>
                      );
                    })}
                  </tbody>
                </table>
              </div>
            </div>

            <div className="erp-modal-footer">
              <button 
                type="button" 
                onClick={() => setSelectedTrainingForAttendance(null)} 
                className="erp-btn-submit"
              >
                Close Roster
              </button>
            </div>

          </div>
        </div>
      )}

      {/* Toast Notification */}
      {toastMsg && (
        <div style={{
          position: 'fixed', bottom: '24px', right: '24px', background: '#10b981', color: '#ffffff',
          padding: '12px 22px', borderRadius: '10px', boxShadow: '0 8px 24px rgba(0,0,0,0.15)',
          fontWeight: 700, fontSize: '0.88rem', zIndex: 9999, display: 'flex', alignItems: 'center', gap: '8px'
        }}>
          <CheckCircle size={18} />
          <span>{toastMsg}</span>
        </div>
      )}

    </div>
  );
};

export default PlacementManagement;
