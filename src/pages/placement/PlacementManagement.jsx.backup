const CHART_DATA_FALLBACK = [
  { month: 'Jul', placed: 15 }, { month: 'Aug', placed: 35 },
  { month: 'Sep', placed: 68 }, { month: 'Oct', placed: 120 },
  { month: 'Nov', placed: 180 }, { month: 'Dec', placed: 240 },
